/* ============================================================
   Auth Screens
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  function authShell(innerHtml) {
    A.root.innerHTML = `
      <div class="auth-wrap">
        <div class="auth-card">
          <div class="auth-brand">
            <div class="brand-mark">SS</div>
            <div>
              <div class="brand-name">StockSense</div>
              <div class="brand-sub">Real-Time Inventory Engine</div>
            </div>
          </div>
          <div class="auth-panel">${innerHtml}</div>
        </div>
      </div>`;
  }

  function renderLogin() {
    authShell(`
      <div class="auth-title">Sign in</div>
      <div class="auth-sub">Manage warehouses, stock movements, and real-time inventory.</div>
      <div id="auth-error"></div>
      <form id="login-form">
        <div class="form-grid single">
          <div class="field"><label for="email">Email</label><input id="email" type="email" required autocomplete="username" value="admin@stocksense.io" /></div>
          <div class="field"><label for="password">Password</label><input id="password" type="password" required autocomplete="current-password" value="admin123" /></div>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;margin-top:16px">Sign in</button>
      </form>
      <div class="auth-switch">
        <button class="link-btn" data-go="forgot">Forgot password?</button>
        &nbsp;·&nbsp;
        <button class="link-btn" data-go="signup">Create an account</button>
      </div>
      <div class="field-hint" style="margin-top:14px;text-align:center;line-height:1.5">
        Demo accounts: <strong>admin@stocksense.io / admin123</strong><br/>or <strong>staff@stocksense.io / staff123</strong>
      </div>
    `);
    document.getElementById("login-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value;
      const errBox = document.getElementById("auth-error");
      errBox.innerHTML = "";
      try {
        const { user } = await SS.Auth.login({ email, password });
        A.state.user = user;
        localStorage.setItem("ss_session_user", JSON.stringify(user));
        A.navigate("dashboard");
      } catch (err) {
        errBox.innerHTML = `<div class="error-banner">${A.esc(err.message)}</div>`;
      }
    });
    document.querySelectorAll("[data-go]").forEach((b) => b.addEventListener("click", () => A.navigate(b.dataset.go)));
  }

  function renderSignup() {
    authShell(`
      <div class="auth-title">Create account</div>
      <div class="auth-sub">Register access to your inventory workspace.</div>
      <div id="auth-error"></div>
      <form id="signup-form">
        <div class="form-grid single">
          <div class="field"><label for="name">Full name</label><input id="name" required placeholder="Asha Rao" /></div>
          <div class="field"><label for="email">Email address</label><input id="email" type="email" required placeholder="asha@example.com" /></div>
          <div class="field"><label for="password">Password</label><input id="password" type="password" required minlength="6" /></div>
          <div class="field"><label for="role">Role</label>
            <select id="role"><option value="staff">Staff (Operator)</option><option value="admin">Administrator</option></select>
          </div>
        </div>
        <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;margin-top:16px">Create account</button>
      </form>
      <div class="auth-switch">Already have an account? <button class="link-btn" data-go="login">Sign in</button></div>
    `);
    document.getElementById("signup-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const errBox = document.getElementById("auth-error");
      errBox.innerHTML = "";
      try {
        await SS.Auth.signup({
          name: document.getElementById("name").value.trim(),
          email: document.getElementById("email").value.trim(),
          password: document.getElementById("password").value,
          role: document.getElementById("role").value,
        });
        A.toast("Account created — sign in with your credentials", "info");
        A.navigate("login");
      } catch (err) {
        errBox.innerHTML = `<div class="error-banner">${A.esc(err.message)}</div>`;
      }
    });
    document.querySelectorAll("[data-go]").forEach((b) => b.addEventListener("click", () => A.navigate(b.dataset.go)));
  }

  function renderForgot() {
    let stage = "request";
    let targetEmail = "";
    let issuedCode = "";
    function draw() {
      if (stage === "request") {
        authShell(`
          <div class="auth-title">Reset password</div>
          <div class="auth-sub">We'll generate an instant recovery code for your account.</div>
          <div id="auth-error"></div>
          <form id="f1">
            <div class="field"><label for="email">Registered Email</label><input id="email" type="email" required value="admin@stocksense.io" /></div>
            <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;margin-top:16px">Send code</button>
          </form>
          <div class="auth-switch"><button class="link-btn" data-go="login">Back to sign in</button></div>
        `);
        document.getElementById("f1").addEventListener("submit", async (e) => {
          e.preventDefault();
          const errBox = document.getElementById("auth-error");
          errBox.innerHTML = "";
          try {
            targetEmail = document.getElementById("email").value.trim();
            issuedCode = await SS.Auth.requestOtp(targetEmail);
            stage = "verify";
            draw();
          } catch (err) {
            errBox.innerHTML = `<div class="error-banner">${A.esc(err.message)}</div>`;
          }
        });
      } else {
        authShell(`
          <div class="auth-title">Enter Verification Code</div>
          <div class="auth-sub">In this client-side environment, here is your generated OTP for ${A.esc(targetEmail)}:</div>
          <div class="otp-box">${A.esc(issuedCode)}</div>
          <div id="auth-error"></div>
          <form id="f2">
            <div class="form-grid single">
              <div class="field"><label for="code">6-digit Code</label><input id="code" required placeholder="e.g. 123456" /></div>
              <div class="field"><label for="np">New Password</label><input id="np" type="password" required minlength="6" /></div>
            </div>
            <button class="btn btn-primary" type="submit" style="width:100%;justify-content:center;margin-top:16px">Set new password</button>
          </form>
          <div class="auth-switch"><button class="link-btn" data-go="login">Back to sign in</button></div>
        `);
        document.getElementById("f2").addEventListener("submit", async (e) => {
          e.preventDefault();
          const errBox = document.getElementById("auth-error");
          errBox.innerHTML = "";
          try {
            await SS.Auth.verifyOtpAndReset(targetEmail, document.getElementById("code").value.trim(), document.getElementById("np").value);
            A.toast("Password reset successfully — please sign in", "info");
            A.navigate("login");
          } catch (err) {
            errBox.innerHTML = `<div class="error-banner">${A.esc(err.message)}</div>`;
          }
        });
      }
      document.querySelectorAll("[data-go]").forEach((b) => b.addEventListener("click", () => A.navigate(b.dataset.go)));
    }
    draw();
  }

  A.renderLogin = renderLogin;
  A.renderSignup = renderSignup;
  A.renderForgot = renderForgot;
})();

/* ============================================================
   App Shell Layout & Navigation
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  const NAV = [
    { group: "Overview", items: [{ id: "dashboard", label: "Dashboard", ico: A.ICONS.dashboard }] },
    {
      group: "Catalog",
      items: [
        { id: "products", label: "Products", ico: A.ICONS.products },
        { id: "categories", label: "Categories", ico: A.ICONS.categories },
        { id: "sales-ranks", label: "Sales & Ranks", ico: A.ICONS.chart },
      ],
    },
    {
      group: "Operations",
      items: [
        { id: "receipts", label: "Receipts", ico: A.ICONS.receipts },
        { id: "deliveries", label: "Deliveries", ico: A.ICONS.deliveries },
        { id: "transfers", label: "Transfers", ico: A.ICONS.transfers },
        { id: "due-dates", label: "Due Dates", ico: A.ICONS.calendar },
        { id: "adjustments", label: "Adjustments", ico: A.ICONS.adjustments },
      ],
    },
    {
      group: "Traceability",
      items: [
        { id: "ledger", label: "Stock Ledger", ico: A.ICONS.ledger },
        { id: "reorder", label: "Reorder Rules", ico: A.ICONS.reorder },
        { id: "warehouses", label: "Warehouses", ico: A.ICONS.warehouses },
      ],
    },
    { group: "Account", items: [{ id: "profile", label: "Profile & Settings", ico: A.ICONS.profile }] },
  ];

  const PAGE_TITLES = {
    dashboard: "Dashboard",
    products: "Products & Stock",
    categories: "Categories",
    "sales-ranks": "Product Sales & Rank Analytics",
    receipts: "Incoming Receipts",
    deliveries: "Customer Deliveries",
    transfers: "Internal Transfers",
    "due-dates": "Scheduled Operations & Due Dates",
    adjustments: "Inventory Adjustments",
    ledger: "Stock Ledger",
    reorder: "Reorder Rules",
    warehouses: "Warehouses & Locations",
    profile: "Profile & Workspace Settings",
  };

  async function pendingCount() {
    const [r, d, t] = await Promise.all([SS.Repo.getAll("receipts"), SS.Repo.getAll("deliveries"), SS.Repo.getAll("transfers")]);
    return r.filter((x) => x.status === "draft").length + d.filter((x) => x.status === "draft").length + t.filter((x) => x.status === "draft").length;
  }
  async function unreadNotifCount() {
    const n = await SS.Repo.getAll("notifications");
    return n.filter((x) => !x.read).length;
  }

  async function renderShellChrome() {
    const pending = await pendingCount();
    const unread = await unreadNotifCount();
    A.root.innerHTML = `
      <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
      <div class="shell">
        <aside class="sidebar" id="sidebar">
          <div class="brand">
            <div class="brand-mark">SS</div>
            <div><div class="brand-name">StockSense</div><div class="brand-sub">Inventory Core</div></div>
          </div>
          ${NAV.map(
            (g) => `
            <div class="nav-group">
              <div class="nav-group-label">${A.esc(g.group)}</div>
              ${g.items
                .map(
                  (it) => `<a href="#/${it.id}" class="nav-link" data-route="${it.id}">
                    <span class="nav-ico">${it.ico}</span><span>${A.esc(it.label)}</span>
                  </a>`
                )
                .join("")}
            </div>`
          ).join("")}
          <div class="sidebar-foot">
            <div style="font-size:11px;color:var(--text-faint)">Signed in as</div>
            <div style="font-size:13px;margin-top:2px;font-weight:600">${A.esc(A.state.user.name)} <span class="badge badge-role" style="margin-left:4px">${A.esc(A.state.user.role)}</span></div>
            <button class="btn btn-ghost btn-sm" id="logout-btn" style="margin-top:8px;width:100%;justify-content:center">Sign out</button>
          </div>
        </aside>
        <div class="main">
          <div class="topbar">
            <div class="topbar-left">
              <button class="icon-btn" id="menu-btn" aria-label="Toggle navigation menu">${A.ICONS.menu}</button>
              <div class="topbar-title" id="topbar-title">Dashboard</div>
            </div>
            <div class="search-box">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <input id="global-search" placeholder="Search products, SKUs, references…" aria-label="Global search" />
              <span class="search-shortcut">/</span>
            </div>
            <div class="topbar-right">
              <button class="icon-btn" id="notif-btn" aria-label="Notifications">
                ${A.ICONS.bell}${unread > 0 ? '<span class="dot-badge"></span>' : ""}
              </button>
              <div style="position:relative">
                <div class="user-chip" id="user-chip-btn" style="cursor:pointer;user-select:none">
                  <div class="avatar">${A.initials(A.state.user.name)}</div>
                  <span style="font-size:12.5px;font-weight:500">${A.esc(A.state.user.name.split(" ")[0])}</span>
                  <span style="font-size:9px;color:var(--text-faint);margin-left:2px">▼</span>
                </div>
                <div class="dropdown-menu hidden" id="user-dropdown-menu">
                  <div class="dropdown-header">
                    <div style="font-weight:600">${A.esc(A.state.user.name)}</div>
                    <div style="font-size:11px;color:var(--text-faint)">${A.esc(A.state.user.email)}</div>
                    <span class="badge badge-role" style="margin-top:4px">${A.esc(A.state.user.role)}</span>
                  </div>
                  <div class="divider" style="margin:6px 0"></div>
                  <a href="#/profile" class="dropdown-item" data-route="profile">${A.ICONS.profile} Profile & Settings</a>
                  <a href="#/ledger" class="dropdown-item" data-route="ledger">${A.ICONS.ledger} Stock Ledger</a>
                  <div class="divider" style="margin:6px 0"></div>
                  <button class="dropdown-item danger" id="dropdown-logout-btn">Sign Out</button>
                </div>
              </div>
            </div>
          </div>
          <div class="content" id="page-content" role="main"></div>
        </div>
      </div>`;

    // Mobile Sidebar toggle wiring
    const sidebar = document.getElementById("sidebar");
    const backdrop = document.getElementById("sidebar-backdrop");
    const menuBtn = document.getElementById("menu-btn");

    function toggleSidebar() {
      const open = sidebar.classList.toggle("open");
      backdrop.classList.toggle("active", open);
    }
    function closeSidebar() {
      sidebar.classList.remove("open");
      backdrop.classList.remove("active");
    }

    menuBtn.addEventListener("click", toggleSidebar);
    backdrop.addEventListener("click", closeSidebar);

    // User profile dropdown toggle
    const userChipBtn = document.getElementById("user-chip-btn");
    const userDropdownMenu = document.getElementById("user-dropdown-menu");
    if (userChipBtn && userDropdownMenu) {
      userChipBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        userDropdownMenu.classList.toggle("hidden");
      });
      document.addEventListener("click", (e) => {
        if (!e.target.closest("#user-dropdown-menu") && !e.target.closest("#user-chip-btn")) {
          userDropdownMenu.classList.add("hidden");
        }
      });
      userDropdownMenu.querySelectorAll("[data-route]").forEach((a) => {
        a.addEventListener("click", (e) => {
          e.preventDefault();
          userDropdownMenu.classList.add("hidden");
          A.navigate(a.dataset.route);
        });
      });
      const dropLogout = document.getElementById("dropdown-logout-btn");
      if (dropLogout) {
        dropLogout.addEventListener("click", () => {
          A.state.user = null;
          localStorage.removeItem("ss_session_user");
          A.navigate("login");
        });
      }
    }

    document.getElementById("logout-btn").addEventListener("click", () => {
      A.state.user = null;
      localStorage.removeItem("ss_session_user");
      A.navigate("login");
    });
    document.getElementById("notif-btn").addEventListener("click", () => A.renderNotificationsPanel());

    const globalSearch = document.getElementById("global-search");
    globalSearch.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        A.navigate("products", { q: e.target.value });
      }
    });

    // Keyboard shortcut '/' to focus global search
    document.addEventListener("keydown", (e) => {
      if (e.key === "/" && document.activeElement.tagName !== "INPUT" && document.activeElement.tagName !== "TEXTAREA") {
        e.preventDefault();
        globalSearch.focus();
        globalSearch.select();
      }
    });

    updateBadges(pending);
  }

  function updateBadges(pendingCountVal) {
    document.querySelectorAll(".nav-badge").forEach((b) => b.remove());
    if (pendingCountVal > 0) {
      const target = document.querySelector('.nav-link[data-route="receipts"]');
      if (target) target.insertAdjacentHTML("beforeend", `<span class="nav-badge">${pendingCountVal}</span>`);
    }
  }

  function setActiveNav(route) {
    document.querySelectorAll(".nav-link").forEach((a) => a.classList.toggle("active", a.dataset.route === route));
    const t = document.getElementById("topbar-title");
    if (t) t.textContent = PAGE_TITLES[route] || "StockSense";
  }

  const PAGE_RENDERERS = {};

  async function navigate(route, params) {
    A.state.route = route;
    location.hash = "/" + route;

    if (!A.state.user) {
      if (route === "signup") return A.renderSignup();
      if (route === "forgot") return A.renderForgot();
      return A.renderLogin();
    }

    if (route === "notifications-panel") {
      await A.renderNotificationsPanel();
      return;
    }

    if (!document.querySelector(".shell")) {
      await renderShellChrome();
      wireNavLinks();
    } else {
      const pending = await pendingCount();
      const unread = await unreadNotifCount();
      const notifBtn = document.getElementById("notif-btn");
      if (notifBtn) notifBtn.innerHTML = `${A.ICONS.bell}${unread > 0 ? '<span class="dot-badge"></span>' : ""}`;
      updateBadges(pending);
    }

    // Close mobile sidebar on navigation
    const sidebar = document.getElementById("sidebar");
    const backdrop = document.getElementById("sidebar-backdrop");
    if (sidebar) sidebar.classList.remove("open");
    if (backdrop) backdrop.classList.remove("active");

    setActiveNav(route);
    const content = document.getElementById("page-content");
    content.innerHTML = `<div class="skeleton skel-row" style="width:35%"></div><div class="skeleton skel-row" style="width:90%"></div><div class="skeleton skel-row" style="width:75%"></div>`;
    const renderer = PAGE_RENDERERS[route] || PAGE_RENDERERS.dashboard;
    try {
      await renderer(content, params || {});
    } catch (err) {
      content.innerHTML = `<div class="error-banner">Error loading ${esc(route)}: ${A.esc(err.message)}</div>`;
      console.error(err);
    }
  }

  function wireNavLinks() {
    document.querySelectorAll(".nav-link").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        A.navigate(a.dataset.route);
      });
    });
  }

  // Document details viewer modal with print slip capability
  function viewDocumentModal({ type, doc, productById, locById, whById, onAction }) {
    const isDraft = doc.status === "draft";
    const title = `${type.toUpperCase()} #${doc.id}`;
    const linesHtml = doc.lines.map((l) => {
      const p = productById[l.productId];
      const name = p ? p.name : l.productId;
      const sku = p ? p.sku : "";
      const unit = p ? p.unit : "";
      const qtyStr = type === "adjustment"
        ? `Counted: <strong>${A.fmtQty(l.countedQuantity, unit)}</strong>`
        : `Qty: <strong>${A.fmtQty(l.quantity, unit)}</strong>`;
      return `
        <tr>
          <td><div style="font-weight:600">${A.esc(name)}</div><div class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(sku)}</div></td>
          <td class="num">${qtyStr}</td>
        </tr>`;
    }).join("");

    const dueInfo = A.calcDueStatus(doc.dueDate || doc.createdAt?.split("T")[0], doc.status, doc.validatedAt);

    const bodyHtml = `
      <div class="doc-detail-meta">
        <div class="doc-meta-item"><div class="lbl">Reference ID</div><div class="val mono">${A.esc(doc.id)}</div></div>
        <div class="doc-meta-item"><div class="lbl">Status</div><div class="val">${A.statusBadge(doc.status)}</div></div>
        <div class="doc-meta-item"><div class="lbl">Scheduled Due Date</div><div class="val"><span class="mono">${A.esc(dueInfo.formattedDate)}</span> <span class="badge ${dueInfo.badgeClass}" style="font-size:10px;margin-left:4px">${A.esc(dueInfo.label)}</span></div></div>
        <div class="doc-meta-item"><div class="lbl">Created Date</div><div class="val">${A.fmtDate(doc.createdAt)}</div></div>
        ${doc.supplier ? `<div class="doc-meta-item"><div class="lbl">Supplier</div><div class="val">${A.esc(doc.supplier)}</div></div>` : ""}
        ${doc.customer ? `<div class="doc-meta-item"><div class="lbl">Customer</div><div class="val">${A.esc(doc.customer)}</div></div>` : ""}
        ${doc.warehouseId ? `<div class="doc-meta-item"><div class="lbl">Warehouse</div><div class="val">${A.esc(whById[doc.warehouseId]?.name || "—")}</div></div>` : ""}
        ${doc.locationId ? `<div class="doc-meta-item"><div class="lbl">Location</div><div class="val">${A.esc(locById[doc.locationId]?.name || "—")}</div></div>` : ""}
        ${doc.sourceWarehouseId ? `<div class="doc-meta-item"><div class="lbl">Source Warehouse</div><div class="val">${A.esc(whById[doc.sourceWarehouseId]?.name || "—")}</div></div>` : ""}
        ${doc.destWarehouseId ? `<div class="doc-meta-item"><div class="lbl">Dest Warehouse</div><div class="val">${A.esc(whById[doc.destWarehouseId]?.name || "—")}</div></div>` : ""}
        ${doc.validatedAt ? `<div class="doc-meta-item"><div class="lbl">Validated At</div><div class="val">${A.fmtDate(doc.validatedAt)}</div></div>` : ""}
      </div>
      <div class="panel-title" style="margin-bottom:8px">Line Items (${doc.lines.length})</div>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Item</th><th style="text-align:right">Quantity</th></tr></thead>
          <tbody>${linesHtml}</tbody>
        </table>
      </div>
    `;

    const footHtml = `
      <button class="btn btn-ghost" onclick="window.print()">${A.ICONS.print} Print Slip</button>
      ${isDraft ? `<button class="btn btn-danger" id="doc-cancel-btn">Cancel</button><button class="btn btn-primary" id="doc-val-btn">Validate</button>` : ""}
      <button class="btn btn-ghost" data-close>Close</button>
    `;

    const ov = A.openModal({ title, bodyHtml, wide: true, footHtml, onMount: (modalEl) => {
      const valBtn = modalEl.querySelector("#doc-val-btn");
      const cancelBtn = modalEl.querySelector("#doc-cancel-btn");
      if (valBtn) valBtn.addEventListener("click", () => onAction("validate", doc));
      if (cancelBtn) cancelBtn.addEventListener("click", () => onAction("cancel", doc));
    }});
  }

  A.navigate = navigate;
  A.PAGE_RENDERERS = PAGE_RENDERERS;
  A.pendingCount = pendingCount;
  A.viewDocumentModal = viewDocumentModal;
})();

/* ============================================================
   Page: Dashboard
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.dashboard = async function (mount) {
    const [summary, productsRaw, deliveries, ledger] = await Promise.all([
      SS.getDashboardSummary(),
      SS.Repo.getAll("products"),
      SS.Repo.getAll("deliveries"),
      SS.Repo.getAll("ledger"),
    ]);
    const products = productsRaw.map(A.normalizeProduct);
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const salesData = A.computeSalesAnalytics(deliveries, products, ledger, 7);

    const totalProd = Math.max(1, summary.totalProducts);
    const healthPercent = Math.round((summary.healthyStock / totalProd) * 100);
    const lowPercent = Math.round((summary.lowStockProducts / totalProd) * 100);
    const outPercent = Math.round((summary.outOfStockProducts / totalProd) * 100);

    mount.innerHTML = `
      <div class="page-header">
        <div>
          <div class="page-title">Executive Inventory Overview</div>
          <div class="page-sub">Authoritative real-time metrics computed live from warehouse receipts, deliveries, and adjustments.</div>
        </div>
        <div style="display:flex;gap:8px">
          <a class="btn" href="#/sales-ranks" data-route="sales-ranks">${A.ICONS.chart} Sales & Ranks</a>
          <a class="btn" href="#/ledger" data-route="ledger">${A.ICONS.ledger} Full Ledger</a>
          <button class="btn btn-primary" id="dash-quick-rcpt">${A.ICONS.receipts} Receive Stock</button>
        </div>
      </div>

      <div class="health-bar-card">
        <div class="health-bar-head">
          <div class="health-bar-title">Catalog Stock Health Breakdown</div>
          <div class="mono" style="font-size:12px;color:var(--text-muted)">${summary.totalProducts} Total SKUs</div>
        </div>
        <div class="health-bar">
          <div class="health-seg" style="width:${healthPercent}%;background:var(--in);" title="${summary.healthyStock} Optimal"></div>
          <div class="health-seg" style="width:${lowPercent}%;background:var(--warn);" title="${summary.lowStockProducts} Low Stock"></div>
          <div class="health-seg" style="width:${outPercent}%;background:var(--out);" title="${summary.outOfStockProducts} Out of Stock"></div>
        </div>
        <div class="health-legend">
          <div class="legend-item"><span class="legend-dot" style="background:var(--in)"></span>Optimal (${summary.healthyStock})</div>
          <div class="legend-item"><span class="legend-dot" style="background:var(--warn)"></span>Low Stock Alert (${summary.lowStockProducts})</div>
          <div class="legend-item"><span class="legend-dot" style="background:var(--out)"></span>Out of Stock (${summary.outOfStockProducts})</div>
        </div>
      </div>

      <div class="grid-stats">
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Total SKUs</span><span class="stat-flag" style="background:var(--accent)"></span></div>
          <div class="stat-value">${summary.totalProducts}</div>
          <div class="stat-sub">Active catalog lines</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Total Units</span><span class="stat-flag" style="background:var(--in)"></span></div>
          <div class="stat-value accent">${A.fmtQty(summary.currentInventory)}</div>
          <div class="stat-sub">Across all locations</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Low Stock</span><span class="stat-flag" style="background:var(--warn)"></span></div>
          <div class="stat-value warn">${summary.lowStockProducts}</div>
          <div class="stat-sub">Below reorder point</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Out of Stock</span><span class="stat-flag" style="background:var(--out)"></span></div>
          <div class="stat-value danger">${summary.outOfStockProducts}</div>
          <div class="stat-sub">Immediate action needed</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Pending Receipts</span><span class="stat-flag" style="background:var(--info)"></span></div>
          <div class="stat-value">${summary.pendingReceipts}</div>
          <div class="stat-sub">Awaiting validation</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Pending Deliveries</span><span class="stat-flag" style="background:var(--info)"></span></div>
          <div class="stat-value">${summary.pendingDeliveries}</div>
          <div class="stat-sub">Ready to ship</div>
        </div>
      </div>

      <!-- Executive Sales Performance Graph -->
      <div class="sales-chart-panel">
        <div class="sales-chart-top">
          <div>
            <div class="panel-title" style="font-size:16px">Weekly Sales Revenue & Outbound Dispatches</div>
            <div style="font-size:12px;color:var(--text-faint)">Live fulfillment throughput from validated deliveries · ${A.fmtMoney(salesData.totalRevenue)} total revenue (${A.fmtQty(salesData.totalUnits)} units moved)</div>
          </div>
          <div style="display:flex;align-items:center;gap:10px">
            <a href="#/sales-ranks" data-route="sales-ranks" class="btn btn-ghost btn-sm">${A.ICONS.chart} Full Ranks & Sales Analytics →</a>
          </div>
        </div>
        <div class="sales-svg-container" id="dash-sales-svg"></div>
      </div>

      <div class="two-col">
        <div class="panel">
          <div class="panel-head">
            <div class="panel-title">Recent Stock Operations</div>
            <div style="display:flex;align-items:center;gap:8px">
              <select class="toolbar-select" id="dash-activity-filter" style="padding:4px 8px;font-size:12px">
                <option value="">All Operations</option>
                <option value="receipt">Receipts (Inbound)</option>
                <option value="delivery">Deliveries (Outbound)</option>
                <option value="transfer">Transfers (Internal)</option>
                <option value="adjustment">Adjustments</option>
              </select>
              <a href="#/ledger" data-route="ledger" class="btn btn-ghost btn-sm">Full History →</a>
            </div>
          </div>
          <div id="activity-feed"></div>
        </div>

        <div class="panel">
          <div class="panel-head"><div class="panel-title">Quick Operations</div></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <a class="btn" href="#/receipts" data-route="receipts">${A.ICONS.receipts} Receive</a>
            <a class="btn" href="#/deliveries" data-route="deliveries">${A.ICONS.deliveries} Ship Delivery</a>
            <a class="btn" href="#/transfers" data-route="transfers">${A.ICONS.transfers} Transfer</a>
            <a class="btn" href="#/adjustments" data-route="adjustments">${A.ICONS.adjustments} Physical Count</a>
          </div>
          <div class="divider"></div>
          <div class="panel-title" style="font-size:13.5px;margin-bottom:8px">Inventory Action Items</div>
          <div id="dash-alerts"></div>
        </div>
      </div>
    `;

    A.renderSalesSvgChart({
      container: mount.querySelector("#dash-sales-svg"),
      dailySales: salesData.dailySales,
      mode: "revenue",
    });

    const feed = mount.querySelector("#activity-feed");
    function renderActivityFeed(filterType = "") {
      const filtered = summary.recentActivity.filter((l) => !filterType || l.refType === filterType);
      if (filtered.length === 0) {
        feed.innerHTML = `<div class="empty-state"><div class="em-icon">▢</div><div class="em-title">No stock movements recorded</div><div class="em-sub">No recent operations match the selected filter.</div></div>`;
      } else {
        feed.innerHTML = filtered
          .map((l) => {
            const p = productById[l.productId];
            return `<div class="feed-row">
              <div class="feed-dir ${l.direction}">${l.direction === "in" ? "↓" : "↑"}</div>
              <div class="feed-main">
                <div class="feed-title">${A.esc(p ? p.name : l.productId)} · <span class="badge badge-draft" style="font-size:10px">${A.esc(l.refType)}</span></div>
                <div class="feed-sub">${A.fmtDate(l.timestamp)}</div>
              </div>
              <div class="feed-qty" style="color:${l.direction === "in" ? "var(--in)" : "var(--out)"}">
                ${l.direction === "in" ? "+" : "−"}${A.fmtQty(l.quantity, p ? p.unit : "")}
              </div>
            </div>`;
          })
          .join("");
      }
    }

    renderActivityFeed();

    const activityFilter = mount.querySelector("#dash-activity-filter");
    if (activityFilter) {
      activityFilter.addEventListener("change", (e) => {
        renderActivityFeed(e.target.value);
      });
    }

    const notifs = (await SS.Repo.getAll("notifications")).filter((n) => !n.read).slice(0, 5);
    const alertsBox = mount.querySelector("#dash-alerts");
    alertsBox.innerHTML = notifs.length
      ? notifs.map((n) => `<div class="feed-row">
          <div class="feed-dir ${n.type === "out_of_stock" ? "out" : ""}" style="background:${n.type === "out_of_stock" ? "var(--out-dim)" : "var(--warn-dim)"};color:${n.type === "out_of_stock" ? "var(--out)" : "var(--warn)"}">!</div>
          <div class="feed-main"><div class="feed-title" style="font-size:12.5px">${A.esc(n.message)}</div><div class="feed-sub">${A.fmtDate(n.createdAt)}</div></div>
        </div>`).join("")
      : `<div class="field-hint" style="padding:10px 0">All inventory levels are within configured operating boundaries.</div>`;

    mount.querySelector("#dash-quick-rcpt").addEventListener("click", () => A.navigate("receipts"));
    mount.querySelectorAll("[data-route]").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); A.navigate(a.dataset.route); }));
  };
})();

/* ============================================================
   Page: Products Catalog
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  async function stockTotalsByProduct() {
    const stock = await SS.Repo.getAll("stock");
    const totals = {};
    stock.forEach((s) => { totals[s.productId] = (totals[s.productId] || 0) + s.quantity; });
    return totals;
  }

  function productFormModal({ product, categories, locations = [], warehouses = [], onSaved }) {
    const isEdit = !!product;
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));
    A.openModal({
      title: isEdit ? "Edit Product Details" : "Register New Product",
      bodyHtml: `
        <form id="product-form">
          <div class="form-grid">
            <div class="field"><label for="p-name">Product Name</label><input id="p-name" required value="${A.esc(product ? product.name : "")}" placeholder="e.g. Copper Cable 2.5sqmm" /></div>
            <div class="field"><label for="p-sku">SKU Code</label><input id="p-sku" required value="${A.esc(product ? product.sku : "")}" placeholder="e.g. ELE-CBL-2.5" /></div>
            <div class="field"><label for="p-unit">Unit of Measure</label>
              <select id="p-unit">
                ${["PCS","KG","M","L","BOX","ROLL","MTR"].map((u) => `<option value="${u}" ${product && product.unit === u ? "selected" : ""}>${u}</option>`).join("")}
              </select>
            </div>
            <div class="field"><label for="p-cat">Product Category</label>
              <select id="p-cat">
                <option value="">Uncategorized</option>
                ${categories.map((c) => `<option value="${c.id}" ${product && product.categoryId === c.id ? "selected" : ""}>${A.esc(c.name)}</option>`).join("")}
              </select>
            </div>
            <div class="field"><label for="p-unit-price">Sales Unit Price ($)</label><input id="p-unit-price" type="number" step="any" min="0" value="${product ? (product.unitPrice || 0) : 50}" placeholder="50.00" /></div>
            <div class="field"><label for="p-title-rank">Title Rank (Peak Career Tier)</label>
              <select id="p-title-rank">
                ${["Diamond","Platinum","Gold","Silver","Bronze"].map((r) => `<option value="${r}" ${(product ? (product.titleRank || "Gold") : "Gold") === r ? "selected" : ""}>${r}</option>`).join("")}
              </select>
            </div>
            <div class="field"><label for="p-pay-rank">Pay Rank (Compensation Tier)</label>
              <select id="p-pay-rank">
                ${["Diamond","Platinum","Gold","Silver","Bronze"].map((r) => `<option value="${r}" ${(product ? (product.payRank || "Gold") : "Gold") === r ? "selected" : ""}>${r}</option>`).join("")}
              </select>
            </div>
            <div class="field"><label for="p-active-rank">Active Rank (Eligibility Status)</label>
              <select id="p-active-rank">
                ${["Active","Grace Period","Inactive"].map((s) => `<option value="${s}" ${(product ? (product.activeRank || "Active") : "Active") === s ? "selected" : ""}>${s}</option>`).join("")}
              </select>
            </div>
            ${!isEdit ? `
            <div class="field">
              <label for="p-init-stock">Initial Stock Quantity <span style="color:var(--text-faint)">(Optional)</span></label>
              <input id="p-init-stock" type="number" min="0" step="any" placeholder="0" />
            </div>
            <div class="field">
              <label for="p-init-loc">Initial Storage Bin Location</label>
              <select id="p-init-loc">
                <option value="">Select location if stock > 0...</option>
                ${locations.map((l) => `<option value="${l.id}">${A.esc(whById[l.warehouseId]?.name || "Warehouse")} / ${A.esc(l.name)}</option>`).join("")}
              </select>
            </div>
            ` : ""}
          </div>
          <div id="product-error" style="margin-top:10px"></div>
        </form>
      `,
      footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="product-save">${isEdit ? "Save Changes" : "Create Product"}</button>`,
      onMount: (ov) => {
        ov.querySelector("#product-save").addEventListener("click", async () => {
          const name = ov.querySelector("#p-name").value.trim();
          const sku = ov.querySelector("#p-sku").value.trim().toUpperCase();
          const unit = ov.querySelector("#p-unit").value;
          const categoryId = ov.querySelector("#p-cat").value || null;
          const unitPrice = parseFloat(ov.querySelector("#p-unit-price")?.value || "0");
          const titleRank = ov.querySelector("#p-title-rank")?.value || "Gold";
          const payRank = ov.querySelector("#p-pay-rank")?.value || "Gold";
          const activeRank = ov.querySelector("#p-active-rank")?.value || "Active";
          const errBox = ov.querySelector("#product-error");
          errBox.innerHTML = "";
          if (!name || !sku) { errBox.innerHTML = `<div class="error-banner">Name and SKU code are mandatory fields.</div>`; return; }
          try {
            const all = await SS.Repo.getAll("products");
            const dup = all.find((p) => p.sku.toLowerCase() === sku.toLowerCase() && (!product || p.id !== product.id));
            if (dup) throw new Error("A product with SKU '" + sku + "' already exists.");
            const rec = product ? { ...product } : { id: SS.uid("prod") };
            rec.name = name; rec.sku = sku; rec.unit = unit; rec.categoryId = categoryId;
            rec.unitPrice = unitPrice; rec.titleRank = titleRank; rec.payRank = payRank; rec.activeRank = activeRank;
            await SS.Repo.put("products", rec);

            if (!isEdit) {
              const initStock = parseFloat(ov.querySelector("#p-init-stock")?.value || "0");
              const initLocId = ov.querySelector("#p-init-loc")?.value;
              if (initStock > 0) {
                if (!initLocId) {
                  throw new Error("Please select an initial storage location for the initial stock quantity.");
                }
                const targetLoc = locations.find((l) => l.id === initLocId);
                if (targetLoc) {
                  const row = await SS.getOrCreateStockRow(rec.id, targetLoc.id, targetLoc.warehouseId);
                  row.quantity = initStock;
                  await SS.Repo.put("stock", row);
                  await SS.Repo.put("ledger", {
                    id: SS.uid("led"),
                    refType: "receipt",
                    refId: "INIT-" + rec.sku,
                    productId: rec.id,
                    locationId: targetLoc.id,
                    warehouseId: targetLoc.warehouseId,
                    direction: "in",
                    quantity: initStock,
                    before: 0,
                    after: initStock,
                    timestamp: SS.now(),
                    userId: A.state?.user ? A.state.user.id : "admin",
                  });
                }
              }
            }

            A.toast(isEdit ? "Product updated" : "Product registered", "info");
            A.closeModal();
            onSaved();
          } catch (err) {
            errBox.innerHTML = `<div class="error-banner">${A.esc(err.message)}</div>`;
          }
        });
      },
    });
  }

  A.PAGE_RENDERERS.products = async function (mount, params) {
    const [rawProducts, categories, rules, locations, warehouses] = await Promise.all([
      SS.Repo.getAll("products"),
      SS.Repo.getAll("categories"),
      SS.Repo.getAll("reorderRules"),
      SS.Repo.getAll("locations"),
      SS.Repo.getAll("warehouses"),
    ]);
    const products = rawProducts.map(A.normalizeProduct);
    const totals = await stockTotalsByProduct();
    const catById = Object.fromEntries(categories.map((c) => [c.id, c]));

    const totalValuation = products.reduce((acc, p) => acc + (totals[p.id] || 0) * (p.unitPrice || 0), 0);
    const diamondPlatCount = products.filter((p) => p.titleRank === "Diamond" || p.titleRank === "Platinum").length;
    const activeCount = products.filter((p) => p.activeRank === "Active").length;

    mount.innerHTML = `
      <div class="page-header">
        <div>
          <div class="page-title">Products & Inventory Stock</div>
          <div class="page-sub">${products.length} registered SKUs with Title, Pay, and Active Rank tiers.</div>
        </div>
        <div style="display:flex;gap:8px">
          <a class="btn btn-ghost" href="#/sales-ranks" data-route="sales-ranks">${A.ICONS.chart} Sales Analytics</a>
          <button class="btn btn-ghost" id="export-products-csv">${A.ICONS.download} Export CSV</button>
          <button class="btn btn-primary" id="new-product">+ Add Product</button>
        </div>
      </div>

      <div class="grid-stats">
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Total SKUs</span><span class="stat-flag" style="background:var(--accent)"></span></div>
          <div class="stat-value">${products.length}</div>
          <div class="stat-sub">Active catalog lines</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Diamond / Platinum SKUs</span><span class="stat-flag" style="background:#38BDF8"></span></div>
          <div class="stat-value" style="color:#38BDF8">${diamondPlatCount}</div>
          <div class="stat-sub">Top-tier product lines</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Active / Qualified</span><span class="stat-flag" style="background:var(--in)"></span></div>
          <div class="stat-value" style="color:var(--in)">${activeCount} <span style="font-size:13px;color:var(--text-faint)">(${Math.round((activeCount / Math.max(1, products.length)) * 100)}%)</span></div>
          <div class="stat-sub">Qualified for payouts</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Total Inventory Value</span><span class="stat-flag" style="background:var(--accent)"></span></div>
          <div class="stat-value accent">${A.fmtMoney(totalValuation)}</div>
          <div class="stat-sub">Valuation on hand</div>
        </div>
      </div>

      <div class="filter-chips">
        <button class="chip active" data-filter-status="">All Products (${products.length})</button>
        <button class="chip" data-filter-status="in">In Stock</button>
        <button class="chip" data-filter-status="low">Low Stock</button>
        <button class="chip" data-filter-status="out">Out of Stock</button>
      </div>
      <div class="panel"><div id="products-table"></div></div>
    `;

    const rows = products.map((p) => {
      const total = totals[p.id] || 0;
      const rule = rules.find((r) => r.productId === p.id);
      let statusKey = "in";
      let stockBadge = `<span class="badge badge-ok">In stock</span>`;
      if (total <= 0) {
        statusKey = "out";
        stockBadge = `<span class="badge badge-out">Out of stock</span>`;
      } else if (rule && total <= rule.minQuantity) {
        statusKey = "low";
        stockBadge = `<span class="badge badge-low">Low stock (${rule.minQuantity})</span>`;
      }
      return {
        ...p,
        total,
        statusKey,
        stockBadge,
        categoryName: p.categoryId && catById[p.categoryId] ? catById[p.categoryId].name : "Uncategorized",
        reorderThreshold: rule ? rule.minQuantity : "—",
      };
    });

    const dt = A.dataTable({
      mount: mount.querySelector("#products-table"),
      rows,
      rowKey: "id",
      initialQuery: params && params.q ? params.q : "",
      searchKeys: ["name", "sku", "titleRank", "payRank"],
      filters: [
        { key: "categoryId", label: "Category", options: categories.map((c) => ({ value: c.id, label: c.name })) },
        { key: "titleRank", label: "Title Rank", options: [
          { value: "Diamond", label: "💎 Diamond" },
          { value: "Platinum", label: "👑 Platinum" },
          { value: "Gold", label: "🥇 Gold" },
          { value: "Silver", label: "🥈 Silver" },
          { value: "Bronze", label: "🥉 Bronze" },
        ] },
        { key: "activeRank", label: "Active Status", options: [
          { value: "Active", label: "● Active" },
          { value: "Grace Period", label: "● Grace Period" },
          { value: "Inactive", label: "● Inactive" },
        ] },
      ],
      columns: [
        { key: "sku", label: "SKU", render: (r) => `<span class="mono" style="font-weight:600">${A.esc(r.sku)}</span>` },
        { key: "name", label: "Product Name" },
        { key: "categoryName", label: "Category" },
        { key: "titleRank", label: "Title Rank", render: (r) => A.titleRankBadge(r.titleRank) },
        { key: "payRank", label: "Pay Rank", render: (r) => A.payRankBadge(r.payRank) },
        { key: "activeRank", label: "Active Status", render: (r) => A.activeRankBadge(r.activeRank) },
        { key: "unitPrice", label: "Unit Price", num: true, render: (r) => A.fmtMoney(r.unitPrice) },
        { key: "total", label: "On Hand", num: true, render: (r) => A.fmtQty(r.total, r.unit) },
        { key: "status", label: "Stock Status", render: (r) => r.stockBadge },
      ],
      rowActions: (r) => `
        <button class="btn btn-sm btn-ghost" data-history="${r.id}" title="View Ledger">History</button>
        <button class="btn btn-sm btn-ghost" data-edit="${r.id}">Edit</button>
        <button class="btn btn-sm btn-danger" data-del="${r.id}" title="Delete">✕</button>
      `,
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.products}</div><div class="em-title">No products found</div><div class="em-sub">Create your first product to begin tracking quantities.</div></div>`,
    });

    // Quick filter chips
    mount.querySelectorAll(".chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        mount.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
        btn.classList.add("active");
        dt.setFilter("statusKey", btn.dataset.filterStatus);
      });
    });

    // CSV Export
    mount.querySelector("#export-products-csv").addEventListener("click", () => {
      const headers = ["SKU", "Name", "Category", "Title Rank", "Pay Rank", "Active Status", "Unit Price", "Quantity On Hand", "Unit", "Reorder Point", "Status"];
      const csvRows = rows.map((r) => [r.sku, r.name, r.categoryName, r.titleRank, r.payRank, r.activeRank, r.unitPrice, r.total, r.unit, r.reorderThreshold, r.statusKey]);
      A.exportCSV("stocksense_products.csv", headers, csvRows);
    });

    // Delegated actions
    mount.querySelectorAll("[data-edit]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = products.find((x) => x.id === btn.dataset.edit);
        productFormModal({ product: p, categories, locations, warehouses, onSaved: () => A.navigate("products") });
      });
    });

    mount.querySelectorAll("[data-history]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = products.find((x) => x.id === btn.dataset.history);
        A.navigate("ledger", { q: p ? p.name : "" });
      });
    });

    mount.querySelectorAll("[data-del]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const p = products.find((x) => x.id === btn.dataset.del);
        A.confirmDialog({
          title: `Delete ${p ? p.name : "Product"}?`,
          message: "Removing this product will delete its master record. Existing stock ledger history will be preserved.",
          confirmLabel: "Delete Product",
          danger: true,
          onConfirm: async () => {
            await SS.Repo.delete("products", p.id);
            A.toast("Product deleted", "info");
            A.navigate("products");
          },
        });
      });
    });

    document.getElementById("new-product").addEventListener("click", () => {
      productFormModal({ categories, locations, warehouses, onSaved: () => A.navigate("products") });
    });
  };

  A.stockTotalsByProduct = stockTotalsByProduct;
})();

/* ============================================================
   Page: Product Sales & Rank Analytics
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS["sales-ranks"] = async function (mount, params) {
    const [deliveries, productsRaw, ledger, warehouses, categories] = await Promise.all([
      SS.Repo.getAll("deliveries"),
      SS.Repo.getAll("products"),
      SS.Repo.getAll("ledger"),
      SS.Repo.getAll("warehouses"),
      SS.Repo.getAll("categories"),
    ]);

    const products = productsRaw.map(A.normalizeProduct);
    const analytics7 = A.computeSalesAnalytics(deliveries, products, ledger, 7);
    const analytics30 = A.computeSalesAnalytics(deliveries, products, ledger, 30);

    let currentRange = 7;
    let currentMode = "revenue";

    function renderView() {
      const data = currentRange === 7 ? analytics7 : analytics30;
      const totalRev = data.totalRevenue;
      const totalUnits = data.totalUnits;
      const totalOrders = data.totalOrders;
      const avgOrder = totalOrders > 0 ? totalRev / totalOrders : 0;

      // Rank totals
      const diamondRev = data.rankBreakdown.Diamond.revenue;
      const platRev = data.rankBreakdown.Platinum.revenue;
      const goldRev = data.rankBreakdown.Gold.revenue;
      const silverRev = data.rankBreakdown.Silver.revenue;
      const bronzeRev = data.rankBreakdown.Bronze.revenue;

      mount.innerHTML = `
        <div class="page-header">
          <div>
            <div class="page-title">Product Sales & Rank Analytics</div>
            <div class="page-sub">Performance metrics, revenue curves, and Title/Pay Rank volume distribution.</div>
          </div>
          <div style="display:flex;gap:8px">
            <button class="btn btn-ghost" id="export-sales-csv">${A.ICONS.download} Export Sales CSV</button>
            <a class="btn btn-primary" href="#/deliveries" data-route="deliveries">${A.ICONS.deliveries} New Sales Order</a>
          </div>
        </div>

        <div class="grid-stats">
          <div class="stat-card" style="border-left:4px solid var(--accent)">
            <div class="stat-top"><span class="stat-label">Total Dispatched Sales</span><span class="stat-flag" style="background:var(--accent)"></span></div>
            <div class="stat-value accent">${A.fmtMoney(totalRev)}</div>
            <div class="stat-sub">Across validated deliveries</div>
          </div>
          <div class="stat-card">
            <div class="stat-top"><span class="stat-label">Dispatched Volume</span><span class="stat-flag" style="background:var(--in)"></span></div>
            <div class="stat-value" style="color:var(--in)">${A.fmtQty(totalUnits)}</div>
            <div class="stat-sub">Total product units moved</div>
          </div>
          <div class="stat-card">
            <div class="stat-top"><span class="stat-label">Average Order Value</span><span class="stat-flag" style="background:var(--info)"></span></div>
            <div class="stat-value" style="color:var(--info)">${A.fmtMoney(avgOrder)}</div>
            <div class="stat-sub">Per validated shipment</div>
          </div>
          <div class="stat-card">
            <div class="stat-top"><span class="stat-label">Top Title Tier</span><span class="stat-flag" style="background:#38BDF8"></span></div>
            <div class="stat-value" style="color:#38BDF8">Diamond / Plat</div>
            <div class="stat-sub">${A.fmtMoney(diamondRev + platRev)} revenue share</div>
          </div>
        </div>

        <!-- Sales Chart Card -->
        <div class="sales-chart-panel">
          <div class="sales-chart-top">
            <div>
              <div class="panel-title" style="font-size:16px">Product Outbound Sales Velocity</div>
              <div style="font-size:12px;color:var(--text-faint)">Daily sales volume and revenue generation across all catalog tiers</div>
            </div>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
              <div class="filter-chips" style="margin-bottom:0">
                <button class="chip ${currentMode === "revenue" ? "active" : ""}" id="chart-mode-rev">Revenue ($)</button>
                <button class="chip ${currentMode === "units" ? "active" : ""}" id="chart-mode-units">Units Dispatched</button>
              </div>
              <div class="filter-chips" style="margin-bottom:0">
                <button class="chip ${currentRange === 7 ? "active" : ""}" id="chart-range-7">7 Days</button>
                <button class="chip ${currentRange === 30 ? "active" : ""}" id="chart-range-30">30 Days</button>
              </div>
            </div>
          </div>
          <div class="sales-svg-container" id="sales-svg-box"></div>
        </div>

        <!-- Two-Col Rank Performance -->
        <div class="two-col" style="margin-bottom:20px">
          <div class="panel">
            <div class="panel-head">
              <div class="panel-title">Sales Revenue Contribution by Title Rank</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:12px;padding:6px 0">
              ${[
                { name: "Diamond", rev: diamondRev, color: "#38BDF8" },
                { name: "Platinum", rev: platRev, color: "#C084FC" },
                { name: "Gold", rev: goldRev, color: "#FBBF24" },
                { name: "Silver", rev: silverRev, color: "#CBD5E1" },
                { name: "Bronze", rev: bronzeRev, color: "#F59E0B" },
              ].map((tier) => {
                const pct = totalRev > 0 ? Math.round((tier.rev / totalRev) * 100) : 0;
                return `
                  <div class="sales-rank-card">
                    <div class="sales-rank-header">
                      <div style="display:flex;align-items:center;gap:6px">
                        ${A.titleRankBadge(tier.name)}
                      </div>
                      <div style="text-align:right">
                        <strong>${A.fmtMoney(tier.rev)}</strong>
                        <span style="font-size:11.5px;color:var(--text-faint);margin-left:6px">(${pct}%)</span>
                      </div>
                    </div>
                    <div class="sales-rank-bar-bg">
                      <div class="sales-rank-bar-fill" style="width:${pct}%;background:${tier.color}"></div>
                    </div>
                  </div>
                `;
              }).join("")}
            </div>
          </div>

          <div class="panel">
            <div class="panel-head">
              <div class="panel-title">Rank Hierarchy & Status Overview</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:14px;font-size:13px;color:var(--text-muted)">
              <div style="background:var(--surface-2);padding:14px;border-radius:var(--radius-sm);border:1px solid var(--border)">
                <div style="font-weight:600;color:var(--text);margin-bottom:4px;display:flex;align-items:center;gap:6px">
                  ${A.titleRankBadge("Diamond")} <span>Title Rank</span>
                </div>
                <div>Highest historical milestone unlocked by cumulative product sales or package activation. Permanent recognition.</div>
              </div>
              <div style="background:var(--surface-2);padding:14px;border-radius:var(--radius-sm);border:1px solid var(--border)">
                <div style="font-weight:600;color:var(--text);margin-bottom:4px;display:flex;align-items:center;gap:6px">
                  ${A.payRankBadge("Gold")} <span>Pay Rank (Paid-As)</span>
                </div>
                <div>Active commission tier computed for the current pay period based on real-time sales volume moved.</div>
              </div>
              <div style="background:var(--surface-2);padding:14px;border-radius:var(--radius-sm);border:1px solid var(--border)">
                <div style="font-weight:600;color:var(--text);margin-bottom:4px;display:flex;align-items:center;gap:6px">
                  ${A.activeRankBadge("Active")} <span>Active Rank</span>
                </div>
                <div>Fulfillment qualification status confirming minimum threshold maintenance for commission payout eligibility.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Leaderboard Table -->
        <div class="panel">
          <div class="panel-head">
            <div class="panel-title">Product Sales & Ranks Leaderboard</div>
          </div>
          <div id="sales-leaderboard-table"></div>
        </div>
      `;

      // Draw SVG chart
      A.renderSalesSvgChart({
        container: mount.querySelector("#sales-svg-box"),
        dailySales: data.dailySales,
        mode: currentMode,
      });

      // Events for chart controls
      mount.querySelector("#chart-mode-rev").addEventListener("click", () => {
        currentMode = "revenue";
        renderView();
      });
      mount.querySelector("#chart-mode-units").addEventListener("click", () => {
        currentMode = "units";
        renderView();
      });
      mount.querySelector("#chart-range-7").addEventListener("click", () => {
        currentRange = 7;
        renderView();
      });
      mount.querySelector("#chart-range-30").addEventListener("click", () => {
        currentRange = 30;
        renderView();
      });

      mount.querySelector("#export-sales-csv").addEventListener("click", () => {
        const headers = ["Product Name", "SKU", "Title Rank", "Pay Rank", "Active Status", "Unit Price", "Units Sold", "Sales Revenue"];
        const csvRows = data.topProducts.map((tp) => [
          tp.product.name,
          tp.product.sku,
          tp.product.titleRank,
          tp.product.payRank,
          tp.product.activeRank,
          tp.product.unitPrice,
          tp.units,
          tp.revenue,
        ]);
        A.exportCSV("stocksense_product_sales_ranks.csv", headers, csvRows);
      });

      // Leaderboard dataTable
      A.dataTable({
        mount: mount.querySelector("#sales-leaderboard-table"),
        rows: data.topProducts.map((tp, idx) => ({
          rankIndex: idx + 1,
          id: tp.product.id,
          sku: tp.product.sku,
          name: tp.product.name,
          titleRank: tp.product.titleRank,
          payRank: tp.product.payRank,
          activeRank: tp.product.activeRank,
          unitPrice: tp.product.unitPrice,
          units: tp.units,
          revenue: tp.revenue,
        })),
        rowKey: "id",
        searchKeys: ["name", "sku", "titleRank"],
        columns: [
          { key: "rankIndex", label: "#", render: (r) => `<span class="mono" style="font-weight:700">#${r.rankIndex}</span>` },
          { key: "name", label: "Product", render: (r) => `<div><strong>${A.esc(r.name)}</strong></div><span class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(r.sku)}</span>` },
          { key: "titleRank", label: "Title Rank", render: (r) => A.titleRankBadge(r.titleRank) },
          { key: "payRank", label: "Pay Rank", render: (r) => A.payRankBadge(r.payRank) },
          { key: "activeRank", label: "Active Status", render: (r) => A.activeRankBadge(r.activeRank) },
          { key: "unitPrice", label: "Unit Price", num: true, render: (r) => A.fmtMoney(r.unitPrice) },
          { key: "units", label: "Units Sold", num: true, render: (r) => `<strong style="color:var(--text)">${A.fmtQty(r.units)}</strong>` },
          { key: "revenue", label: "Sales Revenue", num: true, render: (r) => `<strong style="color:var(--accent)">${A.fmtMoney(r.revenue)}</strong>` },
        ],
      });
    }

    renderView();
  };
})();

/* ============================================================
   Page: Categories (with Multi-Product Selection & Accordions)
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  async function catModal(cat) {
    const [products, stock, categories] = await Promise.all([
      SS.Repo.getAll("products"),
      SS.Repo.getAll("stock"),
      SS.Repo.getAll("categories"),
    ]);
    const catById = Object.fromEntries(categories.map((c) => [c.id, c]));

    const stockByProd = {};
    stock.forEach((s) => {
      stockByProd[s.productId] = (stockByProd[s.productId] || 0) + s.quantity;
    });

    // Track checked products in a Set
    const selectedProductIds = new Set(
      cat ? products.filter((p) => p.categoryId === cat.id).map((p) => p.id) : []
    );

    A.openModal({
      title: cat ? `Edit Category: ${cat.name}` : "Create New Product Category",
      wide: true,
      bodyHtml: `
        <form id="cat-form">
          <div class="field" style="margin-bottom:14px">
            <label for="c-name">Category Title <span style="color:var(--accent)">*</span></label>
            <input id="c-name" value="${A.esc(cat ? cat.name : "")}" required placeholder="e.g. Electrical & Cabling" />
          </div>

          <div class="divider"></div>

          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:8px">
            <div>
              <div style="font-weight:600;font-size:13.5px">Assign Products to this Category</div>
              <div class="field-hint">Select the catalog products that belong under this category.</div>
            </div>
            <span class="badge badge-draft" id="cat-sel-counter" style="font-size:12px;font-weight:700">0 products selected</span>
          </div>

          <div style="display:flex;gap:8px;margin-bottom:10px">
            <input type="search" id="cat-prod-search" class="toolbar-input" style="flex:1" placeholder="Filter by product title or SKU…" />
            <button type="button" class="btn btn-sm btn-ghost" id="cat-select-all">Select All</button>
            <button type="button" class="btn btn-sm btn-ghost" id="cat-deselect-all">Clear All</button>
          </div>

          <div class="cat-prod-list" id="cat-prod-list"></div>
          <div id="cat-error" style="margin-top:12px"></div>
        </form>
      `,
      footHtml: `
        <button class="btn btn-ghost" data-close>Cancel</button>
        <button class="btn btn-primary" id="cat-save">${cat ? "Save Category & Assignments" : "Create Category"}</button>
      `,
      onMount: (ov) => {
        const listEl = ov.querySelector("#cat-prod-list");
        const searchEl = ov.querySelector("#cat-prod-search");
        const counterEl = ov.querySelector("#cat-sel-counter");

        function updateCounter() {
          counterEl.textContent = `${selectedProductIds.size} of ${products.length} products selected`;
          counterEl.className = selectedProductIds.size > 0 ? "badge badge-ok" : "badge badge-draft";
        }

        function renderProductList(query = "") {
          const q = query.toLowerCase().trim();
          const filtered = products.filter((p) => !q || p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q));

          if (filtered.length === 0) {
            listEl.innerHTML = `<div style="padding:22px;text-align:center;color:var(--text-faint);font-size:12.5px">No products match "${A.esc(query)}".</div>`;
            return;
          }

          listEl.innerHTML = filtered.map((p) => {
            const isChecked = selectedProductIds.has(p.id);
            const currentCat = p.categoryId && p.categoryId !== (cat ? cat.id : null) ? catById[p.categoryId] : null;
            const currentStock = stockByProd[p.id] || 0;
            return `
              <label class="cat-prod-item ${isChecked ? "selected" : ""}" data-id="${p.id}">
                <input type="checkbox" value="${p.id}" ${isChecked ? "checked" : ""} />
                <div class="cat-prod-info">
                  <div class="cat-prod-name">${A.esc(p.name)}</div>
                  <div class="cat-prod-sub">
                    <span class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(p.sku)}</span>
                    ${currentCat ? `<span class="badge badge-role" style="font-size:10px">In: ${A.esc(currentCat.name)}</span>` : ""}
                  </div>
                </div>
                <div class="cat-prod-stock">
                  <span class="mono" style="font-weight:600">${A.fmtQty(currentStock, p.unit)}</span>
                </div>
              </label>
            `;
          }).join("");

          listEl.querySelectorAll("input[type='checkbox']").forEach((cb) => {
            cb.addEventListener("change", (e) => {
              if (e.target.checked) {
                selectedProductIds.add(cb.value);
              } else {
                selectedProductIds.delete(cb.value);
              }
              cb.closest(".cat-prod-item").classList.toggle("selected", e.target.checked);
              updateCounter();
            });
          });
        }

        searchEl.addEventListener("input", (e) => renderProductList(e.target.value));

        ov.querySelector("#cat-select-all").addEventListener("click", () => {
          const q = searchEl.value.toLowerCase().trim();
          products.forEach((p) => {
            if (!q || p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q)) {
              selectedProductIds.add(p.id);
            }
          });
          renderProductList(searchEl.value);
          updateCounter();
        });

        ov.querySelector("#cat-deselect-all").addEventListener("click", () => {
          selectedProductIds.clear();
          renderProductList(searchEl.value);
          updateCounter();
        });

        renderProductList();
        updateCounter();

        ov.querySelector("#cat-save").addEventListener("click", async () => {
          const name = ov.querySelector("#c-name").value.trim();
          const errBox = ov.querySelector("#cat-error");
          errBox.innerHTML = "";
          if (!name) {
            errBox.innerHTML = `<div class="error-banner">Category Title is required.</div>`;
            return;
          }

          const catId = cat ? cat.id : SS.uid("cat");
          const rec = { id: catId, name };
          await SS.Repo.put("categories", rec);

          // Update product category pointers
          for (const p of products) {
            if (selectedProductIds.has(p.id)) {
              if (p.categoryId !== catId) {
                p.categoryId = catId;
                await SS.Repo.put("products", p);
              }
            } else if (p.categoryId === catId) {
              p.categoryId = null;
              await SS.Repo.put("products", p);
            }
          }

          A.toast(`Category saved with ${selectedProductIds.size} products assigned`, "info");
          A.closeModal();
          A.navigate("categories");
        });
      },
    });
  }

  A.PAGE_RENDERERS.categories = async function (mount) {
    const [categories, products, stock, rules] = await Promise.all([
      SS.Repo.getAll("categories"),
      SS.Repo.getAll("products"),
      SS.Repo.getAll("stock"),
      SS.Repo.getAll("reorderRules"),
    ]);

    const stockByProd = {};
    stock.forEach((s) => {
      stockByProd[s.productId] = (stockByProd[s.productId] || 0) + s.quantity;
    });

    // Group products by category
    const prodsByCat = {};
    const uncategorized = [];
    products.forEach((p) => {
      if (p.categoryId) {
        prodsByCat[p.categoryId] = prodsByCat[p.categoryId] || [];
        prodsByCat[p.categoryId].push(p);
      } else {
        uncategorized.push(p);
      }
    });

    mount.innerHTML = `
      <div class="page-header">
        <div>
          <div class="page-title">Product Categories & Taxonomy</div>
          <div class="page-sub">${categories.length} categories organizing ${products.length} products. Click any section to expand/collapse.</div>
        </div>
        <button class="btn btn-primary" id="new-cat">+ Add Category</button>
      </div>

      <div class="table-toolbar" style="margin-bottom:16px">
        <input class="toolbar-input" id="cat-search-filter" type="search" placeholder="Search categories or contained products…" style="max-width:360px" />
        <button class="btn btn-sm btn-ghost" id="cat-expand-all">Expand All</button>
        <button class="btn btn-sm btn-ghost" id="cat-collapse-all">Collapse All</button>
      </div>

      <div id="cat-accordion-list"></div>
    `;

    const list = mount.querySelector("#cat-accordion-list");

    function renderAccordions(filterText = "") {
      const q = filterText.toLowerCase().trim();

      const filteredCategories = categories.filter((c) => {
        if (!q) return true;
        if (c.name.toLowerCase().includes(q)) return true;
        const linked = prodsByCat[c.id] || [];
        return linked.some((p) => p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q));
      });

      if (filteredCategories.length === 0 && (!q || !uncategorized.some((p) => p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q)))) {
        list.innerHTML = `
          <div class="panel">
            <div class="empty-state">
              <div class="em-icon">${A.ICONS.categories}</div>
              <div class="em-title">No categories found</div>
              <div class="em-sub">Create your first category or change your filter.</div>
            </div>
          </div>`;
        return;
      }

      let html = filteredCategories.map((c, idx) => {
        const prods = prodsByCat[c.id] || [];
        const totalUnits = prods.reduce((sum, p) => sum + (stockByProd[p.id] || 0), 0);
        const isOpen = idx === 0 || q.length > 0;

        return `
          <div class="accordion-card ${isOpen ? "open" : ""}" data-cat-id="${c.id}">
            <div class="accordion-head">
              <div style="display:flex;align-items:center;gap:12px;flex:1;min-width:0">
                <span style="color:var(--accent);display:flex;align-items:center">${A.ICONS.categories}</span>
                <div>
                  <div style="font-weight:700;font-size:14.5px;color:var(--text)">${A.esc(c.name)}</div>
                  <div class="field-hint" style="margin-top:1px">${prods.length} assigned products · ${A.fmtQty(totalUnits)} units on hand</div>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:8px" onclick="event.stopPropagation()">
                <button class="btn btn-sm btn-ghost" data-assign="${c.id}">Assign / Select Products (${prods.length})</button>
                <button class="btn btn-sm btn-danger" data-del="${c.id}" title="Delete Category">✕</button>
                <span class="accordion-chevron" style="cursor:pointer" onclick="this.closest('.accordion-card').classList.toggle('open')">▼</span>
              </div>
            </div>
            <div class="accordion-body">
              ${
                prods.length === 0
                  ? `<div style="text-align:center;padding:16px;color:var(--text-faint)">
                      No products assigned to <strong>${A.esc(c.name)}</strong> yet.
                      <div style="margin-top:8px"><button class="btn btn-sm btn-primary" data-assign="${c.id}">+ Select & Assign Products</button></div>
                    </div>`
                  : `<div class="cat-products-grid">
                      ${prods
                        .map((p) => {
                          const qty = stockByProd[p.id] || 0;
                          const rule = rules.find((r) => r.productId === p.id);
                          let badge = `<span class="badge badge-ok">In stock</span>`;
                          if (qty <= 0) badge = `<span class="badge badge-out">Out of stock</span>`;
                          else if (rule && qty <= rule.minQuantity) badge = `<span class="badge badge-low">Low</span>`;

                          return `
                            <div class="cat-prod-card">
                              <div style="min-width:0;flex:1">
                                <div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${A.esc(p.name)}</div>
                                <div class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(p.sku)}</div>
                              </div>
                              <div style="text-align:right;margin-left:8px;flex-shrink:0">
                                <div class="mono" style="font-weight:600;font-size:13px">${A.fmtQty(qty, p.unit)}</div>
                                <div style="margin-top:2px">${badge}</div>
                              </div>
                            </div>
                          `;
                        })
                        .join("")}
                    </div>`
              }
            </div>
          </div>
        `;
      }).join("");

      // Uncategorized products section
      if (uncategorized.length > 0) {
        html += `
          <div class="accordion-card open" style="border-color:rgba(245,158,11,0.35);margin-top:20px">
            <div class="accordion-head" style="background:rgba(245,158,11,0.04)">
              <div style="display:flex;align-items:center;gap:12px">
                <span class="badge badge-low" style="font-size:12px">!</span>
                <div>
                  <div style="font-weight:700;font-size:14px;color:var(--warn-text)">Uncategorized Products (${uncategorized.length})</div>
                  <div class="field-hint" style="color:var(--text-muted)">These products have not been assigned to any category yet.</div>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:8px">
                <span class="badge badge-draft">${uncategorized.length} unassigned items</span>
                <span class="accordion-chevron">▼</span>
              </div>
            </div>
            <div class="accordion-body">
              <div class="cat-products-grid">
                ${uncategorized
                  .map((p) => {
                    const qty = stockByProd[p.id] || 0;
                    return `
                      <div class="cat-prod-card" style="border-color:var(--border)">
                        <div style="min-width:0;flex:1">
                          <div style="font-weight:600;font-size:13px">${A.esc(p.name)}</div>
                          <div class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(p.sku)}</div>
                        </div>
                        <div style="text-align:right;margin-left:8px">
                          <div class="mono" style="font-weight:600;font-size:13px">${A.fmtQty(qty, p.unit)}</div>
                          <button class="btn btn-sm btn-ghost" data-quick-cat="${p.id}" style="margin-top:4px">Assign Category</button>
                        </div>
                      </div>
                    `;
                  })
                  .join("")}
              </div>
            </div>
          </div>
        `;
      }

      list.innerHTML = html;

      // Accordion toggle click handlers
      list.querySelectorAll(".accordion-head").forEach((head) => {
        head.addEventListener("click", () => {
          head.closest(".accordion-card").classList.toggle("open");
        });
      });

      // Assign / Edit buttons
      list.querySelectorAll("[data-assign]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const c = categories.find((x) => x.id === btn.dataset.assign);
          catModal(c);
        });
      });

      // Quick categorize single product
      list.querySelectorAll("[data-quick-cat]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const prod = products.find((x) => x.id === btn.dataset.quickCat);
          A.openModal({
            title: `Assign Category for ${prod.name}`,
            bodyHtml: `
              <div class="field">
                <label for="qc-select">Choose Destination Category</label>
                <select id="qc-select">
                  ${categories.map((c) => `<option value="${c.id}">${A.esc(c.name)}</option>`).join("")}
                </select>
              </div>
            `,
            footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="qc-save">Save Assignment</button>`,
            onMount: (ov) => {
              ov.querySelector("#qc-save").addEventListener("click", async () => {
                prod.categoryId = ov.querySelector("#qc-select").value;
                await SS.Repo.put("products", prod);
                A.toast(`Assigned ${prod.name} to category`, "info");
                A.closeModal();
                A.navigate("categories");
              });
            },
          });
        });
      });

      // Delete category
      list.querySelectorAll("[data-del]").forEach((btn) => {
        btn.addEventListener("click", () => {
          A.confirmDialog({
            title: "Delete category?",
            message: "Products assigned to this category will become uncategorized. Proceed?",
            confirmLabel: "Delete Category",
            danger: true,
            onConfirm: async () => {
              await SS.Repo.delete("categories", btn.dataset.del);
              const affected = products.filter((p) => p.categoryId === btn.dataset.del);
              for (const p of affected) await SS.Repo.put("products", { ...p, categoryId: null });
              A.toast("Category deleted", "info");
              A.navigate("categories");
            },
          });
        });
      });
    }

    renderAccordions();

    // Expand / Collapse All buttons
    mount.querySelector("#cat-expand-all").addEventListener("click", () => {
      list.querySelectorAll(".accordion-card").forEach((card) => card.classList.add("open"));
    });
    mount.querySelector("#cat-collapse-all").addEventListener("click", () => {
      list.querySelectorAll(".accordion-card").forEach((card) => card.classList.remove("open"));
    });

    // Search filter
    mount.querySelector("#cat-search-filter").addEventListener("input", (e) => {
      renderAccordions(e.target.value);
    });

    document.getElementById("new-cat").addEventListener("click", () => catModal(null));
  };
})();

/* ============================================================
   Page: Warehouses & Storage Locations (with Collapsible Dropdowns)
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.warehouses = async function (mount) {
    const [warehouses, locations, stock, products] = await Promise.all([
      SS.Repo.getAll("warehouses"), SS.Repo.getAll("locations"), SS.Repo.getAll("stock"), SS.Repo.getAll("products"),
    ]);
    const prodById = Object.fromEntries(products.map((p) => [p.id, p]));

    mount.innerHTML = `
      <div class="page-header">
        <div>
          <div class="page-title">Warehouses & Storage Facilities</div>
          <div class="page-sub">${warehouses.length} physical facilities and ${locations.length} storage bins holding system inventory.</div>
        </div>
        <button class="btn btn-primary" id="new-wh">+ Add Warehouse</button>
      </div>
      <div id="wh-list"></div>
    `;

    const list = mount.querySelector("#wh-list");
    if (warehouses.length === 0) {
      list.innerHTML = `<div class="panel"><div class="empty-state"><div class="em-icon">${A.ICONS.warehouses}</div><div class="em-title">No warehouses registered</div><div class="em-sub">Create your first facility to assign inventory locations.</div></div></div>`;
    } else {
      list.innerHTML = warehouses.map((w, idx) => {
        const locs = locations.filter((l) => l.warehouseId === w.id);
        const totalQty = stock.filter((s) => s.warehouseId === w.id).reduce((a, s) => a + s.quantity, 0);
        return `
          <div class="accordion-card open" data-wh-id="${w.id}">
            <div class="accordion-head">
              <div style="display:flex;align-items:center;gap:12px;flex:1;min-width:0">
                <span style="color:var(--accent);display:flex;align-items:center">${A.ICONS.warehouses}</span>
                <div>
                  <div style="font-weight:700;font-size:15px;color:var(--text);display:flex;align-items:center;gap:8px">
                    ${A.esc(w.name)}
                    <span class="mono" style="color:var(--text-faint);font-size:11.5px">${A.esc(w.code || "")}</span>
                  </div>
                  <div class="field-hint" style="margin-top:2px">${A.esc(w.address || "No address specified")}</div>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:8px" onclick="event.stopPropagation()">
                <span class="badge badge-ok">${A.fmtQty(totalQty)} units stored</span>
                <span class="badge badge-draft">${locs.length} locations</span>
                <button class="btn btn-sm btn-ghost" data-add-loc="${w.id}">+ Add Location</button>
                <span class="accordion-chevron" style="cursor:pointer" onclick="this.closest('.accordion-card').classList.toggle('open')">▼</span>
              </div>
            </div>
            <div class="accordion-body">
              ${locs.length === 0
                ? `<div class="field-hint" style="padding:12px 0;text-align:center">No storage locations or aisles added to this warehouse yet.</div>`
                : `<div class="table-wrap">
                    <table class="data-table">
                      <thead><tr><th>Location / Bin</th><th>Stored Product SKUs</th><th style="text-align:right">Total Quantity</th></tr></thead>
                      <tbody>
                        ${locs.map((l) => {
                          const locStocks = stock.filter((s) => s.locationId === l.id && s.quantity > 0);
                          const q = locStocks.reduce((a, s) => a + s.quantity, 0);
                          const skuChips = locStocks.map((s) => {
                            const p = prodById[s.productId];
                            return `<span class="badge badge-draft" style="font-size:11px">${p ? p.name : s.productId}: ${A.fmtQty(s.quantity, p ? p.unit : "")}</span>`;
                          }).join(" ") || "<span style='color:var(--text-faint)'>Empty Bin</span>";

                          return `<tr>
                            <td style="font-weight:600">${A.esc(l.name)}</td>
                            <td><div style="display:flex;gap:4px;flex-wrap:wrap">${skuChips}</div></td>
                            <td class="num" style="text-align:right;font-weight:600">${A.fmtQty(q)}</td>
                          </tr>`;
                        }).join("")}
                      </tbody>
                    </table>
                  </div>`}
            </div>
          </div>
        `;
      }).join("");

      list.querySelectorAll(".accordion-head").forEach((head) => {
        head.addEventListener("click", () => {
          head.closest(".accordion-card").classList.toggle("open");
        });
      });
    }

    function whModal() {
      A.openModal({
        title: "Create Warehouse Facility",
        bodyHtml: `
          <div class="form-grid single">
            <div class="field"><label for="w-name">Facility Name</label><input id="w-name" required placeholder="e.g. Central Distribution Center" /></div>
            <div class="field"><label for="w-code">Code / Identifier</label><input id="w-code" placeholder="e.g. WH-CENTRAL" /></div>
            <div class="field"><label for="w-addr">Address / Location</label><input id="w-addr" placeholder="e.g. 100 Logistics Blvd, Gate 4" /></div>
          </div>
          <div id="wh-error" style="margin-top:10px"></div>`,
        footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="wh-save">Save Facility</button>`,
        onMount: (ov) => {
          ov.querySelector("#wh-save").addEventListener("click", async () => {
            const name = ov.querySelector("#w-name").value.trim();
            if (!name) { ov.querySelector("#wh-error").innerHTML = `<div class="error-banner">Warehouse name is required.</div>`; return; }
            await SS.Repo.put("warehouses", { id: SS.uid("wh"), name, code: ov.querySelector("#w-code").value.trim(), address: ov.querySelector("#w-addr").value.trim() });
            A.toast("Warehouse created", "info");
            A.closeModal();
            A.navigate("warehouses");
          });
        },
      });
    }

    function locModal(warehouseId) {
      A.openModal({
        title: "Add Storage Location / Bin",
        bodyHtml: `<div class="field"><label for="l-name">Location / Bin Name</label><input id="l-name" placeholder="e.g. Aisle 3 – Shelf B" required /></div><div id="loc-error" style="margin-top:10px"></div>`,
        footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="loc-save">Create Location</button>`,
        onMount: (ov) => {
          ov.querySelector("#loc-save").addEventListener("click", async () => {
            const name = ov.querySelector("#l-name").value.trim();
            if (!name) { ov.querySelector("#loc-error").innerHTML = `<div class="error-banner">Location name is required.</div>`; return; }
            await SS.Repo.put("locations", { id: SS.uid("loc"), warehouseId, name });
            A.toast("Storage location added", "info");
            A.closeModal();
            A.navigate("warehouses");
          });
        },
      });
    }

    document.getElementById("new-wh").addEventListener("click", whModal);
    mount.querySelectorAll("[data-add-loc]").forEach((b) => b.addEventListener("click", () => locModal(b.dataset.addLoc)));
  };
})();

/* ============================================================
   Shared Line Item Editor with Live Stock Availability
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  function lineEditor({ container, products, mode, getAvailableQty, onLineChange }) {
    let lines = [{ productId: "", quantity: "", countedQuantity: "" }];

    function render() {
      container.innerHTML = `
        <div class="line-items">
          <div class="line-item-row head">
            <div>Product SKU & Description</div>
            <div>${mode === "count" ? "System Qty" : "Quantity"}</div>
            <div>${mode === "count" ? "Counted Qty" : "Availability"}</div>
            <div></div>
          </div>
          ${lines.map((l, i) => {
            const avail = l.productId && getAvailableQty ? getAvailableQty(l.productId) : null;
            const isExceeded = mode !== "count" && avail !== null && Number(l.quantity) > avail;

            return `<div class="line-item-row" data-idx="${i}">
              <div>
                <select data-f="productId">
                  <option value="">Select product SKU…</option>
                  ${products.map((p) => `<option value="${p.id}" ${l.productId === p.id ? "selected" : ""}>${A.esc(p.name)} (${A.esc(p.sku)})</option>`).join("")}
                </select>
                ${avail !== null ? `<div class="stock-feedback ${isExceeded ? "insufficient" : ""}">
                  ${mode === "count" ? `On file: ${A.fmtQty(avail)}` : `Available in loc: ${A.fmtQty(avail)}${isExceeded ? " (Insufficient!)" : ""}`}
                </div>` : ""}
              </div>
              ${mode === "count"
                ? `<input class="mono" value="${avail !== null ? A.fmtQty(avail) : "—"}" disabled />
                   <input data-f="countedQuantity" type="number" min="0" step="any" value="${l.countedQuantity != null ? l.countedQuantity : ""}" placeholder="Counted" />`
                : `<input data-f="quantity" type="number" min="0.01" step="any" value="${l.quantity}" placeholder="Qty" />
                   <div style="font-size:12px;color:var(--text-faint)">${avail !== null ? A.fmtQty(avail) : "—"}</div>`
              }
              <button type="button" class="btn btn-ghost btn-sm" data-remove="${i}" aria-label="Remove line">✕</button>
            </div>`;
          }).join("")}
        </div>
        <button type="button" class="btn btn-ghost btn-sm" id="add-line" style="margin-top:10px">+ Add Line Item</button>
      `;

      container.querySelectorAll("[data-f]").forEach((el) => {
        el.addEventListener("input", (e) => {
          const idx = Number(el.closest("[data-idx]").dataset.idx);
          lines[idx][el.dataset.f] = e.target.value;
          if (el.dataset.f === "productId") render();
          if (onLineChange) onLineChange(lines);
        });
      });

      container.querySelectorAll("[data-remove]").forEach((btn) => {
        btn.addEventListener("click", () => {
          lines.splice(Number(btn.dataset.remove), 1);
          if (lines.length === 0) lines.push({ productId: "", quantity: "", countedQuantity: "" });
          render();
          if (onLineChange) onLineChange(lines);
        });
      });

      const addBtn = container.querySelector("#add-line");
      if (addBtn) addBtn.addEventListener("click", () => {
        lines.push({ productId: "", quantity: "", countedQuantity: "" });
        render();
      });
    }

    render();
    return {
      getLines: () => lines,
      refresh: () => render(),
      validate: () => {
        const clean = lines.filter((l) => l.productId);
        if (clean.length === 0) return { error: "Please add at least one line item." };
        for (const l of clean) {
          if (mode === "count") {
            if (l.countedQuantity === undefined || l.countedQuantity === "" || isNaN(Number(l.countedQuantity)) || Number(l.countedQuantity) < 0)
              return { error: "Enter a valid counted quantity (>= 0) for every line." };
          } else {
            if (!l.quantity || isNaN(Number(l.quantity)) || Number(l.quantity) <= 0)
              return { error: "Enter a valid quantity greater than zero for every line." };
          }
        }
        return { lines: clean };
      },
    };
  }

  A.lineEditor = lineEditor;
})();

/* ============================================================
   Page: Receipts (Incoming Stock)
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.receipts = async function (mount) {
    const [receipts, products, warehouses, locations, stock] = await Promise.all([
      SS.Repo.getAll("receipts"), SS.Repo.getAll("products"), SS.Repo.getAll("warehouses"), SS.Repo.getAll("locations"), SS.Repo.getAll("stock"),
    ]);
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));
    const locById = Object.fromEntries(locations.map((l) => [l.id, l]));

    mount.innerHTML = `
      <div class="page-header">
        <div><div class="page-title">Incoming Stock Receipts</div><div class="page-sub">Receive shipments from vendors and suppliers into storage.</div></div>
        <button class="btn btn-primary" id="new-receipt">+ Create Receipt</button>
      </div>
      <div class="panel"><div id="receipts-table"></div></div>
    `;

    const rows = receipts
      .slice()
      .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
      .map((r) => ({
        ...r,
        whName: whById[r.warehouseId]?.name || "—",
        locName: locById[r.locationId]?.name || "—",
        lineSummary: r.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.quantity})`).join(", "),
        totalQty: r.lines.reduce((a, l) => a + Number(l.quantity), 0),
      }));

    function handleAction(action, r) {
      if (action === "validate") {
        const diffRows = r.lines.map((l) => {
          const p = productById[l.productId];
          const row = stock.find((s) => s.productId === l.productId && s.locationId === r.locationId);
          const before = row ? row.quantity : 0;
          return { label: p ? p.name : l.productId, value: `${A.fmtQty(before)} → ${A.fmtQty(before + Number(l.quantity))}` };
        });
        A.confirmDialog({
          title: "Validate this receipt?",
          message: "Stock at destination location will be incremented and an official ledger entry created.",
          diffRows,
          confirmLabel: "Validate Receipt",
          onConfirm: async () => {
            await SS.StockEngine.validateReceipt(r.id, A.state.user.id);
            A.toast("Receipt validated — stock updated", "info");
            A.closeModal();
            A.navigate("receipts");
          },
        });
      } else if (action === "cancel") {
        A.confirmDialog({
          title: "Cancel this receipt?",
          message: "The receipt will be marked cancelled. Stock is unaffected.",
          confirmLabel: "Cancel Receipt",
          danger: true,
          onConfirm: async () => {
            await SS.StockEngine.cancelReceipt(r.id, A.state.user.id);
            A.toast("Receipt cancelled", "info");
            A.closeModal();
            A.navigate("receipts");
          },
        });
      }
    }

    A.dataTable({
      mount: mount.querySelector("#receipts-table"),
      rows,
      rowKey: "id",
      searchKeys: ["supplier", "id", "lineSummary"],
      filters: [{ key: "status", label: "Status", options: [{ value: "draft", label: "Draft" }, { value: "validated", label: "Validated" }, { value: "cancelled", label: "Cancelled" }] }],
      columns: [
        { key: "id", label: "Ref", render: (r) => `<span class="mono" style="font-weight:600">${A.esc(r.id)}</span>` },
        { key: "supplier", label: "Vendor / Supplier", render: (r) => A.esc(r.supplier || "—") },
        { key: "whName", label: "Warehouse" },
        { key: "locName", label: "Destination Location" },
        { key: "totalQty", label: "Total Units", num: true, render: (r) => A.fmtQty(r.totalQty) },
        { key: "dueDate", label: "Scheduled Due & SLA", render: (r) => {
          const due = A.calcDueStatus(r.dueDate || r.createdAt?.split("T")[0], r.status, r.validatedAt);
          return `<div><span class="mono" style="font-weight:600">${due.formattedDate}</span></div><span class="badge ${due.badgeClass}" style="font-size:10.5px">${due.label}</span>`;
        }},
        { key: "status", label: "Status", render: (r) => A.statusBadge(r.status) },
      ],
      onRowClick: (id) => {
        const r = receipts.find((x) => x.id === id);
        A.viewDocumentModal({ type: "Receipt", doc: r, productById, locById, whById, onAction: handleAction });
      },
      rowActions: (r) => r.status === "draft"
        ? `<button class="btn btn-sm btn-primary" data-validate="${r.id}">Validate</button><button class="btn btn-sm btn-ghost" data-cancel="${r.id}">Cancel</button>`
        : `<button class="btn btn-sm btn-ghost" data-view="${r.id}">${A.ICONS.eye} View</button>`,
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.receipts}</div><div class="em-title">No receipts registered</div><div class="em-sub">Create a receipt to bring supplier stock into the warehouse.</div></div>`,
    });

    mount.querySelectorAll("[data-validate]").forEach((btn) => btn.addEventListener("click", () => {
      const r = receipts.find((x) => x.id === btn.dataset.validate);
      handleAction("validate", r);
    }));
    mount.querySelectorAll("[data-cancel]").forEach((btn) => btn.addEventListener("click", () => {
      const r = receipts.find((x) => x.id === btn.dataset.cancel);
      handleAction("cancel", r);
    }));
    mount.querySelectorAll("[data-view]").forEach((btn) => btn.addEventListener("click", () => {
      const r = receipts.find((x) => x.id === btn.dataset.view);
      A.viewDocumentModal({ type: "Receipt", doc: r, productById, locById, whById, onAction: handleAction });
    }));

    document.getElementById("new-receipt").addEventListener("click", () => {
      let editor;
      A.openModal({
        title: "Create Incoming Stock Receipt",
        wide: true,
        bodyHtml: `
          <form id="receipt-form">
            <div class="form-grid">
              <div class="field"><label for="r-supplier">Supplier Name</label><input id="r-supplier" required placeholder="e.g. Anand Metals Pvt Ltd" /></div>
              <div class="field"><label for="r-due">Expected Arrival / Due Date</label><input type="date" id="r-due" required value="${A.dateInputDefault(5)}" /></div>
              <div class="field"><label for="r-wh">Target Warehouse</label><select id="r-wh">${warehouses.map((w) => `<option value="${w.id}">${A.esc(w.name)}</option>`).join("")}</select></div>
              <div class="field"><label for="r-loc">Destination Location / Bin</label><select id="r-loc"></select></div>
            </div>
            <div class="divider"></div>
            <div class="panel-title" style="font-size:13.5px">Receipt Lines</div>
            <div id="line-editor-mount"></div>
            <div id="receipt-error" style="margin-top:10px"></div>
          </form>
        `,
        footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="receipt-save">Save as Draft</button>`,
        onMount: (ov2) => {
          function refreshLocations() {
            const whId = ov2.querySelector("#r-wh").value;
            const locs = locations.filter((l) => l.warehouseId === whId);
            ov2.querySelector("#r-loc").innerHTML = locs.map((l) => `<option value="${l.id}">${A.esc(l.name)}</option>`).join("");
          }
          ov2.querySelector("#r-wh").addEventListener("change", refreshLocations);
          refreshLocations();

          editor = A.lineEditor({
            container: ov2.querySelector("#line-editor-mount"),
            products,
            mode: "qty",
          });

          ov2.querySelector("#receipt-save").addEventListener("click", async () => {
            const errBox = ov2.querySelector("#receipt-error");
            errBox.innerHTML = "";
            const result = editor.validate();
            if (result.error) { errBox.innerHTML = `<div class="error-banner">${A.esc(result.error)}</div>`; return; }
            const rec = {
              id: SS.uid("rcpt"),
              supplier: ov2.querySelector("#r-supplier").value.trim() || "Standard Intake",
              warehouseId: ov2.querySelector("#r-wh").value,
              locationId: ov2.querySelector("#r-loc").value,
              status: "draft",
              createdAt: SS.now(),
              dueDate: ov2.querySelector("#r-due") ? ov2.querySelector("#r-due").value : A.dateInputDefault(5),
              lines: result.lines.map((l) => ({ productId: l.productId, quantity: Number(l.quantity) })),
            };
            await SS.Repo.put("receipts", rec);
            A.toast("Receipt created as draft with scheduled due date", "info");
            A.closeModal();
            A.navigate("receipts");
          });
        },
      });
    });
  };
})();

/* ============================================================
   Page: Deliveries (Outgoing Stock)
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.deliveries = async function (mount) {
    const [deliveries, products, warehouses, locations, stock] = await Promise.all([
      SS.Repo.getAll("deliveries"), SS.Repo.getAll("products"), SS.Repo.getAll("warehouses"), SS.Repo.getAll("locations"), SS.Repo.getAll("stock"),
    ]);
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));
    const locById = Object.fromEntries(locations.map((l) => [l.id, l]));

    mount.innerHTML = `
      <div class="page-header">
        <div><div class="page-title">Customer Deliveries</div><div class="page-sub">Outbound shipments dispatched to customers.</div></div>
        <button class="btn btn-primary" id="new-delivery">+ Create Delivery</button>
      </div>
      <div class="panel"><div id="deliveries-table"></div></div>
    `;

    const rows = deliveries
      .slice()
      .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
      .map((d) => ({
        ...d,
        whName: whById[d.warehouseId]?.name || "—",
        locName: locById[d.locationId]?.name || "—",
        lineSummary: d.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.quantity})`).join(", "),
        totalQty: d.lines.reduce((a, l) => a + Number(l.quantity), 0),
      }));

    function handleAction(action, d) {
      if (action === "validate") {
        const diffRows = [];
        let insufficient = null;
        for (const l of d.lines) {
          const p = productById[l.productId];
          const row = stock.find((s) => s.productId === l.productId && s.locationId === d.locationId);
          const before = row ? row.quantity : 0;
          if (before < Number(l.quantity)) insufficient = `${p ? p.name : l.productId}: Available ${A.fmtQty(before)}, requested ${A.fmtQty(l.quantity)}`;
          diffRows.push({ label: p ? p.name : l.productId, value: `${A.fmtQty(before)} → ${A.fmtQty(before - Number(l.quantity))}` });
        }
        if (insufficient) {
          A.toast("Cannot validate: " + insufficient, "error");
          return;
        }
        A.confirmDialog({
          title: "Validate and dispatch delivery?",
          message: "Stock will be deducted from source location and an outbound ledger entry generated.",
          diffRows,
          confirmLabel: "Dispatch Delivery",
          onConfirm: async () => {
            await SS.StockEngine.validateDelivery(d.id, A.state.user.id);
            A.toast("Delivery validated — stock deducted", "info");
            A.closeModal();
            A.navigate("deliveries");
          },
        });
      } else if (action === "cancel") {
        A.confirmDialog({
          title: "Cancel this delivery?",
          message: "The delivery order will be marked cancelled. Stock is unchanged.",
          confirmLabel: "Cancel Delivery",
          danger: true,
          onConfirm: async () => {
            await SS.StockEngine.cancelDelivery(d.id, A.state.user.id);
            A.toast("Delivery cancelled", "info");
            A.closeModal();
            A.navigate("deliveries");
          },
        });
      }
    }

    A.dataTable({
      mount: mount.querySelector("#deliveries-table"),
      rows,
      rowKey: "id",
      searchKeys: ["customer", "id", "lineSummary"],
      filters: [{ key: "status", label: "Status", options: [{ value: "draft", label: "Draft" }, { value: "validated", label: "Validated" }, { value: "cancelled", label: "Cancelled" }] }],
      columns: [
        { key: "id", label: "Ref", render: (r) => `<span class="mono" style="font-weight:600">${A.esc(r.id)}</span>` },
        { key: "customer", label: "Customer / Recipient", render: (r) => A.esc(r.customer || "—") },
        { key: "whName", label: "Warehouse" },
        { key: "locName", label: "Source Location" },
        { key: "totalQty", label: "Total Units", num: true, render: (r) => A.fmtQty(r.totalQty) },
        { key: "dueDate", label: "Dispatch Due & SLA", render: (d) => {
          const due = A.calcDueStatus(d.dueDate || d.createdAt?.split("T")[0], d.status, d.validatedAt);
          return `<div><span class="mono" style="font-weight:600">${due.formattedDate}</span></div><span class="badge ${due.badgeClass}" style="font-size:10.5px">${due.label}</span>`;
        }},
        { key: "status", label: "Status", render: (r) => A.statusBadge(r.status) },
      ],
      onRowClick: (id) => {
        const d = deliveries.find((x) => x.id === id);
        A.viewDocumentModal({ type: "Delivery", doc: d, productById, locById, whById, onAction: handleAction });
      },
      rowActions: (r) => r.status === "draft"
        ? `<button class="btn btn-sm btn-primary" data-validate="${r.id}">Validate</button><button class="btn btn-sm btn-ghost" data-cancel="${r.id}">Cancel</button>`
        : `<button class="btn btn-sm btn-ghost" data-view="${r.id}">${A.ICONS.eye} View</button>`,
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.deliveries}</div><div class="em-title">No deliveries registered</div><div class="em-sub">Create a delivery order to fulfill customer requests.</div></div>`,
    });

    mount.querySelectorAll("[data-validate]").forEach((btn) => btn.addEventListener("click", () => {
      const d = deliveries.find((x) => x.id === btn.dataset.validate);
      handleAction("validate", d);
    }));
    mount.querySelectorAll("[data-cancel]").forEach((btn) => btn.addEventListener("click", () => {
      const d = deliveries.find((x) => x.id === btn.dataset.cancel);
      handleAction("cancel", d);
    }));
    mount.querySelectorAll("[data-view]").forEach((btn) => btn.addEventListener("click", () => {
      const d = deliveries.find((x) => x.id === btn.dataset.view);
      A.viewDocumentModal({ type: "Delivery", doc: d, productById, locById, whById, onAction: handleAction });
    }));

    document.getElementById("new-delivery").addEventListener("click", () => {
      let editor;
      A.openModal({
        title: "Create Customer Delivery Order",
        wide: true,
        bodyHtml: `
          <form id="delivery-form">
            <div class="form-grid">
              <div class="field"><label for="d-customer">Customer Account</label><input id="d-customer" required placeholder="e.g. BuildRight Constructions" /></div>
              <div class="field"><label for="d-due">Fulfillment / Dispatch Due Date</label><input type="date" id="d-due" required value="${A.dateInputDefault(2)}" /></div>
              <div class="field"><label for="d-wh">Source Warehouse</label><select id="d-wh">${warehouses.map((w) => `<option value="${w.id}">${A.esc(w.name)}</option>`).join("")}</select></div>
              <div class="field"><label for="d-loc">Source Storage Location</label><select id="d-loc"></select></div>
            </div>
            <div class="divider"></div>
            <div class="panel-title" style="font-size:13.5px">Outbound Line Items</div>
            <div id="line-editor-mount"></div>
            <div id="delivery-error" style="margin-top:10px"></div>
          </form>
        `,
        footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="delivery-save">Save Delivery Draft</button>`,
        onMount: (ov2) => {
          function getLocId() { return ov2.querySelector("#d-loc").value; }

          function refreshLocations() {
            const whId = ov2.querySelector("#d-wh").value;
            const locs = locations.filter((l) => l.warehouseId === whId);
            ov2.querySelector("#d-loc").innerHTML = locs.map((l) => `<option value="${l.id}">${A.esc(l.name)}</option>`).join("");
            if (editor) editor.refresh();
          }

          ov2.querySelector("#d-wh").addEventListener("change", refreshLocations);
          ov2.querySelector("#d-loc").addEventListener("change", () => editor && editor.refresh());
          refreshLocations();

          editor = A.lineEditor({
            container: ov2.querySelector("#line-editor-mount"),
            products,
            mode: "qty",
            getAvailableQty: (productId) => {
              const locId = getLocId();
              const row = stock.find((s) => s.productId === productId && s.locationId === locId);
              return row ? row.quantity : 0;
            },
          });

          ov2.querySelector("#delivery-save").addEventListener("click", async () => {
            const errBox = ov2.querySelector("#delivery-error");
            errBox.innerHTML = "";
            const result = editor.validate();
            if (result.error) { errBox.innerHTML = `<div class="error-banner">${A.esc(result.error)}</div>`; return; }
            const rec = {
              id: SS.uid("dlv"),
              customer: ov2.querySelector("#d-customer").value.trim() || "Direct Dispatch",
              warehouseId: ov2.querySelector("#d-wh").value,
              locationId: ov2.querySelector("#d-loc").value,
              status: "draft",
              createdAt: SS.now(),
              dueDate: ov2.querySelector("#d-due") ? ov2.querySelector("#d-due").value : A.dateInputDefault(2),
              lines: result.lines.map((l) => ({ productId: l.productId, quantity: Number(l.quantity) })),
            };
            await SS.Repo.put("deliveries", rec);
            A.toast("Delivery order saved with dispatch due date", "info");
            A.closeModal();
            A.navigate("deliveries");
          });
        },
      });
    });
  };
})();

/* ============================================================
   Page: Internal Transfers
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.transfers = async function (mount) {
    const [transfers, products, warehouses, locations, stock] = await Promise.all([
      SS.Repo.getAll("transfers"), SS.Repo.getAll("products"), SS.Repo.getAll("warehouses"), SS.Repo.getAll("locations"), SS.Repo.getAll("stock"),
    ]);
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const locById = Object.fromEntries(locations.map((l) => [l.id, l]));
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));

    mount.innerHTML = `
      <div class="page-header">
        <div><div class="page-title">Internal Stock Transfers</div><div class="page-sub">Relocate stock between warehouses or bins without changing aggregate system totals.</div></div>
        <button class="btn btn-primary" id="new-transfer">+ Create Transfer</button>
      </div>
      <div class="panel"><div id="transfers-table"></div></div>
    `;

    const rows = transfers
      .slice()
      .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
      .map((t) => ({
        ...t,
        route: `${locById[t.sourceLocationId]?.name || "—"} → ${locById[t.destLocationId]?.name || "—"}`,
        lineSummary: t.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.quantity})`).join(", "),
        totalQty: t.lines.reduce((a, l) => a + Number(l.quantity), 0),
      }));

    function handleAction(action, t) {
      if (action === "validate") {
        A.confirmDialog({
          title: "Validate and complete transfer?",
          message: "Stock will move from the source bin to the destination bin. System-wide inventory totals remain invariant.",
          diffRows: t.lines.map((l) => ({ label: productById[l.productId]?.name || l.productId, value: `${A.fmtQty(l.quantity)} units` })),
          confirmLabel: "Execute Transfer",
          onConfirm: async () => {
            await SS.StockEngine.validateTransfer(t.id, A.state.user.id);
            A.toast("Transfer executed — stock moved", "info");
            A.closeModal();
            A.navigate("transfers");
          },
        });
      } else if (action === "cancel") {
        A.confirmDialog({
          title: "Cancel this transfer?",
          message: "The transfer order will be marked cancelled. Stock is unaffected.",
          confirmLabel: "Cancel Transfer",
          danger: true,
          onConfirm: async () => {
            await SS.StockEngine.cancelTransfer(t.id, A.state.user.id);
            A.toast("Transfer cancelled", "info");
            A.closeModal();
            A.navigate("transfers");
          },
        });
      }
    }

    A.dataTable({
      mount: mount.querySelector("#transfers-table"),
      rows,
      rowKey: "id",
      searchKeys: ["route", "id", "lineSummary"],
      filters: [{ key: "status", label: "Status", options: [{ value: "draft", label: "Draft" }, { value: "validated", label: "Validated" }, { value: "cancelled", label: "Cancelled" }] }],
      columns: [
        { key: "id", label: "Ref", render: (r) => `<span class="mono" style="font-weight:600">${A.esc(r.id)}</span>` },
        { key: "route", label: "Movement Route" },
        { key: "totalQty", label: "Units", num: true, render: (r) => A.fmtQty(r.totalQty) },
        { key: "dueDate", label: "Transit Due & SLA", render: (t) => {
          const due = A.calcDueStatus(t.dueDate || t.createdAt?.split("T")[0], t.status, t.validatedAt);
          return `<div><span class="mono" style="font-weight:600">${due.formattedDate}</span></div><span class="badge ${due.badgeClass}" style="font-size:10.5px">${due.label}</span>`;
        }},
        { key: "status", label: "Status", render: (r) => A.statusBadge(r.status) },
      ],
      onRowClick: (id) => {
        const t = transfers.find((x) => x.id === id);
        A.viewDocumentModal({ type: "Transfer", doc: t, productById, locById, whById, onAction: handleAction });
      },
      rowActions: (r) => r.status === "draft"
        ? `<button class="btn btn-sm btn-primary" data-validate="${r.id}">Validate</button><button class="btn btn-sm btn-ghost" data-cancel="${r.id}">Cancel</button>`
        : `<button class="btn btn-sm btn-ghost" data-view="${r.id}">${A.ICONS.eye} View</button>`,
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.transfers}</div><div class="em-title">No transfers registered</div><div class="em-sub">Create a transfer to shift stock between aisles or facilities.</div></div>`,
    });

    mount.querySelectorAll("[data-validate]").forEach((btn) => btn.addEventListener("click", () => {
      const t = transfers.find((x) => x.id === btn.dataset.validate);
      handleAction("validate", t);
    }));
    mount.querySelectorAll("[data-cancel]").forEach((btn) => btn.addEventListener("click", () => {
      const t = transfers.find((x) => x.id === btn.dataset.cancel);
      handleAction("cancel", t);
    }));
    mount.querySelectorAll("[data-view]").forEach((btn) => btn.addEventListener("click", () => {
      const t = transfers.find((x) => x.id === btn.dataset.view);
      A.viewDocumentModal({ type: "Transfer", doc: t, productById, locById, whById, onAction: handleAction });
    }));

    document.getElementById("new-transfer").addEventListener("click", () => {
      let editor;
      A.openModal({
        title: "Create Internal Transfer Order",
        wide: true,
        bodyHtml: `
          <form id="transfer-form">
            <div class="form-grid">
              <div class="field"><label for="t-swh">Source Warehouse</label><select id="t-swh">${warehouses.map((w) => `<option value="${w.id}">${A.esc(w.name)}</option>`).join("")}</select></div>
              <div class="field"><label for="t-sloc">Source Location</label><select id="t-sloc"></select></div>
              <div class="field"><label for="t-dwh">Destination Warehouse</label><select id="t-dwh">${warehouses.map((w) => `<option value="${w.id}">${A.esc(w.name)}</option>`).join("")}</select></div>
              <div class="field"><label for="t-dloc">Destination Location</label><select id="t-dloc"></select></div>
              <div class="field"><label for="t-due">Scheduled Transit Date</label><input type="date" id="t-due" required value="${A.dateInputDefault(1)}" /></div>
            </div>
            <div class="divider"></div>
            <div class="panel-title" style="font-size:13.5px">Transfer Lines</div>
            <div id="line-editor-mount"></div>
            <div id="transfer-error" style="margin-top:10px"></div>
          </form>
        `,
        footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="transfer-save">Save Transfer Draft</button>`,
        onMount: (ov2) => {
          function refresh(prefix) {
            const whId = ov2.querySelector(`#t-${prefix}wh`).value;
            const locs = locations.filter((l) => l.warehouseId === whId);
            ov2.querySelector(`#t-${prefix}loc`).innerHTML = locs.map((l) => `<option value="${l.id}">${A.esc(l.name)}</option>`).join("");
          }
          ov2.querySelector("#t-swh").addEventListener("change", () => { refresh("s"); editor && editor.refresh(); });
          ov2.querySelector("#t-sloc").addEventListener("change", () => editor && editor.refresh());
          ov2.querySelector("#t-dwh").addEventListener("change", () => refresh("d"));
          refresh("s"); refresh("d");

          editor = A.lineEditor({
            container: ov2.querySelector("#line-editor-mount"),
            products,
            mode: "qty",
            getAvailableQty: (productId) => {
              const locId = ov2.querySelector("#t-sloc").value;
              const row = stock.find((s) => s.productId === productId && s.locationId === locId);
              return row ? row.quantity : 0;
            },
          });

          ov2.querySelector("#transfer-save").addEventListener("click", async () => {
            const errBox = ov2.querySelector("#transfer-error");
            errBox.innerHTML = "";
            const result = editor.validate();
            if (result.error) { errBox.innerHTML = `<div class="error-banner">${A.esc(result.error)}</div>`; return; }
            const sourceLocationId = ov2.querySelector("#t-sloc").value;
            const destLocationId = ov2.querySelector("#t-dloc").value;
            if (sourceLocationId === destLocationId) {
              errBox.innerHTML = `<div class="error-banner">Source and destination locations must be distinct.</div>`;
              return;
            }
            const rec = {
              id: SS.uid("trf"),
              sourceWarehouseId: ov2.querySelector("#t-swh").value,
              sourceLocationId,
              destWarehouseId: ov2.querySelector("#t-dwh").value,
              destLocationId,
              status: "draft",
              createdAt: SS.now(),
              dueDate: ov2.querySelector("#t-due") ? ov2.querySelector("#t-due").value : A.dateInputDefault(1),
              lines: result.lines.map((l) => ({ productId: l.productId, quantity: Number(l.quantity) })),
            };
            await SS.Repo.put("transfers", rec);
            A.toast("Transfer saved with scheduled due date", "info");
            A.closeModal();
            A.navigate("transfers");
          });
        },
      });
    });
  };
})();

/* ============================================================
   Page: Scheduled Operations & Due Dates (Deadlines & SLA)
   Placed in between Transfers and Adjustments
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS["due-dates"] = async function (mount, params) {
    const [receipts, deliveries, transfers, adjustments, products, warehouses, locations] = await Promise.all([
      SS.Repo.getAll("receipts"),
      SS.Repo.getAll("deliveries"),
      SS.Repo.getAll("transfers"),
      SS.Repo.getAll("adjustments"),
      SS.Repo.getAll("products"),
      SS.Repo.getAll("warehouses"),
      SS.Repo.getAll("locations"),
    ]);

    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));
    const locById = Object.fromEntries(locations.map((l) => [l.id, l]));

    // Aggregate all scheduled operations
    const allOps = [];

    receipts.forEach((r) => {
      const dueInfo = A.calcDueStatus(r.dueDate || r.createdAt?.split("T")[0], r.status, r.validatedAt);
      allOps.push({
        id: r.id,
        rawDoc: r,
        type: "Receipt",
        typeKey: "receipt",
        typeIcon: A.ICONS.receipts,
        partner: r.supplier || "Vendor Shipment",
        route: `${whById[r.warehouseId]?.name || "—"} / ${locById[r.locationId]?.name || "—"}`,
        linesCount: r.lines.length,
        linesSummary: r.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.quantity})`).join(", "),
        dueDate: r.dueDate || r.createdAt?.split("T")[0],
        status: r.status,
        dueInfo,
        urgency: dueInfo.urgency,
        urgencyLabel: dueInfo.label,
        badgeClass: dueInfo.badgeClass,
        formattedDate: dueInfo.formattedDate,
      });
    });

    deliveries.forEach((d) => {
      const dueInfo = A.calcDueStatus(d.dueDate || d.createdAt?.split("T")[0], d.status, d.validatedAt);
      allOps.push({
        id: d.id,
        rawDoc: d,
        type: "Delivery",
        typeKey: "delivery",
        typeIcon: A.ICONS.deliveries,
        partner: d.customer || "Customer Order",
        route: `${whById[d.warehouseId]?.name || "—"} / ${locById[d.locationId]?.name || "—"}`,
        linesCount: d.lines.length,
        linesSummary: d.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.quantity})`).join(", "),
        dueDate: d.dueDate || d.createdAt?.split("T")[0],
        status: d.status,
        dueInfo,
        urgency: dueInfo.urgency,
        urgencyLabel: dueInfo.label,
        badgeClass: dueInfo.badgeClass,
        formattedDate: dueInfo.formattedDate,
      });
    });

    transfers.forEach((t) => {
      const dueInfo = A.calcDueStatus(t.dueDate || t.createdAt?.split("T")[0], t.status, t.validatedAt);
      allOps.push({
        id: t.id,
        rawDoc: t,
        type: "Transfer",
        typeKey: "transfer",
        typeIcon: A.ICONS.transfers,
        partner: "Internal Transit",
        route: `${locById[t.sourceLocationId]?.name || "—"} → ${locById[t.destLocationId]?.name || "—"}`,
        linesCount: t.lines.length,
        linesSummary: t.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.quantity})`).join(", "),
        dueDate: t.dueDate || t.createdAt?.split("T")[0],
        status: t.status,
        dueInfo,
        urgency: dueInfo.urgency,
        urgencyLabel: dueInfo.label,
        badgeClass: dueInfo.badgeClass,
        formattedDate: dueInfo.formattedDate,
      });
    });

    adjustments.forEach((a) => {
      const dueInfo = A.calcDueStatus(a.dueDate || a.createdAt?.split("T")[0], a.status, a.validatedAt);
      allOps.push({
        id: a.id,
        rawDoc: a,
        type: "Adjustment",
        typeKey: "adjustment",
        typeIcon: A.ICONS.adjustments,
        partner: a.reason || "Physical Audit",
        route: `${whById[a.warehouseId]?.name || "—"} / ${locById[a.locationId]?.name || "—"}`,
        linesCount: a.lines.length,
        linesSummary: a.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.countedQuantity})`).join(", "),
        dueDate: a.dueDate || a.createdAt?.split("T")[0],
        status: a.status,
        dueInfo,
        urgency: dueInfo.urgency,
        urgencyLabel: dueInfo.label,
        badgeClass: dueInfo.badgeClass,
        formattedDate: dueInfo.formattedDate,
      });
    });

    // Counts
    const overdueCount = allOps.filter((o) => o.urgency === "overdue" && o.status === "draft").length;
    const todayCount = allOps.filter((o) => o.urgency === "today" && o.status === "draft").length;
    const upcomingCount = allOps.filter((o) => (o.urgency === "upcoming" || o.urgency === "tomorrow") && o.status === "draft").length;
    const completedCount = allOps.filter((o) => o.status === "validated").length;

    mount.innerHTML = `
      <div class="page-header">
        <div>
          <div class="page-title">Scheduled Operations & Due Dates</div>
          <div class="page-sub">Centralized SLA management across customer shipments, vendor arrivals, and warehouse transfers.</div>
        </div>
        <div style="display:flex;gap:8px">
          <button class="btn btn-ghost" id="export-due-csv">${A.ICONS.download} Export Deadlines CSV</button>
          <a class="btn btn-primary" href="#/deliveries" data-route="deliveries">${A.ICONS.deliveries} New Delivery</a>
        </div>
      </div>

      <div class="grid-stats">
        <div class="stat-card" style="border-left:4px solid var(--out)">
          <div class="stat-top"><span class="stat-label">Overdue Operations</span><span class="stat-flag" style="background:var(--out)"></span></div>
          <div class="stat-value danger">${overdueCount}</div>
          <div class="stat-sub">Immediate fulfillment required</div>
        </div>
        <div class="stat-card" style="border-left:4px solid var(--warn)">
          <div class="stat-top"><span class="stat-label">Due Today</span><span class="stat-flag" style="background:var(--warn)"></span></div>
          <div class="stat-value warn">${todayCount}</div>
          <div class="stat-sub">Targeted for today's shift</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Upcoming This Week</span><span class="stat-flag" style="background:var(--accent)"></span></div>
          <div class="stat-value accent">${upcomingCount}</div>
          <div class="stat-sub">Scheduled within 7 days</div>
        </div>
        <div class="stat-card">
          <div class="stat-top"><span class="stat-label">Completed Orders</span><span class="stat-flag" style="background:var(--in)"></span></div>
          <div class="stat-value" style="color:var(--in)">${completedCount}</div>
          <div class="stat-sub">Validated & logged in ledger</div>
        </div>
      </div>

      <div class="filter-chips">
        <button class="chip active" data-due-filter="">All Scheduled (${allOps.length})</button>
        <button class="chip" data-due-filter="overdue">🚨 Overdue (${overdueCount})</button>
        <button class="chip" data-due-filter="today">⚡ Due Today (${todayCount})</button>
        <button class="chip" data-due-filter="upcoming">📅 Upcoming (${upcomingCount})</button>
        <button class="chip" data-due-filter="completed">✔️ Completed (${completedCount})</button>
      </div>

      <div class="panel">
        <div id="due-dates-table"></div>
      </div>
    `;

    mount.querySelector("#export-due-csv").addEventListener("click", () => {
      const headers = ["Reference ID", "Operation Type", "Partner / Source", "Route / Location", "Scheduled Due Date", "SLA Status", "Document Status", "Lines"];
      const csvRows = allOps.map((o) => [o.id, o.type, o.partner, o.route, o.dueDate || "", o.urgencyLabel, o.status, o.linesSummary]);
      A.exportCSV("stocksense_scheduled_deadlines.csv", headers, csvRows);
    });

    const dt = A.dataTable({
      mount: mount.querySelector("#due-dates-table"),
      rows: allOps.slice().sort((a, b) => {
        if (a.status === "draft" && b.status !== "draft") return -1;
        if (b.status === "draft" && a.status !== "draft") return 1;
        return new Date(a.dueDate || 0) - new Date(b.dueDate || 0);
      }),
      rowKey: "id",
      searchKeys: ["id", "partner", "route", "linesSummary", "type"],
      filters: [
        {
          key: "typeKey",
          label: "Operation Type",
          options: [
            { value: "delivery", label: "Deliveries (Outbound)" },
            { value: "receipt", label: "Receipts (Inbound)" },
            { value: "transfer", label: "Internal Transfers" },
            { value: "adjustment", label: "Stock Adjustments" },
          ],
        },
        {
          key: "status",
          label: "Status",
          options: [
            { value: "draft", label: "Draft / Pending" },
            { value: "validated", label: "Validated / Done" },
            { value: "cancelled", label: "Cancelled" },
          ],
        },
      ],
      columns: [
        {
          key: "id",
          label: "Document",
          render: (r) => `
            <div style="display:flex;align-items:center;gap:8px">
              <span style="color:var(--accent);display:flex">${r.typeIcon}</span>
              <div>
                <span class="mono" style="font-weight:700">${A.esc(r.id)}</span>
                <div style="font-size:11px;color:var(--text-faint)">${A.esc(r.type)}</div>
              </div>
            </div>`,
        },
        {
          key: "partner",
          label: "Partner / Destination",
          render: (r) => `<div><strong>${A.esc(r.partner)}</strong></div><div style="font-size:11.5px;color:var(--text-faint)">${A.esc(r.route)}</div>`,
        },
        {
          key: "formattedDate",
          label: "Scheduled Due Date",
          render: (r) => `<span class="mono" style="font-weight:600">${A.esc(r.formattedDate)}</span>`,
        },
        {
          key: "urgencyLabel",
          label: "SLA / Urgency",
          render: (r) => `<span class="badge ${r.badgeClass}">${A.esc(r.urgencyLabel)}</span>`,
        },
        {
          key: "status",
          label: "State",
          render: (r) => A.statusBadge(r.status),
        },
      ],
      onRowClick: (id) => {
        const item = allOps.find((x) => x.id === id);
        if (item) {
          A.viewDocumentModal({
            type: item.type,
            doc: item.rawDoc,
            productById,
            locById,
            whById,
            onAction: async (action, doc) => {
              if (action === "validate") {
                if (item.typeKey === "receipt") await SS.StockEngine.validateReceipt(doc.id, A.state.user.id);
                else if (item.typeKey === "delivery") await SS.StockEngine.validateDelivery(doc.id, A.state.user.id);
                else if (item.typeKey === "transfer") await SS.StockEngine.validateTransfer(doc.id, A.state.user.id);
                else if (item.typeKey === "adjustment") await SS.StockEngine.validateAdjustment(doc.id, A.state.user.id);
                A.toast(`${item.type} validated successfully`, "info");
                A.closeModal();
                A.navigate("due-dates");
              } else if (action === "cancel") {
                if (item.typeKey === "receipt") await SS.StockEngine.cancelReceipt(doc.id, A.state.user.id);
                else if (item.typeKey === "delivery") await SS.StockEngine.cancelDelivery(doc.id, A.state.user.id);
                else if (item.typeKey === "transfer") await SS.StockEngine.cancelTransfer(doc.id, A.state.user.id);
                A.toast(`${item.type} cancelled`, "info");
                A.closeModal();
                A.navigate("due-dates");
              }
            },
          });
        }
      },
      rowActions: (r) => `
        <button class="btn btn-sm btn-ghost" data-view-op="${r.id}">${A.ICONS.eye} View</button>
      `,
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.calendar}</div><div class="em-title">No scheduled operations found</div><div class="em-sub">All orders are up to date.</div></div>`,
    });

    mount.querySelectorAll(".chip").forEach((btn) => {
      btn.addEventListener("click", () => {
        mount.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.dataset.dueFilter;
        if (!filter) {
          dt.setRows(allOps);
        } else if (filter === "completed") {
          dt.setRows(allOps.filter((o) => o.status === "validated"));
        } else {
          dt.setRows(allOps.filter((o) => o.status === "draft" && (o.urgency === filter || (filter === "upcoming" && o.urgency === "tomorrow"))));
        }
      });
    });

    mount.querySelectorAll("[data-view-op]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = allOps.find((x) => x.id === btn.dataset.viewOp);
        if (item) {
          A.viewDocumentModal({
            type: item.type,
            doc: item.rawDoc,
            productById,
            locById,
            whById,
            onAction: async (action, doc) => {
              if (action === "validate") {
                if (item.typeKey === "receipt") await SS.StockEngine.validateReceipt(doc.id, A.state.user.id);
                else if (item.typeKey === "delivery") await SS.StockEngine.validateDelivery(doc.id, A.state.user.id);
                else if (item.typeKey === "transfer") await SS.StockEngine.validateTransfer(doc.id, A.state.user.id);
                else if (item.typeKey === "adjustment") await SS.StockEngine.validateAdjustment(doc.id, A.state.user.id);
                A.toast(`${item.type} validated`, "info");
                A.closeModal();
                A.navigate("due-dates");
              }
            },
          });
        }
      });
    });
  };
})();

/* ============================================================
   Page: Physical Inventory Adjustments
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.adjustments = async function (mount) {
    const [adjustments, products, warehouses, locations, stock] = await Promise.all([
      SS.Repo.getAll("adjustments"), SS.Repo.getAll("products"), SS.Repo.getAll("warehouses"), SS.Repo.getAll("locations"), SS.Repo.getAll("stock"),
    ]);
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));
    const locById = Object.fromEntries(locations.map((l) => [l.id, l]));

    mount.innerHTML = `
      <div class="page-header">
        <div><div class="page-title">Physical Inventory Adjustments</div><div class="page-sub">Reconcile counted physical inventory against system quantities.</div></div>
        <button class="btn btn-primary" id="new-adj">+ Record Physical Count</button>
      </div>
      <div class="panel"><div id="adj-table"></div></div>
    `;

    const rows = adjustments
      .slice()
      .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
      .map((a) => ({
        ...a,
        whName: whById[a.warehouseId]?.name || "—",
        locName: locById[a.locationId]?.name || "—",
        lineSummary: a.lines.map((l) => `${productById[l.productId]?.name || l.productId} (${l.countedQuantity})`).join(", "),
      }));

    function handleAction(action, a) {
      if (action === "validate") {
        const diffRows = a.lines.map((l) => {
          const p = productById[l.productId];
          const row = stock.find((s) => s.productId === l.productId && s.locationId === a.locationId);
          const sys = row ? row.quantity : 0;
          const diff = Number(l.countedQuantity) - sys;
          return { label: p ? p.name : l.productId, value: `${A.fmtQty(sys)} → ${A.fmtQty(l.countedQuantity)} (${diff >= 0 ? "+" : ""}${A.fmtQty(diff)})` };
        });
        A.confirmDialog({
          title: "Apply Inventory Reconciliation?",
          message: "System stock will be reconciled to the physical counted numbers and adjustments recorded in the ledger.",
          diffRows,
          confirmLabel: "Apply Adjustment",
          onConfirm: async () => {
            await SS.StockEngine.validateAdjustment(a.id, A.state.user.id);
            A.toast("Adjustment applied — inventory reconciled", "info");
            A.closeModal();
            A.navigate("adjustments");
          },
        });
      }
    }

    A.dataTable({
      mount: mount.querySelector("#adj-table"),
      rows,
      rowKey: "id",
      searchKeys: ["reason", "id", "lineSummary"],
      filters: [{ key: "status", label: "Status", options: [{ value: "draft", label: "Draft" }, { value: "validated", label: "Validated" }] }],
      columns: [
        { key: "id", label: "Ref", render: (r) => `<span class="mono" style="font-weight:600">${A.esc(r.id)}</span>` },
        { key: "reason", label: "Audit Reason", render: (r) => A.esc(r.reason || "Cycle Count") },
        { key: "whName", label: "Warehouse" },
        { key: "locName", label: "Location / Bin" },
        { key: "dueDate", label: "Scheduled Due & SLA", render: (a) => {
          const due = A.calcDueStatus(a.dueDate || a.createdAt?.split("T")[0], a.status, a.validatedAt);
          return `<div><span class="mono" style="font-weight:600">${due.formattedDate}</span></div><span class="badge ${due.badgeClass}" style="font-size:10.5px">${due.label}</span>`;
        }},
        { key: "status", label: "Status", render: (r) => A.statusBadge(r.status) },
        { key: "createdAt", label: "Date", render: (r) => A.fmtDate(r.createdAt) },
      ],
      onRowClick: (id) => {
        const a = adjustments.find((x) => x.id === id);
        A.viewDocumentModal({ type: "Adjustment", doc: a, productById, locById, whById, onAction: handleAction });
      },
      rowActions: (r) => r.status === "draft"
        ? `<button class="btn btn-sm btn-primary" data-validate="${r.id}">Apply Count</button>`
        : `<button class="btn btn-sm btn-ghost" data-view="${r.id}">${A.ICONS.eye} View</button>`,
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.adjustments}</div><div class="em-title">No adjustments recorded</div><div class="em-sub">Perform a physical cycle count to reconcile quantities.</div></div>`,
    });

    mount.querySelectorAll("[data-validate]").forEach((btn) => btn.addEventListener("click", () => {
      const a = adjustments.find((x) => x.id === btn.dataset.validate);
      handleAction("validate", a);
    }));
    mount.querySelectorAll("[data-view]").forEach((btn) => btn.addEventListener("click", () => {
      const a = adjustments.find((x) => x.id === btn.dataset.view);
      A.viewDocumentModal({ type: "Adjustment", doc: a, productById, locById, whById, onAction: handleAction });
    }));

    document.getElementById("new-adj").addEventListener("click", () => {
      let editor;
      A.openModal({
        title: "Record Physical Inventory Count",
        wide: true,
        bodyHtml: `
          <form id="adj-form">
            <div class="form-grid">
              <div class="field"><label for="a-reason">Audit / Adjustment Reason</label><input id="a-reason" required placeholder="e.g. Monthly Physical Count, Damage, Scrap" /></div>
              <div class="field"><label for="a-due">Scheduled Audit Date (SLA)</label><input id="a-due" type="date" value="${A.dateInputDefault(0)}" /></div>
              <div class="field"><label for="a-wh">Audited Warehouse</label><select id="a-wh">${warehouses.map((w) => `<option value="${w.id}">${A.esc(w.name)}</option>`).join("")}</select></div>
              <div class="field"><label for="a-loc">Audited Bin Location</label><select id="a-loc"></select></div>
            </div>
            <div class="divider"></div>
            <div class="panel-title" style="font-size:13.5px">Counted SKUs</div>
            <div id="line-editor-mount"></div>
            <div id="adj-error" style="margin-top:10px"></div>
          </form>
        `,
        footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="adj-save">Save Adjustment Draft</button>`,
        onMount: (ov2) => {
          function getLocId() { return ov2.querySelector("#a-loc").value; }

          function refreshLocations() {
            const whId = ov2.querySelector("#a-wh").value;
            const locs = locations.filter((l) => l.warehouseId === whId);
            ov2.querySelector("#a-loc").innerHTML = locs.map((l) => `<option value="${l.id}">${A.esc(l.name)}</option>`).join("");
            if (editor) editor.refresh();
          }

          ov2.querySelector("#a-wh").addEventListener("change", refreshLocations);
          ov2.querySelector("#a-loc").addEventListener("change", () => editor && editor.refresh());
          refreshLocations();

          editor = A.lineEditor({
            container: ov2.querySelector("#line-editor-mount"),
            products,
            mode: "count",
            getAvailableQty: (productId) => {
              const locId = getLocId();
              const row = stock.find((s) => s.productId === productId && s.locationId === locId);
              return row ? row.quantity : 0;
            },
          });

          ov2.querySelector("#adj-save").addEventListener("click", async () => {
            const errBox = ov2.querySelector("#adj-error");
            errBox.innerHTML = "";
            const result = editor.validate();
            if (result.error) { errBox.innerHTML = `<div class="error-banner">${A.esc(result.error)}</div>`; return; }
            const rec = {
              id: SS.uid("adj"),
              reason: ov2.querySelector("#a-reason").value.trim() || "Cycle Count",
              dueDate: ov2.querySelector("#a-due") ? ov2.querySelector("#a-due").value : A.dateInputDefault(0),
              warehouseId: ov2.querySelector("#a-wh").value,
              locationId: ov2.querySelector("#a-loc").value,
              status: "draft",
              createdAt: SS.now(),
              lines: result.lines.map((l) => ({ productId: l.productId, countedQuantity: Number(l.countedQuantity) })),
            };
            await SS.Repo.put("adjustments", rec);
            A.toast("Adjustment saved as draft", "info");
            A.closeModal();
            A.navigate("adjustments");
          });
        },
      });
    });
  };
})();

/* ============================================================
   Page: Stock Ledger (Audit Trail)
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.ledger = async function (mount, params) {
    const [ledger, products, locations, warehouses] = await Promise.all([
      SS.Repo.getAll("ledger"), SS.Repo.getAll("products"), SS.Repo.getAll("locations"), SS.Repo.getAll("warehouses"),
    ]);
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const locById = Object.fromEntries(locations.map((l) => [l.id, l]));
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));

    mount.innerHTML = `
      <div class="page-header">
        <div>
          <div class="page-title">Authoritative Stock Ledger</div>
          <div class="page-sub">Permanent, immutable record of every inventory delta. ${ledger.length} total entries.</div>
        </div>
        <button class="btn btn-ghost" id="export-ledger-csv">${A.ICONS.download} Export Ledger CSV</button>
      </div>
      <div class="panel"><div id="ledger-table"></div></div>
    `;

    const rows = ledger
      .slice()
      .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))
      .map((l) => ({
        ...l,
        productName: productById[l.productId]?.name || l.productId,
        sku: productById[l.productId]?.sku || "",
        unit: productById[l.productId]?.unit || "",
        locName: locById[l.locationId]?.name || "—",
        whName: whById[l.warehouseId]?.name || "—",
      }));

    mount.querySelector("#export-ledger-csv").addEventListener("click", () => {
      const headers = ["Timestamp", "Product Name", "SKU", "Operation Type", "Warehouse", "Location", "Direction", "Quantity", "Before", "After", "Reference ID"];
      const csvRows = rows.map((r) => [r.timestamp, r.productName, r.sku, r.refType, r.whName, r.locName, r.direction, r.quantity, r.before, r.after, r.refId]);
      A.exportCSV("stocksense_ledger.csv", headers, csvRows);
    });

    A.dataTable({
      mount: mount.querySelector("#ledger-table"),
      rows,
      rowKey: "id",
      pageSize: 12,
      initialQuery: params && params.q ? params.q : "",
      searchKeys: ["productName", "sku", "refType", "refId"],
      filters: [
        { key: "refType", label: "Operation", options: [{ value: "receipt", label: "Receipt" }, { value: "delivery", label: "Delivery" }, { value: "transfer", label: "Transfer" }, { value: "adjustment", label: "Adjustment" }] },
        { key: "direction", label: "Direction", options: [{ value: "in", label: "Inbound (+)" }, { value: "out", label: "Outbound (−)" }] },
      ],
      columns: [
        { key: "timestamp", label: "Date & Time", render: (r) => A.fmtDate(r.timestamp) },
        { key: "productName", label: "Product Item", render: (r) => `<div><strong>${A.esc(r.productName)}</strong></div><span class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(r.sku)}</span>` },
        { key: "refType", label: "Operation", render: (r) => `<span class="badge badge-draft">${A.esc(r.refType)}</span>` },
        { key: "whName", label: "Facility" },
        { key: "locName", label: "Location" },
        { key: "quantity", label: "Delta", num: true, render: (r) => `<span style="color:${r.direction === "in" ? "var(--in)" : "var(--out)"};font-weight:600">${r.direction === "in" ? "+" : "−"}${A.fmtQty(r.quantity, r.unit)}</span>` },
        { key: "before", label: "Balance (Before → After)", num: true, render: (r) => `${A.fmtQty(r.before)} → <strong>${A.fmtQty(r.after)}</strong>` },
        { key: "refId", label: "Document ID", render: (r) => `<span class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(r.refId)}</span>` },
      ],
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.ledger}</div><div class="em-title">No ledger entries recorded</div><div class="em-sub">Validate an operation to record your first ledger entry.</div></div>`,
    });
  };
})();

/* ============================================================
   Page: Reorder Rules & Automated Alerts
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.PAGE_RENDERERS.reorder = async function (mount) {
    const [rules, products, warehouses] = await Promise.all([SS.Repo.getAll("reorderRules"), SS.Repo.getAll("products"), SS.Repo.getAll("warehouses")]);
    const totals = await A.stockTotalsByProduct();
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));
    const whById = Object.fromEntries(warehouses.map((w) => [w.id, w]));

    mount.innerHTML = `
      <div class="page-header">
        <div><div class="page-title">Automated Reorder Rules</div><div class="page-sub">Configure minimum stock safety thresholds to trigger notifications automatically.</div></div>
        <button class="btn btn-primary" id="new-rule">+ Create Reorder Rule</button>
      </div>
      <div class="panel"><div id="rules-table"></div></div>
    `;

    const rows = rules.map((r) => {
      const p = productById[r.productId];
      const current = totals[r.productId] || 0;
      let statusBadge = `<span class="badge badge-ok">Optimal</span>`;
      if (current <= 0) statusBadge = `<span class="badge badge-out">Out of Stock</span>`;
      else if (current <= r.minQuantity) statusBadge = `<span class="badge badge-low">Low Stock Alert</span>`;

      return {
        ...r,
        productName: p ? p.name : r.productId,
        sku: p ? p.sku : "",
        unit: p ? p.unit : "",
        whName: whById[r.warehouseId]?.name || "—",
        current,
        statusBadge,
      };
    });

    A.dataTable({
      mount: mount.querySelector("#rules-table"),
      rows,
      rowKey: "id",
      searchKeys: ["productName", "sku"],
      columns: [
        { key: "productName", label: "Product Item", render: (r) => `<div><strong>${A.esc(r.productName)}</strong></div><span class="mono" style="font-size:11px;color:var(--text-faint)">${A.esc(r.sku)}</span>` },
        { key: "whName", label: "Warehouse Facility" },
        { key: "minQuantity", label: "Safety Threshold (Min)", num: true, render: (r) => A.fmtQty(r.minQuantity, r.unit) },
        { key: "current", label: "Current Balance", num: true, render: (r) => A.fmtQty(r.current, r.unit) },
        { key: "status", label: "Health Status", render: (r) => r.statusBadge },
      ],
      rowActions: (r) => `<button class="btn btn-sm btn-danger" data-del="${r.id}">Remove</button>`,
      emptyState: `<div class="empty-state"><div class="em-icon">${A.ICONS.reorder}</div><div class="em-title">No reorder rules configured</div><div class="em-sub">Set reorder points to get automated alerts when stock is depleted.</div></div>`,
    });

    mount.querySelectorAll("[data-del]").forEach((btn) => btn.addEventListener("click", () => {
      A.confirmDialog({
        title: "Remove reorder rule?",
        message: "Automated low-stock alerts will no longer trigger for this SKU/facility pair.",
        confirmLabel: "Remove Rule",
        danger: true,
        onConfirm: async () => {
          await SS.Repo.delete("reorderRules", btn.dataset.del);
          A.toast("Reorder rule removed", "info");
          A.navigate("reorder");
        },
      });
    }));

    document.getElementById("new-rule").addEventListener("click", () => {
      A.openModal({
        title: "Create Automated Reorder Rule",
        bodyHtml: `
          <div class="form-grid single">
            <div class="field"><label for="rr-prod">Target Product SKU</label><select id="rr-prod">${products.map((p) => `<option value="${p.id}">${A.esc(p.name)} (${A.esc(p.sku)})</option>`).join("")}</select></div>
            <div class="field"><label for="rr-wh">Target Warehouse Facility</label><select id="rr-wh">${warehouses.map((w) => `<option value="${w.id}">${A.esc(w.name)}</option>`).join("")}</select></div>
            <div class="field"><label for="rr-min">Minimum Reorder Level (Qty)</label><input id="rr-min" type="number" min="0" step="any" placeholder="e.g. 100" required /></div>
          </div>
          <div id="rr-error" style="margin-top:10px"></div>`,
        footHtml: `<button class="btn btn-ghost" data-close>Cancel</button><button class="btn btn-primary" id="rr-save">Save Rule</button>`,
        onMount: (ov) => {
          ov.querySelector("#rr-save").addEventListener("click", async () => {
            const min = Number(ov.querySelector("#rr-min").value);
            if (isNaN(min) || min < 0) { ov.querySelector("#rr-error").innerHTML = `<div class="error-banner">Enter a valid positive number.</div>`; return; }
            await SS.Repo.put("reorderRules", { id: SS.uid("rule"), productId: ov.querySelector("#rr-prod").value, warehouseId: ov.querySelector("#rr-wh").value, minQuantity: min });
            A.toast("Reorder threshold active", "info");
            A.closeModal();
            A.navigate("reorder");
          });
        },
      });
    });
  };
})();

/* ============================================================
   Notifications Panel & Profile / Settings
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  A.renderNotificationsPanel = async function () {
    const notifs = (await SS.Repo.getAll("notifications")).slice().sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    A.openModal({
      title: "System Alerts & Stock Notifications",
      bodyHtml: notifs.length === 0
        ? `<div class="empty-state"><div class="em-icon">${A.ICONS.bell}</div><div class="em-title">No unread notifications</div><div class="em-sub">Real-time alerts for low stock or zero inventory will appear here.</div></div>`
        : notifs.map((n) => `<div class="feed-row">
            <div class="feed-dir ${n.type === "out_of_stock" ? "out" : ""}" style="background:${n.type === "out_of_stock" ? "var(--out-dim)" : "var(--warn-dim)"};color:${n.type === "out_of_stock" ? "var(--out)" : "var(--warn)"}">!</div>
            <div class="feed-main"><div class="feed-title" style="${n.read ? "color:var(--text-faint)" : "font-weight:600"}">${A.esc(n.message)}</div><div class="feed-sub">${A.fmtDate(n.createdAt)}</div></div>
          </div>`).join(""),
      footHtml: notifs.some((n) => !n.read) ? `<button class="btn btn-primary" id="mark-read">Mark All as Read</button>` : "",
      onMount: (ov) => {
        const btn = ov.querySelector("#mark-read");
        if (btn) btn.addEventListener("click", async () => {
          for (const n of notifs) if (!n.read) await SS.Repo.put("notifications", { ...n, read: true });
          A.closeModal();
          A.navigate(A.state.route);
        });
      },
    });
  };

  A.PAGE_RENDERERS.profile = async function (mount) {
    const u = A.state.user;
    const [ledgerCount, users, products, warehouses] = await Promise.all([
      SS.Repo.getAll("ledger"), SS.Repo.getAll("users"), SS.Repo.getAll("products"), SS.Repo.getAll("warehouses")
    ]);
    const mine = ledgerCount.filter((l) => l.userId === u.id).length;

    mount.innerHTML = `
      <div class="page-header"><div><div class="page-title">Profile & System Settings</div><div class="page-sub">Manage workspace preferences and administrator tools.</div></div></div>
      <div class="two-col">
        <div class="panel">
          <div class="panel-head"><div class="panel-title">Your Operator Profile</div></div>
          <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px">
            <div class="avatar" style="width:48px;height:48px;font-size:16px">${A.initials(u.name)}</div>
            <div><div style="font-weight:700;font-size:15px">${A.esc(u.name)}</div><div class="field-hint">${A.esc(u.email)}</div></div>
          </div>
          <div class="kv"><span class="k">Assigned Role</span><span class="v">${A.esc(u.role).toUpperCase()}</span></div>
          <div class="kv"><span class="k">Operations Authored</span><span class="v">${mine}</span></div>
          <div class="kv"><span class="k">Total Catalog SKUs</span><span class="v">${products.length}</span></div>
          <div class="kv"><span class="k">Managed Warehouses</span><span class="v">${warehouses.length}</span></div>
          <div class="divider"></div>
          <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="btn btn-ghost btn-sm" id="reset-data">Reset Demo Dataset</button>
            <button class="btn btn-ghost btn-sm" id="export-full-backup">Download System Backup</button>
          </div>
          <div class="field-hint" style="margin-top:8px">Resets IndexedDB and primes the environment with high-fidelity demo transactions.</div>
        </div>
        <div class="panel">
          <div class="panel-head"><div class="panel-title">Authorized Team Members (${users.length})</div></div>
          ${users.map((x) => `<div class="feed-row"><div class="avatar">${A.initials(x.name)}</div><div class="feed-main"><div class="feed-title">${A.esc(x.name)}</div><div class="feed-sub">${A.esc(x.email)}</div></div><span class="badge badge-role">${A.esc(x.role)}</span></div>`).join("")}
        </div>
      </div>
    `;

    document.getElementById("export-full-backup").addEventListener("click", async () => {
      const data = {
        users, products, warehouses,
        locations: await SS.Repo.getAll("locations"),
        stock: await SS.Repo.getAll("stock"),
        receipts: await SS.Repo.getAll("receipts"),
        deliveries: await SS.Repo.getAll("deliveries"),
        transfers: await SS.Repo.getAll("transfers"),
        adjustments: await SS.Repo.getAll("adjustments"),
        ledger: ledgerCount,
        reorderRules: await SS.Repo.getAll("reorderRules"),
      };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `stocksense_backup_${Date.now()}.json`;
      a.click();
      A.toast("System backup downloaded", "info");
    });

    document.getElementById("reset-data").addEventListener("click", () => {
      A.confirmDialog({
        title: "Reset database to clean demo state?",
        message: "This operation clears all local data in this browser and reseeds verified showcase transactions.",
        confirmLabel: "Confirm Reset",
        danger: true,
        onConfirm: async () => {
          await SS.Repo.clearAll();
          await A.seedIfEmpty();
          A.state.user = null;
          localStorage.removeItem("ss_session_user");
          A.toast("Database reset to demo state", "info");
          A.navigate("login");
        },
      });
    });
  };
})();

/* ============================================================
   Application Bootstrap
   ============================================================ */
(function () {
  "use strict";
  const A = window.__SSAPP;

  async function boot() {
    try {
      await SS.openDB();
      await A.seedIfEmpty();

      const saved = localStorage.getItem("ss_session_user");
      if (saved) {
        try { A.state.user = JSON.parse(saved); } catch (e) { A.state.user = null; }
      }

      const initialRoute = (location.hash || "").replace(/^#\//, "") || (A.state.user ? "dashboard" : "login");
      A.navigate(initialRoute);

      window.addEventListener("hashchange", () => {
        const r = (location.hash || "").replace(/^#\//, "");
        if (r && r !== A.state.route && r !== "notifications-panel") A.navigate(r);
      });
    } catch (err) {
      console.error("Boot failure:", err);
      document.body.innerHTML = `<div style="padding:40px;color:#ff8533;font-family:sans-serif"><h3>Failed to initialize StockSense</h3><p>${err.message}</p></div>`;
    }
  }

  boot();
})();
</script>
</body>
</html>
