<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>StockSense — Intelligent Real-Time Inventory</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ===== StockSense Design Tokens & Modern Dark Theme ===== */
:root {
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
  --bg: #0B0F14;
  --surface: #121820;
  --surface-2: #18222D;
  --surface-3: #212D3B;
  --surface-hover: #263445;
  --border: #253342;
  --border-soft: #1B2633;
  --text: #EDF2F7;
  --text-muted: #94A3B8;
  --text-faint: #64748B;
  --accent: #FF8533;
  --accent-hover: #FFA05C;
  --accent-dim: #3D2210;
  --accent-text: #FFD4B2;
  --in: #10B981;
  --in-dim: #064E3B;
  --in-text: #A7F3D0;
  --out: #EF4444;
  --out-dim: #451313;
  --out-text: #FECACA;
  --warn: #F59E0B;
  --warn-dim: #452D09;
  --warn-text: #FDE68A;
  --info: #3B82F6;
  --info-dim: #1E3A8A;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --font-head: "Space Grotesk", "Inter", sans-serif;
  --font-body: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
  --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
  --shadow-md: 0 8px 24px rgba(0,0,0,0.45);
  --shadow-lg: 0 20px 60px rgba(0,0,0,0.6);
  color-scheme: dark;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 13.5px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}
h1, h2, h3, h4 { font-family: var(--font-head); font-weight: 600; letter-spacing: -0.015em; color: var(--text); }
a { color: inherit; text-decoration: none; }
button { font-family: var(--font-body); cursor: pointer; border: none; background: none; }
input, select, textarea { font-family: var(--font-body); color: var(--text); }
::selection { background: var(--accent); color: #110802; }

/* Custom Scrollbars */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: var(--text-faint); }

.mono { font-family: var(--font-mono); }

/* Focus visibility */
a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible,
textarea:focus-visible, [tabindex]:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* ===== App Shell Layout ===== */
#app { height: 100%; }
.shell {
  display: grid;
  grid-template-columns: 240px 1fr;
  height: 100vh;
  height: 100dvh;
}

/* Sidebar */
.sidebar {
  background: var(--surface);
  border-right: 1px solid var(--border-soft);
  display: flex;
  flex-direction: column;
  padding: 16px 12px;
  overflow-y: auto;
  z-index: 50;
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}
.sidebar-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(3px);
  z-index: 40;
}
.sidebar-backdrop.active { display: block; }

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 4px 8px 18px;
  border-bottom: 1px solid var(--border-soft);
}
.brand-mark {
  width: 32px; height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--accent), #D45B10);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-head); font-weight: 700; font-size: 14px; color: #150A03;
  box-shadow: 0 2px 10px rgba(255, 133, 51, 0.3);
  flex-shrink: 0;
}
.brand-name { font-family: var(--font-head); font-size: 16.5px; font-weight: 700; letter-spacing: -0.02em; }
.brand-sub { font-size: 10px; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }

.nav-group { margin-top: 14px; }
.nav-group-label {
  font-size: 10.5px; color: var(--text-faint); padding: 0 10px 6px;
  font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
}
.nav-link {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 10px; border-radius: var(--radius-sm);
  color: var(--text-muted); font-size: 13px; font-weight: 500;
  border: 1px solid transparent; margin-bottom: 2px;
  transition: all .12s ease;
}
.nav-link:hover { background: var(--surface-2); color: var(--text); }
.nav-link.active {
  background: var(--surface-3); color: var(--text);
  border-color: var(--border); font-weight: 600;
}
.nav-link.active .nav-ico { color: var(--accent); }
.nav-ico { display: flex; align-items: center; justify-content: center; width: 18px; height: 18px; color: var(--text-faint); flex-shrink: 0; }
.nav-badge {
  margin-left: auto; background: var(--accent-dim); color: var(--accent-text);
  font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 99px;
  font-family: var(--font-mono); border: 1px solid var(--accent);
}
.sidebar-foot { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--border-soft); }

/* Main Area */
.main { display: flex; flex-direction: column; min-width: 0; overflow: hidden; height: 100%; }

.topbar {
  height: 56px; flex-shrink: 0;
  border-bottom: 1px solid var(--border-soft);
  display: flex; align-items: center; gap: 12px;
  padding: 0 22px;
  background: var(--surface);
  position: relative;
  z-index: 20;
}
.topbar-left { display: flex; align-items: center; gap: 12px; }
.topbar-title { font-family: var(--font-head); font-size: 17px; font-weight: 700; }
.search-box {
  flex: 1; max-width: 440px;
  display: flex; align-items: center; gap: 9px;
  background: var(--surface-2); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 6px 12px; margin-left: 8px;
  transition: border-color 0.15s, background 0.15s;
}
.search-box:focus-within { border-color: var(--accent); background: var(--surface-3); }
.search-box input {
  background: none; border: none; color: var(--text); outline: none; width: 100%; font-size: 13px;
}
.search-box svg { color: var(--text-faint); flex-shrink: 0; }
.search-shortcut {
  font-family: var(--font-mono); font-size: 10.5px; color: var(--text-faint);
  background: var(--surface); border: 1px solid var(--border); padding: 2px 5px; border-radius: 4px;
}

.topbar-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
.icon-btn {
  position: relative; width: 34px; height: 34px; border-radius: var(--radius-sm);
  border: 1px solid var(--border); background: var(--surface-2); color: var(--text-muted);
  display: flex; align-items: center; justify-content: center; transition: all 0.15s ease;
}
.icon-btn:hover { color: var(--text); border-color: var(--text-faint); background: var(--surface-3); }
.dot-badge {
  position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; border-radius: 50%;
  background: var(--out); border: 2px solid var(--surface-2); box-shadow: 0 0 6px var(--out);
}
.user-chip {
  display: flex; align-items: center; gap: 8px; padding: 4px 10px 4px 4px;
  border: 1px solid var(--border); border-radius: 99px; background: var(--surface-2);
}
.avatar {
  width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg, var(--surface-3), #2B3D50);
  display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700;
  color: var(--accent); border: 1px solid var(--border);
}

.content { flex: 1; overflow-y: auto; padding: 24px 28px 60px; }
.page-header {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
  margin-bottom: 20px; flex-wrap: wrap;
}
.page-title { font-size: 22px; font-weight: 700; }
.page-sub { color: var(--text-muted); font-size: 13px; margin-top: 4px; }

/* ===== Buttons ===== */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  border-radius: var(--radius-sm); border: 1px solid var(--border);
  background: var(--surface-2); color: var(--text);
  padding: 8px 14px; font-size: 13px; font-weight: 500;
  transition: all 0.12s ease; user-select: none;
}
.btn:hover { border-color: var(--text-faint); background: var(--surface-3); }
.btn-primary {
  background: linear-gradient(145deg, var(--accent), #E56E1B);
  border-color: var(--accent); color: #160A03; font-weight: 600;
  box-shadow: 0 2px 8px rgba(255, 133, 51, 0.25);
}
.btn-primary:hover { background: linear-gradient(145deg, var(--accent-hover), #FF8533); border-color: var(--accent-hover); color: #100601; }
.btn-danger { background: var(--out-dim); border-color: #6B2121; color: var(--out-text); font-weight: 600; }
.btn-danger:hover { background: #5C1919; border-color: var(--out); }
.btn-ghost { background: transparent; border-color: transparent; color: var(--text-muted); }
.btn-ghost:hover { background: var(--surface-2); color: var(--text); }
.btn-sm { padding: 5px 10px; font-size: 12px; }
.btn:disabled { opacity: .45; cursor: not-allowed; pointer-events: none; }

/* ===== Stat Cards & Dashboard Grid ===== */
.grid-stats {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
  gap: 12px; margin-bottom: 22px;
}
.stat-card {
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: var(--radius-md); padding: 16px 18px 14px;
  position: relative; overflow: hidden; transition: transform 0.12s ease, border-color 0.12s ease;
}
.stat-card:hover { border-color: var(--border); transform: translateY(-1px); }
.stat-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.stat-label { font-size: 12.5px; color: var(--text-muted); font-weight: 500; }
.stat-flag { width: 8px; height: 8px; border-radius: 50%; }
.stat-value { font-family: var(--font-mono); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
.stat-value.warn { color: var(--warn); }
.stat-value.danger { color: var(--out); }
.stat-value.accent { color: var(--accent); }
.stat-sub { font-size: 11px; color: var(--text-faint); margin-top: 4px; }

/* Stock Health Bar */
.health-bar-card {
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: var(--radius-md); padding: 16px 18px; margin-bottom: 20px;
}
.health-bar-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.health-bar-title { font-weight: 600; font-size: 13.5px; }
.health-bar {
  display: flex; height: 10px; border-radius: 99px; overflow: hidden; background: var(--surface-3); gap: 2px;
}
.health-seg { height: 100%; transition: width 0.3s ease; }
.health-legend { display: flex; gap: 16px; margin-top: 10px; flex-wrap: wrap; font-size: 12px; color: var(--text-muted); }
.legend-item { display: flex; align-items: center; gap: 6px; }
.legend-dot { width: 8px; height: 8px; border-radius: 50%; }

.panel {
  background: var(--surface); border: 1px solid var(--border-soft);
  border-radius: var(--radius-md); padding: 18px;
}
.panel + .panel { margin-top: 16px; }
.panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 8px; }
.panel-title { font-size: 15px; font-weight: 600; font-family: var(--font-head); }

.two-col { display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; align-items: start; }

/* ===== Activity Feed ===== */
.feed-row {
  display: flex; align-items: center; gap: 12px; padding: 10px 4px;
  border-bottom: 1px solid var(--border-soft); font-size: 13px;
  transition: background 0.1s;
}
.feed-row:hover { background: rgba(255,255,255,0.015); border-radius: 4px; }
.feed-row:last-child { border-bottom: none; }
.feed-dir {
  width: 26px; height: 26px; border-radius: 7px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;
}
.feed-dir.in { background: var(--in-dim); color: var(--in); border: 1px solid rgba(16,185,129,0.3); }
.feed-dir.out { background: var(--out-dim); color: var(--out); border: 1px solid rgba(239,68,68,0.3); }
.feed-main { flex: 1; min-width: 0; }
.feed-title { color: var(--text); font-weight: 500; }
.feed-sub { color: var(--text-faint); font-size: 11.5px; margin-top: 2px; }
.feed-qty { font-family: var(--font-mono); font-size: 13px; font-weight: 500; }

/* ===== Data Tables ===== */
.table-toolbar {
  display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap;
}
.toolbar-input, .toolbar-select {
  background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
  border-radius: var(--radius-sm); padding: 7px 11px; font-size: 13px; outline: none;
  transition: border-color 0.15s;
}
.toolbar-input:focus, .toolbar-select:focus { border-color: var(--accent); }
.toolbar-input { min-width: 220px; }
.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--radius-sm); }
table.data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.data-table th {
  text-align: left; color: var(--text-faint); font-weight: 600; font-size: 11.5px;
  padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: nowrap;
  background: var(--surface); text-transform: uppercase; letter-spacing: 0.04em;
}
.data-table td { padding: 11px 12px; border-bottom: 1px solid var(--border-soft); vertical-align: middle; }
.data-table tr:hover td { background: var(--surface-2); }
.data-table .num { font-family: var(--font-mono); }
.row-actions { display: flex; gap: 6px; justify-content: flex-end; }

.pagination { display: flex; align-items: center; gap: 10px; justify-content: space-between; margin-top: 14px; flex-wrap: wrap; }
.page-info { color: var(--text-faint); font-size: 12px; }

/* ===== Badges ===== */
.badge {
  display: inline-flex; align-items: center; gap: 5px; padding: 2px 9px; border-radius: 99px;
  font-size: 11.5px; font-weight: 600; border: 1px solid transparent; font-family: var(--font-mono);
}
.badge-draft { background: var(--surface-3); color: var(--text-muted); border-color: var(--border); }
.badge-validated { background: var(--in-dim); color: var(--in-text); border-color: rgba(16,185,129,0.3); }
.badge-cancelled { background: var(--out-dim); color: var(--out-text); border-color: rgba(239,68,68,0.3); }
.badge-low { background: var(--warn-dim); color: var(--warn-text); border-color: rgba(245,158,11,0.3); }
.badge-out { background: var(--out-dim); color: var(--out-text); border-color: rgba(239,68,68,0.3); }
.badge-ok { background: var(--in-dim); color: var(--in-text); border-color: rgba(16,185,129,0.3); }
.badge-role { background: var(--surface-3); color: var(--text-muted); border-color: var(--border); font-size: 10.5px; }

/* ===== Empty & Error States ===== */
.empty-state { text-align: center; padding: 48px 20px; color: var(--text-muted); }
.empty-state .em-icon { width: 44px; height: 44px; margin: 0 auto 12px; color: var(--text-faint); display: flex; align-items: center; justify-content: center; }
.empty-state .em-title { color: var(--text); font-weight: 600; font-size: 15px; margin-bottom: 4px; }
.empty-state .em-sub { font-size: 12.5px; max-width: 320px; margin: 0 auto; color: var(--text-faint); }
.skeleton { background: linear-gradient(90deg, var(--surface-2) 25%, var(--surface-3) 37%, var(--surface-2) 63%); background-size: 400% 100%; animation: sk 1.4s ease infinite; border-radius: var(--radius-sm); }
@keyframes sk { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }
.skel-row { height: 38px; margin-bottom: 6px; }
.error-banner {
  background: var(--out-dim); border: 1px solid rgba(239,68,68,0.4); color: var(--out-text);
  padding: 10px 14px; border-radius: var(--radius-sm); font-size: 13px; margin-bottom: 14px;
}

/* ===== Forms ===== */
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
.form-grid.single { grid-template-columns: 1fr; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field label { font-size: 12.5px; color: var(--text-muted); font-weight: 500; }
.field input, .field select, .field textarea {
  background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
  border-radius: var(--radius-sm); padding: 8px 12px; font-size: 13.5px; outline: none; width: 100%;
  transition: border-color 0.15s;
}
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--accent); }
.field-hint { color: var(--text-faint); font-size: 11.5px; }

/* Line items */
.line-items { border: 1px solid var(--border-soft); border-radius: var(--radius-sm); overflow: hidden; margin-top: 8px; }
.line-item-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 8px; padding: 10px; border-bottom: 1px solid var(--border-soft); align-items: center; }
.line-item-row:last-child { border-bottom: none; }
.line-item-row.head { background: var(--surface-2); font-size: 11px; color: var(--text-faint); font-weight: 600; padding: 7px 10px; text-transform: uppercase; }
.stock-feedback { font-size: 11px; color: var(--text-faint); margin-top: 2px; }
.stock-feedback.insufficient { color: var(--out); font-weight: 600; }

/* ===== Modals ===== */
.overlay {
  position: fixed; inset: 0; background: rgba(4, 7, 11, 0.72); backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center; z-index: 100; padding: 20px;
}
.modal {
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);
  width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto;
  box-shadow: var(--shadow-lg); animation: mIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes mIn { from { transform: scale(0.96); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.modal.wide { max-width: 780px; }
.modal-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--border-soft); }
.modal-title { font-size: 16px; font-family: var(--font-head); font-weight: 700; }
.modal-body { padding: 20px; }
.modal-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 20px; border-top: 1px solid var(--border-soft); background: rgba(0,0,0,0.15); }
.close-x { color: var(--text-faint); font-size: 18px; padding: 4px 8px; border-radius: 4px; }
.close-x:hover { color: var(--text); background: var(--surface-2); }

.confirm-diff { background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px 14px; margin: 14px 0; font-size: 13px; }
.confirm-diff-row { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid var(--border-soft); }
.confirm-diff-row:last-child { border-bottom: none; }
.confirm-diff-row .val { font-family: var(--font-mono); font-weight: 600; color: var(--accent); }

/* Document Details View */
.doc-detail-meta {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 12px; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm);
  padding: 14px; margin-bottom: 16px;
}
.doc-meta-item .lbl { font-size: 11px; color: var(--text-faint); text-transform: uppercase; }
.doc-meta-item .val { font-size: 13.5px; font-weight: 600; margin-top: 2px; }

/* ===== Toasts ===== */
.toast-stack { position: fixed; bottom: 20px; right: 20px; display: flex; flex-direction: column; gap: 8px; z-index: 200; pointer-events: none; }
.toast {
  pointer-events: auto;
  background: var(--surface-3); border: 1px solid var(--border); border-left: 4px solid var(--in);
  border-radius: var(--radius-sm); padding: 12px 16px; font-size: 13px; min-width: 260px; max-width: 360px;
  box-shadow: var(--shadow-md); color: var(--text); animation: tIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes tIn { from { transform: translateY(12px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.toast.error { border-left-color: var(--out); }
.toast.info { border-left-color: var(--accent); }

/* ===== Auth screens ===== */
.auth-wrap {
  min-height: 100vh; min-height: 100dvh; display: flex; align-items: center; justify-content: center;
  background: radial-gradient(ellipse at top, #162433 0%, var(--bg) 65%);
  padding: 20px;
}
.auth-card { width: 100%; max-width: 400px; }
.auth-brand { display: flex; align-items: center; gap: 12px; justify-content: center; margin-bottom: 26px; }
.auth-panel { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius-md); padding: 28px 24px; box-shadow: var(--shadow-lg); }
.auth-title { font-size: 20px; text-align: center; margin-bottom: 4px; }
.auth-sub { text-align: center; color: var(--text-muted); font-size: 13px; margin-bottom: 20px; }
.auth-switch { text-align: center; margin-top: 16px; font-size: 13px; color: var(--text-muted); }
.auth-switch a, .link-btn { color: var(--accent); text-decoration: none; cursor: pointer; background: none; border: none; font-size: inherit; padding: 0; font-weight: 500; }
.auth-switch a:hover, .link-btn:hover { text-decoration: underline; }
.otp-box { font-family: var(--font-mono); font-size: 24px; letter-spacing: 6px; text-align: center; background: var(--surface-2); border: 1px dashed var(--accent); border-radius: var(--radius-sm); padding: 14px; margin: 12px 0; color: var(--accent); font-weight: 700; }

/* ===== Misc Utilities ===== */
.divider { height: 1px; background: var(--border-soft); margin: 16px 0; }
.kv { display: flex; justify-content: space-between; font-size: 13px; padding: 8px 0; border-bottom: 1px solid var(--border-soft); }
.kv:last-child { border-bottom: none; }
.kv .k { color: var(--text-muted); }
.kv .v { font-family: var(--font-mono); font-weight: 500; }
.hidden { display: none !important; }
.filter-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
.chip {
  padding: 4px 10px; border-radius: 99px; font-size: 12px; font-weight: 500;
  border: 1px solid var(--border); background: var(--surface-2); color: var(--text-muted); cursor: pointer;
  transition: all 0.1s ease;
}
.chip:hover { color: var(--text); border-color: var(--text-faint); }
.chip.active { background: var(--accent-dim); border-color: var(--accent); color: var(--accent-text); font-weight: 600; }

/* ===== Interactive Dropdown Menus & Accordions ===== */
.dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 220px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-lg);
  padding: 8px;
  z-index: 150;
  animation: mIn 0.15s cubic-bezier(0.16, 1, 0.3, 1);
}
.dropdown-header {
  padding: 8px 10px;
}
.dropdown-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.12s ease;
  box-sizing: border-box;
}
.dropdown-item:hover {
  background: var(--surface-2);
  color: var(--text);
}
.dropdown-item.danger {
  color: var(--out-text);
}
.dropdown-item.danger:hover {
  background: var(--out-dim);
  color: var(--out);
}

/* Accordion Dropdown Component */
.accordion-card {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-md);
  margin-bottom: 12px;
  overflow: hidden;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.accordion-card:hover {
  border-color: var(--border);
}
.accordion-card.open {
  border-color: rgba(255, 133, 51, 0.35);
  box-shadow: 0 4px 16px rgba(0,0,0,0.25);
}
.accordion-head {
  padding: 14px 18px;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  user-select: none;
  transition: background 0.12s ease;
  flex-wrap: wrap;
  gap: 10px;
}
.accordion-head:hover {
  background: var(--surface-2);
}
.accordion-chevron {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  font-size: 11px;
  color: var(--text-faint);
  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}
.accordion-card.open .accordion-chevron {
  transform: rotate(180deg);
  color: var(--accent);
}
.accordion-body {
  display: none;
  padding: 16px 18px;
  background: var(--surface-2);
  border-top: 1px solid var(--border-soft);
}
.accordion-card.open .accordion-body {
  display: block;
  animation: fadeIn 0.15s ease;
}

/* Category Product Checklist in Modal */
.cat-prod-list {
  max-height: 240px;
  overflow-y: auto;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.cat-prod-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all 0.12s ease;
  user-select: none;
  border: 1px solid transparent;
}
.cat-prod-item:hover {
  background: var(--surface-3);
}
.cat-prod-item.selected {
  background: rgba(255, 133, 51, 0.08);
  border-color: rgba(255, 133, 51, 0.3);
}
.cat-prod-item input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: var(--accent);
  cursor: pointer;
  flex-shrink: 0;
}
.cat-prod-info {
  flex: 1;
  min-width: 0;
}
.cat-prod-name {
  font-weight: 500;
  color: var(--text);
  font-size: 13px;
}
.cat-prod-sub {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}
.cat-prod-stock {
  text-align: right;
  font-size: 12.5px;
  flex-shrink: 0;
}

/* Category Products Grid inside Accordion */
.cat-products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 10px;
}
.cat-prod-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: border-color 0.12s, transform 0.12s;
}
.cat-prod-card:hover {
  border-color: var(--text-faint);
  transform: translateY(-1px);
}

/* Product Ranks (Title, Pay, Active) */
.badge-rank-diamond { background: rgba(56, 189, 248, 0.16); color: #38BDF8; border-color: rgba(56, 189, 248, 0.4); font-weight: 700; }
.badge-rank-platinum { background: rgba(167, 139, 250, 0.16); color: #C084FC; border-color: rgba(167, 139, 250, 0.4); font-weight: 700; }
.badge-rank-gold { background: rgba(245, 158, 11, 0.16); color: #FBBF24; border-color: rgba(245, 158, 11, 0.4); font-weight: 700; }
.badge-rank-silver { background: rgba(148, 163, 184, 0.16); color: #CBD5E1; border-color: rgba(148, 163, 184, 0.4); font-weight: 600; }
.badge-rank-bronze { background: rgba(217, 119, 6, 0.16); color: #F59E0B; border-color: rgba(217, 119, 6, 0.4); font-weight: 600; }

.badge-active-qualified, .badge-active-active { background: rgba(16, 185, 129, 0.16); color: #34D399; border-color: rgba(16, 185, 129, 0.4); font-weight: 600; }
.badge-active-grace { background: rgba(245, 158, 11, 0.16); color: #FBBF24; border-color: rgba(245, 158, 11, 0.4); font-weight: 600; }
.badge-active-inactive { background: rgba(239, 68, 68, 0.16); color: #F87171; border-color: rgba(239, 68, 68, 0.4); font-weight: 600; }

/* Sales Performance & Analytics Components */
.sales-chart-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 20px;
  margin-bottom: 20px;
}
.sales-chart-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 16px;
}
.sales-metric-group {
  display: flex;
  gap: 20px;
}
.sales-metric-box .val {
  font-family: var(--font-head);
  font-size: 24px;
  font-weight: 700;
  color: var(--text);
}
.sales-metric-box .lbl {
  font-size: 11.5px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.sales-svg-container {
  width: 100%;
  height: 230px;
  position: relative;
}
.sales-bar {
  transition: opacity 0.15s, transform 0.15s;
  cursor: pointer;
}
.sales-bar:hover {
  opacity: 0.85;
}
.sales-rank-card {
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.sales-rank-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sales-rank-bar-bg {
  width: 100%;
  height: 6px;
  background: var(--surface-3);
  border-radius: 99px;
  overflow: hidden;
}
.sales-rank-bar-fill {
  height: 100%;
  border-radius: 99px;
}

/* Responsive adjustments */
#menu-btn { display: none; }
@media (max-width: 820px) {
  .shell { grid-template-columns: 1fr; }
  .sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 250px; transform: translateX(-100%); box-shadow: var(--shadow-lg); }
  .sidebar.open { transform: translateX(0); }
  #menu-btn { display: flex; }
  .two-col { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
  .topbar { padding: 0 14px; }
  .content { padding: 18px 16px 50px; }
}

/* Print Friendly Styles for Slips */
@media print {
  body { background: #fff !important; color: #000 !important; }
  .sidebar, .topbar, .modal-foot, .close-x, .row-actions, .table-toolbar, .btn { display: none !important; }
  .overlay { position: static !important; background: none !important; padding: 0 !important; }
  .modal { box-shadow: none !important; border: 1px solid #ccc !important; max-width: 100% !important; max-height: none !important; }
  .data-table th, .data-table td { color: #000 !important; border-color: #ddd !important; }
}
</style>
</head>
<body>
<div id="app"></div>
<script>
/* ============================================================
   StockSense Core — data layer + business logic
   Pure vanilla JS, IndexedDB-backed. No build step, no deps.
   ============================================================ */
(function (global) {
  "use strict";

  const DB_NAME = "stocksense_db";
  const DB_VERSION = 1;

  const STORES = {
    users: "id",
    products: "id",
    categories: "id",
    warehouses: "id",
    locations: "id",
    stock: "id", // composite: productId|locationId
    receipts: "id",
    deliveries: "id",
    transfers: "id",
    adjustments: "id",
    ledger: "id",
    reorderRules: "id",
    notifications: "id",
    sessions: "id",
  };

  let dbPromise = null;

  function openDB() {
    if (dbPromise) return dbPromise;
    dbPromise = new Promise((resolve, reject) => {
      const req = global.indexedDB.open(DB_NAME, DB_VERSION);
      req.onupgradeneeded = (e) => {
        const db = e.target.result;
        Object.entries(STORES).forEach(([name, keyPath]) => {
          if (!db.objectStoreNames.contains(name)) {
            const store = db.createObjectStore(name, { keyPath });
            if (name === "products") {
              store.createIndex("sku", "sku", { unique: true });
              store.createIndex("categoryId", "categoryId", { unique: false });
            }
            if (name === "stock") {
              store.createIndex("productId", "productId", { unique: false });
              store.createIndex("locationId", "locationId", { unique: false });
              store.createIndex("warehouseId", "warehouseId", { unique: false });
            }
            if (name === "locations") {
              store.createIndex("warehouseId", "warehouseId", { unique: false });
            }
            if (name === "ledger") {
              store.createIndex("productId", "productId", { unique: false });
              store.createIndex("timestamp", "timestamp", { unique: false });
              store.createIndex("refType", "refType", { unique: false });
            }
            if (name === "receipts" || name === "deliveries" || name === "transfers" || name === "adjustments") {
              store.createIndex("status", "status", { unique: false });
              store.createIndex("createdAt", "createdAt", { unique: false });
            }
            if (name === "users") {
              store.createIndex("email", "email", { unique: true });
            }
            if (name === "notifications") {
              store.createIndex("read", "read", { unique: false });
            }
          }
        });
      };
      req.onsuccess = (e) => resolve(e.target.result);
      req.onerror = (e) => reject(e.target.error);
    });
    return dbPromise;
  }

  function tx(storeNames, mode) {
    return openDB().then((db) => db.transaction(storeNames, mode));
  }

  function reqAsPromise(request) {
    return new Promise((resolve, reject) => {
      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }

  // ---------- Generic repository ----------
  const Repo = {
    async getAll(store) {
      const t = await tx([store], "readonly");
      return reqAsPromise(t.objectStore(store).getAll());
    },
    async get(store, id) {
      const t = await tx([store], "readonly");
      return reqAsPromise(t.objectStore(store).get(id));
    },
    async getByIndex(store, indexName, value) {
      const t = await tx([store], "readonly");
      const idx = t.objectStore(store).index(indexName);
      return reqAsPromise(idx.getAll(value));
    },
    async put(store, obj) {
      const t = await tx([store], "readwrite");
      await reqAsPromise(t.objectStore(store).put(obj));
      return obj;
    },
    async bulkPut(store, objs) {
      const t = await tx([store], "readwrite");
      const os = t.objectStore(store);
      objs.forEach((o) => os.put(o));
      return new Promise((resolve, reject) => {
        t.oncomplete = () => resolve(objs);
        t.onerror = () => reject(t.error);
      });
    },
    async delete(store, id) {
      const t = await tx([store], "readwrite");
      await reqAsPromise(t.objectStore(store).delete(id));
    },
    async clearAll() {
      const names = Object.keys(STORES);
      const t = await tx(names, "readwrite");
      names.forEach((n) => t.objectStore(n).clear());
      return new Promise((resolve, reject) => {
        t.oncomplete = () => resolve();
        t.onerror = () => reject(t.error);
      });
    },
  };

  // ---------- Helpers ----------
  function uid(prefix) {
    return (
      (prefix ? prefix + "_" : "") +
      Date.now().toString(36) +
      Math.random().toString(36).slice(2, 9)
    );
  }

  function now() {
    return new Date().toISOString();
  }

  function stockKey(productId, locationId) {
    return productId + "|" + locationId;
  }

  async function getOrCreateStockRow(productId, locationId, warehouseId) {
    const id = stockKey(productId, locationId);
    let row = await Repo.get("stock", id);
    if (!row) {
      row = { id, productId, locationId, warehouseId, quantity: 0 };
      await Repo.put("stock", row);
    }
    return row;
  }

  async function writeLedger(entry) {
    const row = {
      id: uid("led"),
      timestamp: now(),
      ...entry,
    };
    await Repo.put("ledger", row);
    return row;
  }

  async function checkReorder(productId, warehouseId) {
    const rules = await Repo.getAll("reorderRules");
    const rule = rules.find(
      (r) => r.productId === productId && r.warehouseId === warehouseId
    );
    if (!rule) return null;
    const stockRows = await Repo.getByIndex("stock", "productId", productId);
    const totalInWarehouse = stockRows
      .filter((r) => r.warehouseId === warehouseId)
      .reduce((sum, r) => sum + r.quantity, 0);
    if (totalInWarehouse <= rule.minQuantity) {
      const product = await Repo.get("products", productId);
      const notif = {
        id: uid("notif"),
        type: totalInWarehouse <= 0 ? "out_of_stock" : "low_stock",
        message: `${product ? product.name : productId} is ${
          totalInWarehouse <= 0 ? "out of stock" : "running low"
        } in warehouse (qty: ${totalInWarehouse}, reorder point: ${rule.minQuantity})`,
        productId,
        warehouseId,
        read: false,
        createdAt: now(),
      };
      await Repo.put("notifications", notif);
      return notif;
    }
    return null;
  }

  // ============================================================
  // STOCK ENGINE — authoritative state mutations
  // ============================================================
  const StockEngine = {
    async validateReceipt(receiptId, userId) {
      const receipt = await Repo.get("receipts", receiptId);
      if (!receipt) throw new Error("Receipt not found");
      if (receipt.status === "validated") throw new Error("Receipt already validated");
      if (receipt.status === "cancelled") throw new Error("Cannot validate a cancelled receipt");

      for (const line of receipt.lines) {
        const row = await getOrCreateStockRow(line.productId, receipt.locationId, receipt.warehouseId);
        const before = row.quantity;
        row.quantity = before + Number(line.quantity);
        await Repo.put("stock", row);
        await writeLedger({
          refType: "receipt",
          refId: receipt.id,
          productId: line.productId,
          locationId: receipt.locationId,
          warehouseId: receipt.warehouseId,
          direction: "in",
          quantity: Number(line.quantity),
          before,
          after: row.quantity,
          userId,
        });
        await checkReorder(line.productId, receipt.warehouseId);
      }
      receipt.status = "validated";
      receipt.validatedAt = now();
      receipt.validatedBy = userId;
      await Repo.put("receipts", receipt);
      return receipt;
    },

    async cancelReceipt(receiptId, userId) {
      const receipt = await Repo.get("receipts", receiptId);
      if (!receipt) throw new Error("Receipt not found");
      if (receipt.status === "validated") throw new Error("Cannot cancel a validated receipt");
      receipt.status = "cancelled";
      receipt.cancelledAt = now();
      receipt.cancelledBy = userId;
      await Repo.put("receipts", receipt);
      return receipt;
    },

    async validateDelivery(deliveryId, userId) {
      const delivery = await Repo.get("deliveries", deliveryId);
      if (!delivery) throw new Error("Delivery not found");
      if (delivery.status === "validated") throw new Error("Delivery already validated");
      if (delivery.status === "cancelled") throw new Error("Cannot validate a cancelled delivery");

      for (const line of delivery.lines) {
        const row = await getOrCreateStockRow(line.productId, delivery.locationId, delivery.warehouseId);
        if (row.quantity < Number(line.quantity)) {
          const product = await Repo.get("products", line.productId);
          throw new Error(
            `Insufficient stock for ${product ? product.name : line.productId}: available ${row.quantity}, requested ${line.quantity}`
          );
        }
      }

      for (const line of delivery.lines) {
        const row = await getOrCreateStockRow(line.productId, delivery.locationId, delivery.warehouseId);
        const before = row.quantity;
        row.quantity = before - Number(line.quantity);
        await Repo.put("stock", row);
        await writeLedger({
          refType: "delivery",
          refId: delivery.id,
          productId: line.productId,
          locationId: delivery.locationId,
          warehouseId: delivery.warehouseId,
          direction: "out",
          quantity: Number(line.quantity),
          before,
          after: row.quantity,
          userId,
        });
        await checkReorder(line.productId, delivery.warehouseId);
      }
      delivery.status = "validated";
      delivery.validatedAt = now();
      delivery.validatedBy = userId;
      await Repo.put("deliveries", delivery);
      return delivery;
    },

    async cancelDelivery(deliveryId, userId) {
      const delivery = await Repo.get("deliveries", deliveryId);
      if (!delivery) throw new Error("Delivery not found");
      if (delivery.status === "validated") throw new Error("Cannot cancel a validated delivery");
      delivery.status = "cancelled";
      delivery.cancelledAt = now();
      delivery.cancelledBy = userId;
      await Repo.put("deliveries", delivery);
      return delivery;
    },

    async validateTransfer(transferId, userId) {
      const transfer = await Repo.get("transfers", transferId);
      if (!transfer) throw new Error("Transfer not found");
      if (transfer.status === "validated") throw new Error("Transfer already validated");
      if (transfer.status === "cancelled") throw new Error("Cannot validate a cancelled transfer");

      for (const line of transfer.lines) {
        const srcRow = await getOrCreateStockRow(line.productId, transfer.sourceLocationId, transfer.sourceWarehouseId);
        if (srcRow.quantity < Number(line.quantity)) {
          const product = await Repo.get("products", line.productId);
          throw new Error(
            `Insufficient stock to transfer ${product ? product.name : line.productId}: available ${srcRow.quantity}, requested ${line.quantity}`
          );
        }
      }

      for (const line of transfer.lines) {
        const srcRow = await getOrCreateStockRow(line.productId, transfer.sourceLocationId, transfer.sourceWarehouseId);
        const destRow = await getOrCreateStockRow(line.productId, transfer.destLocationId, transfer.destWarehouseId);

        const srcBefore = srcRow.quantity;
        srcRow.quantity = srcBefore - Number(line.quantity);
        await Repo.put("stock", srcRow);
        await writeLedger({
          refType: "transfer",
          refId: transfer.id,
          productId: line.productId,
          locationId: transfer.sourceLocationId,
          warehouseId: transfer.sourceWarehouseId,
          direction: "out",
          quantity: Number(line.quantity),
          before: srcBefore,
          after: srcRow.quantity,
          userId,
        });

        const destBefore = destRow.quantity;
        destRow.quantity = destBefore + Number(line.quantity);
        await Repo.put("stock", destRow);
        await writeLedger({
          refType: "transfer",
          refId: transfer.id,
          productId: line.productId,
          locationId: transfer.destLocationId,
          warehouseId: transfer.destWarehouseId,
          direction: "in",
          quantity: Number(line.quantity),
          before: destBefore,
          after: destRow.quantity,
          userId,
        });

        await checkReorder(line.productId, transfer.sourceWarehouseId);
      }
      transfer.status = "validated";
      transfer.validatedAt = now();
      transfer.validatedBy = userId;
      await Repo.put("transfers", transfer);
      return transfer;
    },

    async cancelTransfer(transferId, userId) {
      const transfer = await Repo.get("transfers", transferId);
      if (!transfer) throw new Error("Transfer not found");
      if (transfer.status === "validated") throw new Error("Cannot cancel a validated transfer");
      transfer.status = "cancelled";
      transfer.cancelledAt = now();
      transfer.cancelledBy = userId;
      await Repo.put("transfers", transfer);
      return transfer;
    },

    async validateAdjustment(adjustmentId, userId) {
      const adj = await Repo.get("adjustments", adjustmentId);
      if (!adj) throw new Error("Adjustment not found");
      if (adj.status === "validated") throw new Error("Adjustment already validated");
      if (adj.status === "cancelled") throw new Error("Cannot validate a cancelled adjustment");

      for (const line of adj.lines) {
        const row = await getOrCreateStockRow(line.productId, adj.locationId, adj.warehouseId);
        const before = row.quantity;
        const diff = Number(line.countedQuantity) - before;
        row.quantity = Number(line.countedQuantity);
        await Repo.put("stock", row);
        await writeLedger({
          refType: "adjustment",
          refId: adj.id,
          productId: line.productId,
          locationId: adj.locationId,
          warehouseId: adj.warehouseId,
          direction: diff >= 0 ? "in" : "out",
          quantity: Math.abs(diff),
          before,
          after: row.quantity,
          reason: line.reason || adj.reason,
          userId,
        });
        await checkReorder(line.productId, adj.warehouseId);
      }
      adj.status = "validated";
      adj.validatedAt = now();
      adj.validatedBy = userId;
      await Repo.put("adjustments", adj);
      return adj;
    },
  };

  // ============================================================
  // DASHBOARD AGGREGATION
  // ============================================================
  async function getDashboardSummary() {
    const [products, stockRows, receipts, deliveries, transfers, ledger, rules] = await Promise.all([
      Repo.getAll("products"),
      Repo.getAll("stock"),
      Repo.getAll("receipts"),
      Repo.getAll("deliveries"),
      Repo.getAll("transfers"),
      Repo.getAll("ledger"),
      Repo.getAll("reorderRules"),
    ]);

    const qtyByProduct = {};
    stockRows.forEach((r) => {
      qtyByProduct[r.productId] = (qtyByProduct[r.productId] || 0) + r.quantity;
    });

    let lowStock = 0;
    let outOfStock = 0;
    let healthyStock = 0;
    products.forEach((p) => {
      const total = qtyByProduct[p.id] || 0;
      const rule = rules.find((r) => r.productId === p.id);
      if (total <= 0) outOfStock++;
      else if (rule && total <= rule.minQuantity) lowStock++;
      else healthyStock++;
    });

    const totalInventory = Object.values(qtyByProduct).reduce((a, b) => a + b, 0);

    const recentActivity = ledger
      .slice()
      .sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp))
      .slice(0, 10);

    return {
      totalProducts: products.length,
      healthyStock,
      lowStockProducts: lowStock,
      outOfStockProducts: outOfStock,
      pendingReceipts: receipts.filter((r) => r.status === "draft").length,
      pendingDeliveries: deliveries.filter((d) => d.status === "draft").length,
      pendingTransfers: transfers.filter((t) => t.status === "draft").length,
      currentInventory: totalInventory,
      recentActivity,
    };
  }

  // ============================================================
  // AUTH
  // ============================================================
  async function sha256(text) {
    const enc = new TextEncoder().encode(text);
    const buf = await global.crypto.subtle.digest("SHA-256", enc);
    return Array.from(new Uint8Array(buf))
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("");
  }

  const Auth = {
    async signup({ name, email, password, role }) {
      const existing = await Repo.getByIndex("users", "email", email);
      if (existing && existing.length) throw new Error("An account with this email already exists");
      const passwordHash = await sha256(password);
      const user = {
        id: uid("user"),
        name,
        email,
        passwordHash,
        role: role || "staff",
        createdAt: now(),
      };
      await Repo.put("users", user);
      return { id: user.id, name: user.name, email: user.email, role: user.role };
    },

    async login({ email, password }) {
      const matches = await Repo.getByIndex("users", "email", email);
      const user = matches && matches[0];
      if (!user) throw new Error("Invalid email or password");
      const passwordHash = await sha256(password);
      if (passwordHash !== user.passwordHash) throw new Error("Invalid email or password");
      const session = { id: uid("sess"), userId: user.id, createdAt: now() };
      await Repo.put("sessions", session);
      return { session, user: { id: user.id, name: user.name, email: user.email, role: user.role } };
    },

    async requestOtp(email) {
      const matches = await Repo.getByIndex("users", "email", email);
      if (!matches || !matches[0]) throw new Error("No account found with this email");
      const code = Math.floor(100000 + Math.random() * 900000).toString();
      const otp = { id: "otp_" + email, email, code, expiresAt: Date.now() + 10 * 60 * 1000 };
      await Repo.put("sessions", { id: otp.id, type: "otp", ...otp });
      return code;
    },

    async verifyOtpAndReset(email, code, newPassword) {
      const otpRow = await Repo.get("sessions", "otp_" + email);
      if (!otpRow || otpRow.code !== code) throw new Error("Invalid verification code");
      if (Date.now() > otpRow.expiresAt) throw new Error("Code expired");
      const matches = await Repo.getByIndex("users", "email", email);
      const user = matches[0];
      user.passwordHash = await sha256(newPassword);
      await Repo.put("users", user);
      await Repo.delete("sessions", otpRow.id);
      return true;
    },
  };

  global.SS = {
    Repo,
    StockEngine,
    Auth,
    uid,
    now,
    getDashboardSummary,
    stockKey,
    getOrCreateStockRow,
    checkReorder,
    openDB,
  };
})(typeof window !== "undefined" ? window : globalThis);
</script>
<script>
/* ============================================================
   StockSense App UI — Components, Icons, CSV Export, Router
   ============================================================ */
(function () {
  "use strict";

  const state = {
    user: null,
    route: "login",
    activeSearch: "",
  };

  const root = document.getElementById("app");

  // Modern SVG Icons for crisp high-density display
  const ICONS = {
    dashboard: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>`,
    products: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>`,
    categories: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 12 7.5-7.5L18.5 12"/><path d="m3.5 19.5 7.5-7.5L18.5 19.5"/><path d="m9.5 12 7.5-7.5L24.5 12"/></svg>`,
    receipts: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 10 6 6 6-6"/><path d="M12 2v14"/><path d="M19 21H5"/></svg>`,
    deliveries: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 14-6-6-6 6"/><path d="M12 20V8"/><path d="M5 3h14"/></svg>`,
    transfers: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>`,
    adjustments: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Z"/><path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M12 2v2"/><path d="M12 22v-2"/><path d="m17 17-1.4-1.4"/><path d="m7 7 1.4 1.4"/></svg>`,
    ledger: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/><path d="M6 14h6"/></svg>`,
    reorder: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m12 8 4 4-4 4M8 12h8"/></svg>`,
    warehouses: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z"/><path d="M6 18h12"/><path d="M6 14h12"/></svg>`,
    profile: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>`,
    bell: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>`,
    download: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>`,
    menu: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>`,
    eye: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`,
    print: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>`,
    calendar: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>`,
    chart: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    crown: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 4 3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"/></svg>`,
  };

  // ---------------- Formatting Helpers ----------------
  function fmtQty(n, unit) {
    const v = Number(n || 0);
    return v.toLocaleString(undefined, { maximumFractionDigits: 2 }) + (unit ? " " + unit : "");
  }
  function fmtDate(iso) {
    if (!iso) return "—";
    const d = new Date(iso);
    return d.toLocaleDateString(undefined, { month: "short", day: "2-digit", year: "numeric" }) +
      " · " + d.toLocaleTimeString(undefined, { hour: "2-digit", minute: "2-digit" });
  }
  function dateInputDefault(offsetDays = 0) {
    const d = new Date();
    d.setDate(d.getDate() + offsetDays);
    return d.toISOString().split("T")[0];
  }
  function calcDueStatus(dueDate, status, validatedAt) {
    if (!dueDate) return { label: "No date set", badgeClass: "badge-draft", urgency: "none", daysDiff: 0, formattedDate: "—" };
    const target = new Date(dueDate + "T23:59:59");
    const formattedDate = target.toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
    const now = new Date();
    const diffTime = target.getTime() - now.getTime();
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    if (status === "validated" || status === "done") {
      if (validatedAt && new Date(validatedAt) > target) {
        return { label: `Done Late`, badgeClass: "badge-low", urgency: "completed-late", diffDays, formattedDate };
      }
      return { label: `Done On Time`, badgeClass: "badge-ok", urgency: "completed", diffDays, formattedDate };
    }
    if (status === "cancelled") {
      return { label: `Cancelled`, badgeClass: "badge-cancelled", urgency: "cancelled", diffDays, formattedDate };
    }

    if (diffDays < 0) {
      const overdue = Math.abs(diffDays);
      return { label: `Overdue (${overdue}d ago)`, badgeClass: "badge-danger", urgency: "overdue", diffDays, formattedDate };
    }
    if (diffDays === 0) {
      return { label: `Due Today`, badgeClass: "badge-warn", urgency: "today", diffDays: 0, formattedDate };
    }
    if (diffDays === 1) {
      return { label: `Due Tomorrow`, badgeClass: "badge-warn", urgency: "tomorrow", diffDays: 1, formattedDate };
    }
    return { label: `Due in ${diffDays}d`, badgeClass: "badge-draft", urgency: "upcoming", diffDays, formattedDate };
  }
  function esc(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  }
  function initials(name) {
    return String(name || "?").trim().split(/\s+/).slice(0, 2).map((s) => s[0]).join("").toUpperCase();
  }
  function statusBadge(status) {
    const cls = status === "validated" ? "badge-validated" : status === "cancelled" ? "badge-cancelled" : "badge-draft";
    return `<span class="badge ${cls}">${esc(status)}</span>`;
  }

  // ---------------- Product Ranks & Sales Helpers ----------------
  function titleRankBadge(rank) {
    const r = rank || "Bronze";
    const cls = `badge-rank-${r.toLowerCase()}`;
    const icons = { Diamond: "💎", Platinum: "👑", Gold: "🥇", Silver: "🥈", Bronze: "🥉" };
    return `<span class="badge ${cls}">${icons[r] || "★"} ${esc(r)}</span>`;
  }

  function payRankBadge(rank) {
    const r = rank || "Bronze";
    const cls = `badge-rank-${r.toLowerCase()}`;
    return `<span class="badge ${cls}" style="font-size:11px">Pay: ${esc(r)}</span>`;
  }

  function activeRankBadge(status) {
    const s = status || "Active";
    let cls = "badge-active-qualified";
    let dot = "●";
    if (s.toLowerCase().includes("grace")) {
      cls = "badge-active-grace";
    } else if (s.toLowerCase().includes("inactive") || s.toLowerCase().includes("lapsed")) {
      cls = "badge-active-inactive";
    }
    return `<span class="badge ${cls}">${dot} ${esc(s)}</span>`;
  }

  function fmtMoney(amount) {
    const n = Number(amount || 0);
    return "$" + n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function normalizeProduct(p) {
    if (!p) return p;
    const defaults = {
      p_steel_rod: { unitPrice: 85, titleRank: "Diamond", payRank: "Diamond", activeRank: "Active" },
      p_alu_sheet: { unitPrice: 120, titleRank: "Diamond", payRank: "Platinum", activeRank: "Active" },
      p_hex_bolt: { unitPrice: 1.5, titleRank: "Platinum", payRank: "Platinum", activeRank: "Active" },
      p_washer: { unitPrice: 0.75, titleRank: "Gold", payRank: "Gold", activeRank: "Active" },
      p_cable: { unitPrice: 45, titleRank: "Platinum", payRank: "Gold", activeRank: "Active" },
      p_switch: { unitPrice: 32, titleRank: "Gold", payRank: "Silver", activeRank: "Active" },
      p_carton: { unitPrice: 4.5, titleRank: "Silver", payRank: "Silver", activeRank: "Active" },
      p_tape: { unitPrice: 8, titleRank: "Bronze", payRank: "Bronze", activeRank: "Grace Period" },
    };
    const def = defaults[p.id] || { unitPrice: 50, titleRank: "Gold", payRank: "Gold", activeRank: "Active" };
    return {
      ...p,
      unitPrice: Number(p.unitPrice !== undefined ? p.unitPrice : def.unitPrice),
      titleRank: p.titleRank || def.titleRank,
      payRank: p.payRank || def.payRank,
      activeRank: p.activeRank || def.activeRank,
    };
  }

  function computeSalesAnalytics(deliveries, rawProducts, ledger, numDays = 7) {
    const products = rawProducts.map(normalizeProduct);
    const productById = Object.fromEntries(products.map((p) => [p.id, p]));

    // Generate date slots for last numDays (ending today)
    const dailyMap = {};
    const now = new Date();
    for (let i = numDays - 1; i >= 0; i--) {
      const d = new Date();
      d.setDate(now.getDate() - i);
      const isoKey = d.toISOString().split("T")[0];
      const label = d.toLocaleDateString(undefined, { month: "short", day: "numeric" });
      dailyMap[isoKey] = { dateStr: isoKey, label, revenue: 0, units: 0, orders: 0 };
    }

    const rankBreakdown = {
      Diamond: { revenue: 0, units: 0 },
      Platinum: { revenue: 0, units: 0 },
      Gold: { revenue: 0, units: 0 },
      Silver: { revenue: 0, units: 0 },
      Bronze: { revenue: 0, units: 0 },
    };

    const productSalesMap = {};
    products.forEach((p) => {
      productSalesMap[p.id] = { product: p, revenue: 0, units: 0, orders: 0 };
    });

    let totalRevenue = 0;
    let totalUnits = 0;
    let totalOrders = 0;

    const valDeliveries = (deliveries || []).filter((d) => d.status === "validated");
    valDeliveries.forEach((d) => {
      const dDate = (d.validatedAt || d.createdAt || "").split("T")[0];
      let orderRev = 0;
      let orderUnits = 0;

      d.lines.forEach((l) => {
        const prod = productById[l.productId] || { name: l.productId, unitPrice: 50, titleRank: "Gold", payRank: "Gold", activeRank: "Active" };
        const price = prod.unitPrice || 50;
        const qty = Number(l.quantity || 0);
        const lineRev = qty * price;

        orderRev += lineRev;
        orderUnits += qty;

        const rankKey = prod.titleRank || "Gold";
        if (rankBreakdown[rankKey]) {
          rankBreakdown[rankKey].revenue += lineRev;
          rankBreakdown[rankKey].units += qty;
        }

        if (productSalesMap[l.productId]) {
          productSalesMap[l.productId].revenue += lineRev;
          productSalesMap[l.productId].units += qty;
          productSalesMap[l.productId].orders += 1;
        }
      });

      totalOrders++;
      totalRevenue += orderRev;
      totalUnits += orderUnits;

      if (dailyMap[dDate]) {
        dailyMap[dDate].revenue += orderRev;
        dailyMap[dDate].units += orderUnits;
        dailyMap[dDate].orders += 1;
      }
    });

    const dailySales = Object.values(dailyMap);
    const topProducts = Object.values(productSalesMap).sort((a, b) => b.revenue - a.revenue);

    return {
      dailySales,
      totalRevenue,
      totalUnits,
      totalOrders,
      rankBreakdown,
      topProducts,
    };
  }

  function renderSalesSvgChart({ container, dailySales, mode = "revenue" }) {
    if (!container) return;
    const isRev = mode === "revenue";
    const values = dailySales.map((d) => (isRev ? d.revenue : d.units));
    const maxVal = Math.max(...values, isRev ? 500 : 50);

    const W = 800;
    const H = 200;
    const padTop = 20;
    const padBottom = 35;
    const padLeft = 60;
    const padRight = 20;
    const chartW = W - padLeft - padRight;
    const chartH = H - padTop - padBottom;

    const count = dailySales.length;
    const colW = chartW / count;
    const barW = Math.max(16, Math.min(48, colW * 0.55));

    const yTicks = [0, 0.25, 0.5, 0.75, 1];
    const gridLines = yTicks.map((t) => {
      const y = padTop + chartH * (1 - t);
      const val = maxVal * t;
      const label = isRev ? "$" + (val >= 1000 ? (val / 1000).toFixed(1) + "k" : Math.round(val)) : (val >= 1000 ? (val / 1000).toFixed(1) + "k" : Math.round(val));
      return `
        <line x1="${padLeft}" y1="${y}" x2="${W - padRight}" y2="${y}" stroke="var(--border-soft)" stroke-dasharray="3,3" />
        <text x="${padLeft - 8}" y="${y + 4}" fill="var(--text-faint)" font-size="11" font-family="var(--font-mono)" text-anchor="end">${label}</text>
      `;
    }).join("");

    const bars = dailySales.map((d, i) => {
      const val = isRev ? d.revenue : d.units;
      const h = (val / maxVal) * chartH;
      const x = padLeft + i * colW + (colW - barW) / 2;
      const y = padTop + chartH - h;
      const displayVal = isRev ? "$" + val.toLocaleString() : val.toLocaleString() + " units";

      return `
        <g class="sales-bar-group" data-val="${esc(displayVal)}" data-date="${esc(d.label)}">
          <rect class="sales-bar" x="${x}" y="${y}" width="${barW}" height="${Math.max(3, h)}" rx="5" fill="url(#salesGrad)" />
          <text x="${x + barW / 2}" y="${H - 12}" fill="var(--text-muted)" font-size="11.5" font-family="var(--font-mono)" text-anchor="middle">${esc(d.label)}</text>
          ${val > 0 ? `<text x="${x + barW / 2}" y="${Math.max(padTop + 12, y - 6)}" fill="var(--accent-text)" font-size="10.5" font-weight="600" font-family="var(--font-mono)" text-anchor="middle">${isRev ? "$" + Math.round(val) : Math.round(val)}</text>` : ""}
        </g>
      `;
    }).join("");

    container.innerHTML = `
      <svg viewBox="0 0 ${W} ${H}" style="width:100%;height:100%;display:block;overflow:visible;">
        <defs>
          <linearGradient id="salesGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FF8533" stop-opacity="0.95" />
            <stop offset="100%" stop-color="#FFA05C" stop-opacity="0.45" />
          </linearGradient>
        </defs>
        ${gridLines}
        ${bars}
      </svg>
    `;
  }

  // ---------------- CSV Export Utility ----------------
  function exportCSV(filename, headers, rows) {
    const lines = [headers.join(",")];
    rows.forEach((r) => {
      const escaped = r.map((field) => {
        const str = String(field == null ? "" : field).replace(/"/g, '""');
        return `"${str}"`;
      });
      lines.push(escaped.join(","));
    });
    const blob = new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    toast(`Exported ${rows.length} rows to ${filename}`, "info");
  }

  // ---------------- Toasts ----------------
  let toastHost = null;
  function ensureToastHost() {
    if (!toastHost) {
      toastHost = document.createElement("div");
      toastHost.className = "toast-stack";
      document.body.appendChild(toastHost);
    }
    return toastHost;
  }
  function toast(message, type) {
    const host = ensureToastHost();
    const el = document.createElement("div");
    el.className = "toast" + (type ? " " + type : "");
    el.textContent = message;
    host.appendChild(el);
    setTimeout(() => {
      el.style.transition = "opacity .25s ease, transform .25s ease";
      el.style.opacity = "0";
      el.style.transform = "translateY(8px)";
      setTimeout(() => el.remove(), 260);
    }, 3600);
  }

  // ---------------- Modal ----------------
  function closeModal() {
    const ov = document.querySelector(".overlay");
    if (ov) ov.remove();
  }
  function openModal({ title, bodyHtml, wide, footHtml, onMount }) {
    closeModal();
    const ov = document.createElement("div");
    ov.className = "overlay";
    ov.innerHTML = `
      <div class="modal ${wide ? "wide" : ""}" role="dialog" aria-modal="true" aria-label="${esc(title)}">
        <div class="modal-head">
          <div class="modal-title">${esc(title)}</div>
          <button class="close-x" aria-label="Close" data-close>✕</button>
        </div>
        <div class="modal-body">${bodyHtml}</div>
        ${footHtml ? `<div class="modal-foot">${footHtml}</div>` : ""}
      </div>`;
    document.body.appendChild(ov);
    ov.addEventListener("mousedown", (e) => {
      if (e.target === ov) closeModal();
    });
    ov.querySelector("[data-close]").addEventListener("click", closeModal);
    document.addEventListener("keydown", function escListener(e) {
      if (e.key === "Escape") {
        closeModal();
        document.removeEventListener("keydown", escListener);
      }
    });
    if (onMount) onMount(ov);
    return ov;
  }

  function confirmDialog({ title, message, diffRows, confirmLabel, danger, onConfirm }) {
    const diffHtml = diffRows && diffRows.length
      ? `<div class="confirm-diff">${diffRows.map((r) => `<div class="confirm-diff-row"><span>${esc(r.label)}</span><span class="val">${esc(r.value)}</span></div>`).join("")}</div>`
      : "";
    openModal({
      title,
      bodyHtml: `<p style="color:var(--text-muted);line-height:1.6">${message}</p>${diffHtml}`,
      footHtml: `
        <button class="btn btn-ghost" data-close>Cancel</button>
        <button class="btn ${danger ? "btn-danger" : "btn-primary"}" data-confirm>${esc(confirmLabel || "Confirm")}</button>`,
      onMount: (ov) => {
        ov.querySelector("[data-confirm]").addEventListener("click", async (e) => {
          const btn = e.currentTarget;
          btn.disabled = true;
          btn.textContent = "Processing…";
          try {
            await onConfirm();
            closeModal();
          } catch (err) {
            btn.disabled = false;
            btn.textContent = confirmLabel || "Confirm";
            toast(err.message || String(err), "error");
          }
        });
      },
    });
  }

  // ---------------- Reusable Data Table Component ----------------
  function dataTable({ mount, columns, rows, rowKey, searchKeys, initialQuery, filters, pageSize, emptyState, rowActions, onRowClick }) {
    let query = initialQuery || "";
    let activeFilters = {};
    let page = 1;
    const size = pageSize || 8;

    function apply() {
      let data = rows;
      if (query) {
        const q = query.toLowerCase();
        data = data.filter((r) => (searchKeys || []).some((k) => String(r[k] || "").toLowerCase().includes(q)));
      }
      Object.entries(activeFilters).forEach(([key, val]) => {
        if (val) data = data.filter((r) => String(r[key]) === String(val));
      });
      return data;
    }

    function render() {
      const filtered = apply();
      const totalPages = Math.max(1, Math.ceil(filtered.length / size));
      if (page > totalPages) page = totalPages;
      const pageRows = filtered.slice((page - 1) * size, page * size);

      const filterHtml = (filters || [])
        .map(
          (f) => `<select class="toolbar-select" data-filter="${f.key}">
            <option value="">${esc(f.label)}: all</option>
            ${f.options.map((o) => `<option value="${esc(o.value)}" ${activeFilters[f.key] === String(o.value) ? "selected" : ""}>${esc(o.label)}</option>`).join("")}
          </select>`
        )
        .join("");

      mount.innerHTML = `
        <div class="table-toolbar">
          <input class="toolbar-input" type="search" placeholder="Search table (SKU, title, etc)…" value="${esc(query)}" data-search aria-label="Search table" />
          ${filterHtml}
        </div>
        <div class="table-wrap">
        ${
          filtered.length === 0
            ? emptyState || `<div class="empty-state"><div class="em-icon">▢</div><div class="em-title">No matching records</div><div class="em-sub">Try changing your search term or filters.</div></div>`
            : `<table class="data-table">
              <thead><tr>${columns.map((c) => `<th>${esc(c.label)}</th>`).join("")}${rowActions ? `<th></th>` : ""}</tr></thead>
              <tbody>
                ${pageRows
                  .map(
                    (r) => `<tr data-row="${esc(r[rowKey])}" style="${onRowClick ? "cursor:pointer" : ""}">
                      ${columns.map((c) => `<td class="${c.num ? "num" : ""}">${c.render ? c.render(r) : esc(r[c.key])}</td>`).join("")}
                      ${
                        rowActions
                          ? `<td><div class="row-actions">${rowActions(r)}</div></td>`
                          : ""
                      }
                    </tr>`
                  )
                  .join("")}
              </tbody>
            </table>`
        }
        </div>
        <div class="pagination">
          <span class="page-info">Showing ${filtered.length ? (page - 1) * size + 1 : 0}–${Math.min(page * size, filtered.length)} of ${filtered.length} entries</span>
          ${
            totalPages > 1
              ? `<div>
                  <button class="btn btn-sm btn-ghost" data-prev ${page <= 1 ? "disabled" : ""}>Previous</button>
                  <span style="font-size:12px;color:var(--text-muted);padding:0 6px">${page} / ${totalPages}</span>
                  <button class="btn btn-sm btn-ghost" data-next ${page >= totalPages ? "disabled" : ""}>Next</button>
                </div>`
              : ""
          }
        </div>
      `;

      const s = mount.querySelector("[data-search]");
      if (s) {
        s.addEventListener("input", (e) => {
          query = e.target.value;
          page = 1;
          render();
        });
      }
      mount.querySelectorAll("[data-filter]").forEach((sel) => {
        sel.addEventListener("change", (e) => {
          activeFilters[sel.dataset.filter] = e.target.value;
          page = 1;
          render();
        });
      });
      const prev = mount.querySelector("[data-prev]");
      const next = mount.querySelector("[data-next]");
      if (prev) prev.addEventListener("click", () => { page--; render(); });
      if (next) next.addEventListener("click", () => { page++; render(); });

      if (onRowClick) {
        mount.querySelectorAll("tr[data-row]").forEach((tr) => {
          tr.addEventListener("click", (e) => {
            if (e.target.closest(".row-actions") || e.target.closest("button") || e.target.closest("a")) return;
            onRowClick(tr.dataset.row);
          });
        });
      }
    }

    render();
    return {
      rerender: render,
      setRows: (newRows) => { rows = newRows; render(); },
      setFilter: (key, val) => { activeFilters[key] = val; page = 1; render(); },
      setQuery: (q) => { query = q; page = 1; render(); },
    };
  }

  window.__SSAPP = { state, root, ICONS, fmtQty, fmtDate, dateInputDefault, calcDueStatus, esc, initials, statusBadge, titleRankBadge, payRankBadge, activeRankBadge, fmtMoney, normalizeProduct, computeSalesAnalytics, renderSalesSvgChart, toast, exportCSV, openModal, closeModal, confirmDialog, dataTable };
})();

