    const products = [
      { id: "p_steel_rod", sku: "STL-ROD-10MM", name: "Steel Rod 10mm", unit: "KG", categoryId: "cat_metal", unitPrice: 85, titleRank: "Diamond", payRank: "Diamond", activeRank: "Active" },
      { id: "p_alu_sheet", sku: "ALU-SHT-2MM", name: "Aluminium Sheet 2mm", unit: "PCS", categoryId: "cat_metal", unitPrice: 120, titleRank: "Diamond", payRank: "Platinum", activeRank: "Active" },
      { id: "p_hex_bolt", sku: "FST-BLT-M8", name: "Hex Bolt M8x40", unit: "PCS", categoryId: "cat_fastener", unitPrice: 1.5, titleRank: "Platinum", payRank: "Platinum", activeRank: "Active" },
      { id: "p_washer", sku: "FST-WSH-M8", name: "Flat Washer M8", unit: "PCS", categoryId: "cat_fastener", unitPrice: 0.75, titleRank: "Gold", payRank: "Gold", activeRank: "Active" },
      { id: "p_cable", sku: "ELE-CBL-2.5", name: "Copper Cable 2.5sqmm", unit: "M", categoryId: "cat_electrical", unitPrice: 45, titleRank: "Platinum", payRank: "Gold", activeRank: "Active" },
      { id: "p_switch", sku: "ELE-SW-16A", name: "16A Modular Switch", unit: "PCS", categoryId: "cat_electrical", unitPrice: 32, titleRank: "Gold", payRank: "Silver", activeRank: "Active" },
      { id: "p_carton", sku: "PKG-BOX-M", name: "Corrugated Box (Medium)", unit: "PCS", categoryId: "cat_packaging", unitPrice: 4.5, titleRank: "Silver", payRank: "Silver", activeRank: "Active" },
      { id: "p_tape", sku: "PKG-TAPE-48", name: "Packing Tape 48mm", unit: "PCS", categoryId: "cat_packaging", unitPrice: 8, titleRank: "Bronze", payRank: "Bronze", activeRank: "Grace Period" },
    ];
    await SS.Repo.bulkPut("products", products);

    const rules = [
      { id: "rr1", productId: "p_steel_rod", warehouseId: "wh_north", minQuantity: 150 },
      { id: "rr2", productId: "p_hex_bolt", warehouseId: "wh_north", minQuantity: 500 },
      { id: "rr3", productId: "p_cable", warehouseId: "wh_north", minQuantity: 200 },
      { id: "rr4", productId: "p_switch", warehouseId: "wh_south", minQuantity: 100 },
      { id: "rr5", productId: "p_carton", warehouseId: "wh_south", minQuantity: 300 },
    ];
    await SS.Repo.bulkPut("reorderRules", rules);

    const admin = (await SS.Repo.getByIndex("users", "email", "admin@stocksense.io"))[0];
    const opening = [
      { productId: "p_steel_rod", locationId: "loc_n_a1", warehouseId: "wh_north", qty: 420 },
      { productId: "p_alu_sheet", locationId: "loc_n_a1", warehouseId: "wh_north", qty: 260 },
      { productId: "p_hex_bolt", locationId: "loc_n_a2", warehouseId: "wh_north", qty: 3200 },
      { productId: "p_washer", locationId: "loc_n_a2", warehouseId: "wh_north", qty: 3400 },
      { productId: "p_cable", locationId: "loc_n_b1", warehouseId: "wh_north", qty: 180 },
      { productId: "p_switch", locationId: "loc_s_a1", warehouseId: "wh_south", qty: 60 },
      { productId: "p_carton", locationId: "loc_s_a2", warehouseId: "wh_south", qty: 850 },
      { productId: "p_tape", locationId: "loc_s_a2", warehouseId: "wh_south", qty: 1200 },
    ];

    const byLoc = {};
    opening.forEach((o) => {
      const key = o.warehouseId + "|" + o.locationId;
      byLoc[key] = byLoc[key] || { warehouseId: o.warehouseId, locationId: o.locationId, lines: [] };
      byLoc[key].lines.push({ productId: o.productId, quantity: o.qty });
